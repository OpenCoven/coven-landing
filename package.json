{
  "name": "coven-landing",
  "version": "0.0.0",
  "private": true,
  "description": "Standalone landing page for OpenCoven/Coven, built with Astro.",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node scripts/sanitize-public-fallbacks.mjs",
    "preview": "astro preview --host 127.0.0.1 --port 4173",
    "astro": "astro",
    "check": "node scripts/verify-static.mjs && node scripts/verify-analytics.mjs && node scripts/verify-public-truth.mjs && node scripts/verify-product-registry.mjs && python3 analytics/test-provision.py",
    "check:analytics": "node scripts/verify-analytics.mjs && python3 analytics/test-provision.py",
    "check:truth": "node scripts/verify-public-truth.mjs && node scripts/verify-product-registry.mjs",
    "check:registry": "node scripts/verify-product-registry.mjs",
    "check:browser": "playwright test",
    "test:unit": "node --test 'api/**/*.test.js' 'workers/**/*.test.js'"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.3",
    "@fontsource-variable/geist": "^5.2.9",
    "@fontsource-variable/inter": "^5.2.8",
    "@fontsource-variable/jetbrains-mono": "^5.2.8",
    "@fontsource/eb-garamond": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@phosphor-icons/web": "^2.1.2",
    "astro": "^5.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@playwright/test": "1.62.0",
    "lighthouse": "13.4.1"
  }
}
