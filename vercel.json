{
  "redirects": [
    {
      "source": "/party",
      "destination": "https://discord.gg/NT3F6keYn?event=1498317633446215770",
      "permanent": false
    },
    {
      "source": "/weekly",
      "destination": "https://discord.gg/NT3F6keYn?event=1498317633446215770",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/download/:platform",
      "destination": "/api/download?platform=:platform"
    },
    {
      "source": "/stream/:platform",
      "destination": "/api/stream?platform=:platform"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/logos/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/_astro/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}
