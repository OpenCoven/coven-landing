---
// Hero — "the first console frame".
//
// The rest of the page is a series of full-width console frames
// (COVEN · RUNTIME, COVEN · ARCHITECTURE, …). The hero opens the same
// way instead of a two-column SaaS split:
//
//   1. .hero-masthead — editorial row: kicker + display headline on the
//      left, lede + platform-aware DownloadCTA on the right.
//   2. .hero-console  — one full-width COVEN · SESSION frame holding the
//      live session (command line, familiar state, roster tabs) with the
//      continuity strip as its footer: the familiar's memory plotted
//      across 47 days, ending in a live "today" node.
//
// Rotation + typing live in src/scripts/main.js. Everything renders
// complete without JS; motion is limited to typing, rotation, and the
// shared reveal transitions (no orchestration — see repo memory).
import DownloadCTA from './DownloadCTA.astro';
---
<section class="hero" id="top" aria-label="Hero">
  <div class="hero-masthead">
    <p class="kicker" data-reveal>
      <span class="kicker-beta"><span class="beta-dot" aria-hidden="true"></span>public beta</span>
      free &amp; open source · runs locally
    </p>
    <div class="hero-headline" data-reveal>
      <h1>Summon agents<br>that <em>remember.</em></h1>
    </div>

    <div class="hero-aside" data-reveal>
      <p class="hero-lede">
        Coven gives each AI agent a name, a memory, and a place in your
        work. Close the terminal tonight — tomorrow <strong>Forge</strong>
        still knows your branch, your conventions, and where you left off.
      </p>

      <DownloadCTA />

      <div class="hero-actions-secondary">
        <a class="btn-ghost" href="https://discord.gg/opencoven">
          <svg viewBox="0 0 127.14 96.36" aria-hidden="true">
            <path d="M107.7 8.07A105.15 105.15 0 0 0 81.47 0a72.06 72.06 0 0 0-3.36 6.83 97.68 97.68 0 0 0-29.11 0A72.37 72.37 0 0 0 45.64 0a105.89 105.89 0 0 0-26.25 8.09C2.79 32.65-1.71 56.6.54 80.21A105.73 105.73 0 0 0 32.71 96.36a77.7 77.7 0 0 0 6.89-11.11 68.42 68.42 0 0 1-10.85-5.18c.91-.66 1.8-1.34 2.66-2a75.57 75.57 0 0 0 64.32 0c.87.71 1.76 1.39 2.66 2a68.68 68.68 0 0 1-10.87 5.19 77 77 0 0 0 6.89 11.1 105.25 105.25 0 0 0 32.19-16.14c2.64-27.38-4.51-51.11-18.9-72.15ZM42.45 65.69C36.18 65.69 31 60 31 53s5-12.74 11.43-12.74S54 46 53.89 53s-5.05 12.69-11.44 12.69Zm42.24 0C78.41 65.69 73.25 60 73.25 53s5-12.74 11.44-12.74S96.23 46 96.12 53s-5.05 12.69-11.43 12.69Z"/>
          </svg>
          Join Discord
        </a>
        <a class="btn-ghost" href="https://docs.opencoven.ai">Read the docs ↗</a>
      </div>
    </div>
  </div>

  <div class="hero-console panel" data-reveal aria-label="Live Coven session preview">
    <div class="hero-card-topbar">
      <div class="hero-card-dots" aria-hidden="true"><span></span><span></span><span></span></div>
      <span class="hero-card-label">coven · session</span>
      <span class="hero-card-status">local</span>
    </div>

    <div class="hero-console-main">
      <div class="hero-session">
        <div class="hero-card-cmdline">
          <span class="card-prompt" aria-hidden="true">❯</span>
          <span class="card-cmd">coven attach forge --project ./opencoven</span>
          <span class="card-cursor" aria-hidden="true"></span>
        </div>

        <div class="hero-card-output" aria-live="polite">
          <div class="output-identity">
            <div class="familiar-sigil" data-sigil>F</div>
            <div class="familiar-info">
              <span class="familiar-name" data-name>Forge</span>
              <span class="familiar-role" data-role>code steward · tools · git</span>
            </div>
            <span class="familiar-badge badge-active" data-badge>awake</span>
          </div>
          <div class="output-memory">
            <div class="memory-header">
              <span class="memory-title">memory restored</span>
              <span class="memory-count" data-count>128 notes · 47 days</span>
            </div>
            <div class="memory-note">
              <span class="memory-text">resumed feat/runtime-attach · 4 files staged</span>
              <span class="memory-meta">2h ago</span>
            </div>
            <div class="memory-note">
              <span class="memory-text">prefers terse PR summaries, no trailing recap</span>
              <span class="memory-meta">persisted</span>
            </div>
          </div>
        </div>
      </div>

      <div class="continuity" aria-label="One familiar's memory across 47 days">
        <p class="continuity-kicker">continuity · forge</p>
        <ol class="continuity-events">
          <li class="continuity-event" data-reveal>
            <span class="continuity-date">day 1</span>
            <span class="continuity-node" aria-hidden="true"></span>
            <span class="continuity-text">summoned Forge, learned the repo</span>
          </li>
          <li class="continuity-event" data-reveal>
            <span class="continuity-date">day 9</span>
            <span class="continuity-node" aria-hidden="true"></span>
            <span class="continuity-text">picked up your review style</span>
          </li>
          <li class="continuity-event" data-reveal>
            <span class="continuity-date">day 23</span>
            <span class="continuity-node" aria-hidden="true"></span>
            <span class="continuity-text">shipped feat/runtime-attach</span>
          </li>
          <li class="continuity-event is-now" data-reveal>
            <span class="continuity-date">day 47 · today</span>
            <span class="continuity-node" aria-hidden="true"></span>
            <span class="continuity-text">still remembers all of it</span>
          </li>
        </ol>
      </div>

      <div class="hero-card-roster" role="tablist" aria-label="Switch familiar">
        <button class="roster-tab active" type="button" data-familiar="forge" role="tab" aria-selected="true">Forge</button>
        <button class="roster-tab" type="button" data-familiar="charm" role="tab" aria-selected="false" tabindex="-1">Charm</button>
        <button class="roster-tab" type="button" data-familiar="sage" role="tab" aria-selected="false" tabindex="-1">Sage</button>
        <span class="roster-hint" aria-hidden="true">one runtime · three familiars</span>
      </div>
    </div>
  </div>
</section>
