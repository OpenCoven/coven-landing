---
// Platform-aware download CTA — two buttons, one decision each.
//
// Renders a wide primary "Download for macOS" button (macOS is the
// server-side default) plus a dedicated iOS (TestFlight) button.
// Client-side detection (src/scripts/main.js) rewrites the primary
// button's label/sub/href to match the visitor's desktop platform;
// on iOS the two buttons swap roles (TestFlight leads, macOS follows).
//
// Works fully without JS: both buttons are real <a href>s pointing at
// the canonical release page or TestFlight.
//
// Download sources (resolved at runtime — never bake versions in):
//   • macOS + Windows + Linux → GitHub Releases (latest release page;
//     asset filenames carry version suffixes so /latest/download/<asset>
//     redirects can't be used).
//   • iOS / iPadOS → TestFlight public link.

const RELEASES_URL = 'https://github.com/OpenCoven/coven-cave/releases/latest';
const TESTFLIGHT_URL = 'https://testflight.apple.com/join/61Dqw8y4';
---
<div
  class="download-cta"
  data-download-cta
  data-releases-url={RELEASES_URL}
  data-testflight-url={TESTFLIGHT_URL}
>
  <a class="download-primary" href={RELEASES_URL} data-download-primary data-platform="mac">
    <svg class="download-primary-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path fill="currentColor" d="M12 3v10.55m0 0 4-4m-4 4-4-4M4 17v2a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-2" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" fill="none"/></svg>
    <span class="download-primary-text">
      <span class="download-primary-label" data-download-label>Download for macOS</span>
      <span class="download-primary-sub" data-download-sub>CovenCave · .dmg · signed · free</span>
    </span>
  </a>

  <a class="download-primary download-primary--ios" href={TESTFLIGHT_URL} data-download-ios target="_blank" rel="noopener noreferrer">
    <svg class="download-primary-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path fill="currentColor" d="M17.05 12.54c-.03-2.89 2.36-4.27 2.47-4.34-1.35-1.97-3.44-2.24-4.18-2.27-1.78-.18-3.47 1.05-4.37 1.05-.9 0-2.29-1.02-3.77-1-1.94.03-3.72 1.13-4.72 2.86-2.01 3.49-.51 8.66 1.45 11.49.96 1.39 2.1 2.94 3.6 2.89 1.44-.06 1.99-.93 3.73-.93s2.23.93 3.76.9c1.55-.03 2.53-1.41 3.48-2.8 1.09-1.61 1.54-3.17 1.57-3.25-.03-.02-3-1.15-3.02-4.6ZM14.16 4.06c.79-.96 1.33-2.29 1.18-3.62-1.14.05-2.53.76-3.35 1.72-.73.85-1.38 2.21-1.21 3.51 1.28.1 2.58-.65 3.38-1.61Z"/></svg>
    <span class="download-primary-text">
      <span class="download-primary-label" data-download-ios-label>Download for iOS</span>
      <span class="download-primary-sub" data-download-ios-sub>CovenCave · TestFlight · iPhone &amp; iPad</span>
    </span>
  </a>
</div>
