---
// Trust strip — names the harnesses Coven plugs into today so visitors
// can read "this works with the CLI I already use" in one glance,
// instead of a placeholder testimonial.
const harnesses = [
  { name: 'Claude Code', vendor: 'Anthropic', logo: '/logos/anthropic.svg' },
  { name: 'Codex',       vendor: 'OpenAI',    logo: '/logos/openai.svg'    },
];
---
<div class="trust-strip" role="note" aria-label="Supported harnesses">
  <div class="trust-inner" data-reveal>
    <span class="trust-kicker">Drives the agent CLIs you already use</span>
    <div class="trust-marks">
      {harnesses.map((h) => (
        <span class="trust-mark">
          <img src={h.logo} alt="" width="18" height="18" />
          <span class="trust-mark-name">{h.name}</span>
          <span class="trust-mark-vendor">· {h.vendor}</span>
        </span>
      ))}
      <span class="trust-mark trust-mark--future">
        <span class="trust-mark-name">+ more</span>
        <span class="trust-mark-vendor">adapter-ready</span>
      </span>
    </div>
  </div>
</div>

<style>
  .trust-strip {
    position: relative;
    z-index: 1;
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
    background: rgba(14, 11, 22, 0.6);
    padding: 22px 32px;
  }
  .trust-inner {
    max-width: 1280px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 28px;
    flex-wrap: wrap;
  }
  .trust-kicker {
    font-family: var(--mono);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: rgba(201, 167, 255, 0.75);
  }
  .trust-marks {
    display: flex;
    align-items: center;
    gap: 18px;
    flex-wrap: wrap;
  }
  .trust-mark {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 10px;
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 6px;
    background: rgba(255, 255, 255, 0.02);
  }
  .trust-mark img {
    display: block;
    border-radius: 3px;
    background: #fff;
    padding: 2px;
    box-sizing: content-box;
  }
  .trust-mark-name {
    font-size: 12px;
    font-weight: 700;
    color: var(--white);
  }
  .trust-mark-vendor {
    font-family: var(--mono);
    font-size: 10px;
    color: rgba(201, 167, 255, 0.6);
    letter-spacing: 0.04em;
  }
  .trust-mark--future {
    border-style: dashed;
    background: transparent;
  }
  .trust-mark--future .trust-mark-name {
    color: rgba(201, 167, 255, 0.78);
  }

  @media (max-width: 720px) {
    .trust-strip { padding: 18px 20px; }
    .trust-inner { gap: 18px; }
    .trust-kicker { font-size: 9px; }
  }
  @media (max-width: 520px) {
    .trust-inner { flex-direction: column; gap: 12px; }
    .trust-marks { gap: 8px; }
  }
</style>
