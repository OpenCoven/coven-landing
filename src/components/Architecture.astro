---
// Interactive architecture diagram. SVG with clickable nodes; selecting a
// node updates the detail panel below the diagram. State + keyboard
// navigation are wired in the inline script at the bottom of this file.
const nodes = [
  // Harness layer
  { id: 'codex',      label: 'Codex',        layer: 'harness', x: 80,  y: 30,  w: 160, h: 70,
    title: 'Codex',
    color: 'violet',
    intro: "OpenAI's coding agent, driven through Coven instead of run loose against your filesystem.",
    bullets: [
      'Every command bounded to the project-scoped directory you launched in',
      'Captured as an inspectable, replayable session record',
      'Hand sessions off to another familiar without losing context',
    ] },
  { id: 'claude',     label: 'Claude Code',  layer: 'harness', x: 320, y: 30,  w: 160, h: 70,
    title: 'Claude Code',
    color: 'violet',
    intro: "Anthropic's official CLI, wired into the same neutral adapter as every other supported harness.",
    bullets: [
      'Identical session lifecycle and scoped tool access',
      'Shares the same persistent memory layer',
      'Swap harnesses mid-project — the runtime stays the same',
    ] },
  { id: 'future',     label: '+ Future',     layer: 'harness', x: 560, y: 30,  w: 160, h: 70,
    title: 'Future harnesses',
    color: 'violet',
    intro: 'Adapter-ready by design. New agent CLIs plug in without rewriting Coven.',
    bullets: [
      'One neutral interface, not bespoke integrations',
      'Harness quirks stay contained at the adapter boundary',
      'Existing projects keep running as the ecosystem grows',
    ] },

  // Coven runtime sub-nodes (inside the boundary box)
  { id: 'sessions',   label: 'Sessions',     layer: 'coven',   x: 60,  y: 220, w: 150, h: 110,
    title: 'Sessions',
    color: 'orchid',
    intro: 'Every harness run is a first-class, project-scoped session record.',
    bullets: [
      'Inspectable live; replayable after it ends',
      'Lifecycle controls: start, pause, detach, resume, terminate',
      'Full output history stored in the ledger — no opaque background processes',
    ] },
  { id: 'memory',     label: 'Memory',       layer: 'coven',   x: 230, y: 220, w: 150, h: 110,
    title: 'Memory',
    color: 'orchid',
    intro: 'Notes, decisions, and preferences persist per familiar across sessions.',
    bullets: [
      'Continuity is explicit and inspectable, not buried in chat',
      'Familiars carry forward conventions and in-flight context',
      'No more starting cold every conversation',
    ] },
  { id: 'adapter',    label: 'Adapter',      layer: 'coven',   x: 400, y: 220, w: 150, h: 110,
    title: 'Harness adapter',
    color: 'orchid',
    intro: "Translates each harness's native protocol into one neutral runtime interface.",
    bullets: [
      'Codex streams, Claude Code tool calls, whatever comes next',
      'Sessions, memory, and tools stay harness-agnostic',
      'New harnesses slot in without ripple effects elsewhere',
    ] },
  { id: 'tools',      label: 'Tool gateway', layer: 'coven',   x: 570, y: 220, w: 150, h: 110,
    title: 'Tool gateway',
    color: 'orchid',
    intro: 'Mediates every tool call through inspectable contracts with explicit boundaries.',
    bullets: [
      'Filesystem, git, terminal, and web access behind one tool gateway',
      'No silent privilege escalation or out-of-tree surprises',
      'Audit what was attempted, allowed, and executed',
    ] },

  // Project layer
  { id: 'filesystem', label: 'Filesystem',   layer: 'project', x: 60,  y: 430, w: 150, h: 60,
    title: 'Filesystem',
    color: 'green',
    intro: 'Reads and writes scoped to the project-scoped directory you launched in — not your whole machine.',
    bullets: [
      'Out-of-tree access requires an explicit, in-moment grant',
      'No quiet wandering into your home directory or sibling repos',
      'Permission prompts are surfaced, not buried in config',
    ] },
  { id: 'git',        label: 'Git',          layer: 'project', x: 230, y: 430, w: 150, h: 60,
    title: 'Git',
    color: 'green',
    intro: 'Branches, commits, diffs, and history visible to the session as ordinary project state.',
    bullets: [
      'No force-pushes or history rewrites on your behalf',
      'Signing and hooks are never bypassed',
      'Every git-touching action shows up in the session record',
    ] },
  { id: 'terminals',  label: 'Terminals',    layer: 'project', x: 400, y: 430, w: 150, h: 60,
    title: 'Terminals',
    color: 'green',
    intro: 'Managed PTY surfaces with full scrollback attached to the session.',
    bullets: [
      'Detach from a long-running command and walk away',
      'Rejoin from any session browser — output keeps streaming',
      'Survives window close, sleep, and disconnects',
    ] },
  { id: 'docs',       label: 'Docs',         layer: 'project', x: 570, y: 430, w: 150, h: 60,
    title: 'Docs',
    color: 'green',
    intro: 'Markdown, source, and structured docs exposed as first-class session context.',
    bullets: [
      'Readable by familiars during a run, no extra ingestion',
      'Read-only by default — cite, summarize, reason without mutating',
      'Write access requires an explicit grant',
    ] },
];

const DEFAULT_INTRO = 'Pick any node to inspect how it fits into the runtime.';
const DEFAULT_BULLETS = [
  'Commands flow down: harness → runtime → your project',
  'Output, state, and memory flow back up the return path',
  'Every boundary is enforced at runtime, not just drawn here',
];

// Glossary: key terms → { definition, docsPath? }
const GLOSSARY: Record<string, { def: string; href?: string }> = {
  'harness':         { def: 'An agent CLI (Codex, Claude Code, etc.) that Coven spawns and supervises.', href: '/docs/familiars/harnesses' },
  'session':         { def: 'A bounded, replayable run scoped to one project. Every harness invocation is a session.', href: '/docs/daemon/socket-api' },
  'session record':  { def: 'The persisted metadata, output, and event log for a completed or live session.' },
  'memory':          { def: 'Per-familiar notes, decisions, and conventions that persist across sessions.', href: '/docs/reference/glossolalia' },
  'adapter':         { def: "Translates each harness's native protocol into one neutral runtime interface." },
  'tool gateway':    { def: 'Mediates every tool call through explicit, inspectable contracts.', href: '/docs/daemon/security' },
  'project-scoped':  { def: 'Constrained to the directory tree you launched Coven in — no out-of-tree surprises.' },
  'familiar':        { def: 'A named, persistent AI agent with memory, identity, and a defined role.', href: '/docs/familiars/clients' },
  'unix socket':     { def: 'The local IPC channel the Coven daemon binds. Same-user access only.', href: '/docs/daemon/security' },
  'ledger':          { def: 'The SQLite store of session records and append-only event log.' },
  'pty':             { def: 'Pseudo-terminal: a managed shell surface with full scrollback attached to the session.' },
  'signing':         { def: 'Git commit signing — never bypassed. Hooks also remain intact.' },
  'sso token':       { def: "A short-lived, server-signed JWT that verifies a user's identity without client-side spoofing." },
  'open source':     { def: 'CastCodes is forked from Warp under an open-source license. Telemetry and cloud services are stripped.' },
};

// Wrap matching terms in the bullet text with a <mark class="kw" data-*> span for the client to enhance.
// Returns the string with placeholders; client replaces with the real DOM.
// NOTE: this fn is intentionally NOT used for dynamic bullets — the client uses a safe DOM text-node
// walker instead. It is only kept here for any future static SSR use.
function markKeywords(text: string): string {
  // Process longest terms first to avoid sub-term stomping.
  const entries = Object.entries(GLOSSARY).sort(([a], [b]) => b.length - a.length);
  // Use placeholder tokens to avoid re-matching inside generated HTML.
  const placeholders: Array<{ token: string; html: string }> = [];
  let out = text;
  entries.forEach(([term, meta], i) => {
    const re = new RegExp(`\\b(${term.replace(/[.*+?^${}()|[\]\\]/g, '\\$&')})\\b`, 'gi');
    const token = `\x00KW${i}\x00`;
    const href = meta.href ? ` data-href="${meta.href}"` : '';
    if (re.test(out)) {
      out = out.replace(re, token);
      placeholders.push({ token, html: `<mark class="kw" data-def="${meta.def.replace(/"/g, '&quot;')}"${href} tabindex="0">$<term></mark>` });
    }
  });
  // Restore placeholders
  placeholders.forEach(({ token, html }) => {
    out = out.replace(token, html);
  });
  return out;
}
---

<section class="architecture-section content-section" id="architecture" aria-labelledby="architecture-heading">
  <div class="section-header" data-reveal>
    <p class="section-kicker">Architecture</p>
    <h2 id="architecture-heading">One neutral layer between the harness and your code.</h2>
    <p>Coven sits between every supported agent CLI and the project you're actually working in. Commands flow down, output and memory flow up, and every boundary is explicit.</p>
  </div>

  <div class="architecture-diagram" data-reveal>
    <svg
      class="arch-svg"
      viewBox="0 0 800 520"
      role="img"
      aria-labelledby="arch-svg-title"
      preserveAspectRatio="xMidYMid meet"
    >
      <title id="arch-svg-title">Coven architecture: harness, runtime, and project layers</title>

      <defs>
        <marker id="arch-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="8" markerHeight="8" orient="auto-start-reverse">
          <path d="M0,0 L10,5 L0,10 Z" fill="rgba(180,170,235,0.55)" />
        </marker>
        <marker id="arch-arrow-up" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
          <path d="M0,0 L10,5 L0,10 Z" fill="rgba(74,222,128,0.55)" />
        </marker>
      </defs>

      <text class="arch-layer-label" x="400" y="18" text-anchor="middle">harness layer</text>
      <text class="arch-layer-label" x="400" y="155" text-anchor="middle">coven runtime</text>
      <text class="arch-layer-label" x="400" y="418" text-anchor="middle">your project</text>

      <rect class="arch-boundary" x="40" y="170" width="720" height="200" rx="10" />
      <text class="arch-boundary-tag" x="56" y="190">project-scoped boundary</text>

      <g class="arch-flow">
        <line x1="160" y1="100" x2="160" y2="218" />
        <line x1="400" y1="100" x2="400" y2="218" />
        <line x1="640" y1="100" x2="500" y2="218" stroke-dasharray="4,4" />

        <line x1="135" y1="330" x2="135" y2="428" />
        <line x1="305" y1="330" x2="305" y2="428" />
        <line x1="475" y1="330" x2="475" y2="428" />
        <line x1="645" y1="330" x2="645" y2="428" />
      </g>

      <g class="arch-return">
        <path d="M 730 480 Q 770 480 770 380 Q 770 200 770 60 L 720 60" stroke-dasharray="4,4" />
      </g>
      <text class="arch-return-label" x="780" y="270" transform="rotate(-90 780 270)" text-anchor="middle">output · memory</text>

      <path class="arch-loop" d="M 305 260 q 0 -32 75 0" />

      {nodes.map((n, i) => (
        <g
          class={`arch-node arch-node--${n.layer}`}
          data-node={n.id}
          data-layer={n.layer}
          role="button"
          tabindex={i === 0 ? '0' : '-1'}
          aria-label={n.title}
        >
          <rect x={n.x} y={n.y} width={n.w} height={n.h} rx="8" />
          <text x={n.x + n.w / 2} y={n.y + n.h / 2 + 5} text-anchor="middle">{n.label}</text>
        </g>
      ))}
    </svg>

    <div class="arch-detail" aria-live="polite">
      <div class="arch-detail-inner">
        <p class="arch-detail-kicker"><span class="arch-detail-dot"></span><span class="arch-detail-tag">pick a node</span></p>
        <h3 class="arch-detail-title">How Coven fits into your stack</h3>
        <p class="arch-detail-body">{DEFAULT_INTRO}</p>
        <ul class="arch-detail-bullets">
          {DEFAULT_BULLETS.map((b) => <li>{b}</li>)}
        </ul>
      </div>
    </div>

    <!-- Glossary tooltip (rendered by JS, positioned absolutely). `inert`
         keeps the inner link out of the tab order and the a11y tree until
         the tooltip is actually shown. -->
    <div id="arch-tooltip" class="arch-tooltip" role="tooltip" inert>
      <p class="arch-tooltip-def"></p>
      <a class="arch-tooltip-link" href="#" target="_blank" rel="noopener">View in docs ↗</a>
    </div>
  </div>
</section>

<script>
  (function () {
    const nodes = document.querySelectorAll('.arch-node[data-node]');
    if (!nodes.length) return;
    const titleEl   = document.querySelector('.arch-detail-title');
    const bodyEl    = document.querySelector('.arch-detail-body');
    const bulletsEl = document.querySelector('.arch-detail-bullets');
    const tagEl     = document.querySelector('.arch-detail-tag');
    const kickerEl  = document.querySelector('.arch-detail-kicker');
    const tooltip   = document.getElementById('arch-tooltip');

    const order = Array.from(nodes);

    // ── Glossary + tooltip ────────────────────────────────────────────
    const glossary = window.__ARCH_GLOSSARY__ || {};

    // Safe DOM text-node walker: only ever touches text nodes, never
    // attribute values — no HTML corruption possible.
    function markKeywordsInNode(container) {
      const terms = Object.keys(glossary).sort((a, b) => b.length - a.length);
      const walker = document.createTreeWalker(container, NodeFilter.SHOW_TEXT);
      const textNodes = [];
      let n;
      while ((n = walker.nextNode())) textNodes.push(n);

      textNodes.forEach((textNode) => {
        const text = textNode.textContent;
        const raw  = [];
        terms.forEach((term) => {
          const re = new RegExp('\\b(' + term.replace(/[.*+?^${}()|[\]\\]/g, '\\$&') + ')\\b', 'gi');
          let m;
          while ((m = re.exec(text)) !== null) {
            raw.push({ index: m.index, end: m.index + m[0].length, term, matched: m[0] });
          }
        });
        if (!raw.length) return;
        raw.sort((a, b) => a.index - b.index);
        const hits = [];
        let cursor = 0;
        raw.forEach((m) => { if (m.index >= cursor) { hits.push(m); cursor = m.end; } });
        const frag = document.createDocumentFragment();
        let last = 0;
        hits.forEach((m) => {
          if (m.index > last) frag.appendChild(document.createTextNode(text.slice(last, m.index)));
          const mark = document.createElement('mark');
          mark.className = 'kw';
          mark.setAttribute('data-def', glossary[m.term].def);
          if (glossary[m.term].href) mark.setAttribute('data-href', glossary[m.term].href);
          mark.setAttribute('tabindex', '0');
          mark.textContent = m.matched;
          frag.appendChild(mark);
          last = m.end;
        });
        if (last < text.length) frag.appendChild(document.createTextNode(text.slice(last)));
        textNode.parentNode.replaceChild(frag, textNode);
      });
    }

    function showTooltip(mark) {
      if (!tooltip) return;
      const def  = mark.getAttribute('data-def') || '';
      const href = mark.getAttribute('data-href');
      const defEl  = tooltip.querySelector('.arch-tooltip-def');
      const linkEl = tooltip.querySelector('.arch-tooltip-link');
      if (defEl)  defEl.textContent = def;
      if (linkEl) {
        if (href) {
          linkEl.href = 'https://docs.opencoven.ai' + href;
          linkEl.style.display = '';
        } else {
          linkEl.style.display = 'none';
        }
      }
      const rect     = mark.getBoundingClientRect();
      const panel    = tooltip.closest('.arch-detail') || document.body;
      const panelRect = panel.getBoundingClientRect();
      tooltip.style.left = (rect.left - panelRect.left) + 'px';
      tooltip.style.top  = (rect.bottom - panelRect.top + 6) + 'px';
      tooltip.removeAttribute('inert');
      tooltip.classList.add('is-visible');
    }
    function hideTooltip() {
      if (!tooltip) return;
      tooltip.setAttribute('inert', '');
      tooltip.classList.remove('is-visible');
    }

    function wireKeywords(container) {
      container.querySelectorAll('mark.kw').forEach((mark) => {
        mark.addEventListener('mouseenter', () => showTooltip(mark));
        mark.addEventListener('mouseleave', hideTooltip);
        mark.addEventListener('focusin',    () => showTooltip(mark));
        mark.addEventListener('focusout',   hideTooltip);
      });
    }

    // Wire the default bullets that Astro SSR already put in the DOM
    markKeywordsInNode(document.querySelector('.arch-detail-bullets') || document);
    wireKeywords(document);

    // ── Node selection ─────────────────────────────────────────────
    function focusNode(node) {
      order.forEach((n) => n.setAttribute('tabindex', n === node ? '0' : '-1'));
      node.focus();
    }

    function select(node) {
      nodes.forEach((n) => n.classList.toggle('is-selected', n === node));
      const id    = node.getAttribute('data-node');
      const layer = node.getAttribute('data-layer');
      const data  = window.__ARCH_NODES__?.[id];
      if (!data) return;

      if (titleEl) titleEl.textContent = data.title;
      if (bodyEl)  bodyEl.textContent  = data.intro;

      const colorMap = { violet: '#B4AAEB', orchid: '#C4B9F0', green: '#30D158' };
      const accent = colorMap[data.color] || '#B4AAEB';
      const dot = kickerEl?.querySelector('.arch-detail-dot');
      if (dot) dot.style.background = accent;
      if (titleEl) titleEl.style.color = accent;

      if (bulletsEl) {
        bulletsEl.replaceChildren();
        (data.bullets || []).forEach((b) => {
          const li = document.createElement('li');
          li.textContent = b; // plain text first
          bulletsEl.appendChild(li);
        });
        // Walk text nodes and inject <mark> elements safely
        markKeywordsInNode(bulletsEl);
        wireKeywords(bulletsEl);
      }
      if (tagEl)    tagEl.textContent = layer || 'node';
      if (kickerEl) kickerEl.classList.add('is-active');
    }

    nodes.forEach((node) => {
      node.addEventListener('click', () => select(node));
      node.addEventListener('keydown', (e) => {
        const i = order.indexOf(node);
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          select(node);
        } else if (e.key === 'ArrowRight' || e.key === 'ArrowDown') {
          e.preventDefault();
          focusNode(order[(i + 1) % order.length]);
        } else if (e.key === 'ArrowLeft' || e.key === 'ArrowUp') {
          e.preventDefault();
          focusNode(order[(i - 1 + order.length) % order.length]);
        } else if (e.key === 'Home') {
          e.preventDefault();
          focusNode(order[0]);
        } else if (e.key === 'End') {
          e.preventDefault();
          focusNode(order[order.length - 1]);
        }
      });
    });
  })();
</script>

<script is:inline define:vars={{ nodes, GLOSSARY }}>
  // Bridge server-rendered node data + glossary to the client script.
  window.__ARCH_NODES__    = Object.fromEntries(nodes.map((n) => [n.id, n]));
  window.__ARCH_GLOSSARY__ = GLOSSARY;
</script>

<style>
  .architecture-diagram {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
    gap: 32px;
    align-items: stretch;
  }
  .arch-svg {
    width: 100%;
    height: auto;
    display: block;
  }
  .arch-layer-label {
    fill: rgba(180, 170, 235, 0.78);
    font-family: var(--mono);
    font-size: 0.625rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }
  .arch-boundary {
    fill: rgba(154, 142, 205, 0.04);
    stroke: rgba(154, 142, 205, 0.22);
    stroke-dasharray: 6, 5;
  }
  .arch-boundary-tag {
    fill: rgba(180, 170, 235, 0.72);
    font-family: var(--mono);
    font-size: 0.5625rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .arch-flow line {
    stroke: rgba(180, 170, 235, 0.42);
    stroke-width: 1.4;
    marker-end: url(#arch-arrow);
  }
  .arch-return path {
    fill: none;
    stroke: rgba(74, 222, 128, 0.45);
    stroke-width: 1.2;
    marker-end: url(#arch-arrow-up);
  }
  .arch-return-label {
    fill: rgba(74, 222, 128, 0.78);
    font-family: var(--mono);
    font-size: 0.5625rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .arch-loop {
    fill: none;
    stroke: rgba(180, 170, 235, 0.35);
    stroke-width: 1.1;
    stroke-dasharray: 3, 4;
    marker-end: url(#arch-arrow);
  }

  .arch-node {
    cursor: pointer;
    outline: none;
  }
  .arch-node rect {
    fill: rgba(14, 11, 22, 0.85);
    stroke: rgba(154, 142, 205, 0.28);
    stroke-width: 1;
    transition: fill 0.2s ease, stroke 0.2s ease, filter 0.2s ease;
  }
  .arch-node text {
    fill: rgba(232, 224, 240, 0.92);
    font-family: 'Space Grotesk', system-ui, sans-serif;
    font-size: 0.8125rem;
    font-weight: 600;
    pointer-events: none;
    user-select: none;
  }
  .arch-node--harness rect { stroke: rgba(180, 170, 235, 0.32); }
  .arch-node--project rect { stroke: rgba(74, 222, 128, 0.32); }

  @media (hover: hover) {
    .arch-node:hover rect {
      fill: rgba(20, 16, 32, 0.95);
      stroke: rgba(180, 170, 235, 0.55);
    }
  }
  .arch-node { outline: none; }
  .arch-node:focus-visible rect {
    stroke: #E8DBFF;
    stroke-width: 2;
    filter: drop-shadow(0 0 0 2px rgba(232, 219, 255, 0.45));
  }
  /* Halo for keyboard focus that's perceptible against the dark surface */
  .arch-node:focus-visible {
    filter: drop-shadow(0 0 8px rgba(180, 170, 235, 0.6));
  }
  .arch-node.is-selected rect {
    fill: rgba(154, 142, 205, 0.16);
    stroke: rgba(180, 170, 235, 0.9);
    stroke-width: 1.6;
    filter: drop-shadow(0 0 12px rgba(154, 142, 205, 0.35));
  }
  .arch-node.is-selected text {
    fill: #fff;
  }

  /* Detail panel */
  .arch-detail {
    background: linear-gradient(180deg, rgba(14, 11, 22, 0.85) 0%, rgba(5, 4, 9, 0.7) 100%);
    border: 1px solid rgba(154, 142, 205, 0.18);
    border-radius: 10px;
    padding: 24px;
    display: flex;
    align-items: stretch;
    position: relative; /* tooltip anchor */
  }
  .arch-detail-inner {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .arch-detail-kicker {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: var(--mono);
    font-size: 0.625rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgba(180, 170, 235, 0.55);
  }
  .arch-detail-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: rgba(180, 170, 235, 0.4);
    transition: background 0.2s ease, box-shadow 0.2s ease;
  }
  .arch-detail-kicker.is-active .arch-detail-dot {
    background: var(--vtext);
    box-shadow: 0 0 8px rgba(180, 170, 235, 0.45);
  }
  .arch-detail-title {
    font-size: 1.375rem;
    font-weight: 700;
    color: var(--white);
    line-height: 1.25;
    letter-spacing: -0.015em;
  }
  .arch-detail-body {
    font-size: 0.9375rem;
    line-height: 1.6;
    color: rgba(232, 224, 240, 0.82);
    margin-bottom: 4px;
  }
  .arch-detail-bullets {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .arch-detail-bullets li {
    position: relative;
    padding-left: 22px;
    font-size: 0.875rem;
    line-height: 1.55;
    color: rgba(232, 224, 240, 0.72);
  }
