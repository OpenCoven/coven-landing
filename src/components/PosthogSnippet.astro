---
import fs from 'node:fs';

type AnalyticsMode = 'off' | 'events';
type LocalConfig = { projectApiKey?: string; region?: string; mode?: AnalyticsMode | string };
let cfg: LocalConfig = { projectApiKey: '', region: 'us', mode: 'off' };
try {
  cfg = JSON.parse(fs.readFileSync(new URL('../../analytics/posthog.config.json', import.meta.url), 'utf8'));
} catch {}
const key = (import.meta.env.PUBLIC_POSTHOG_KEY || cfg.projectApiKey || '').trim();
const rawRegion = (import.meta.env.PUBLIC_POSTHOG_REGION || cfg.region || 'us').trim().toLowerCase();
const region = rawRegion === 'eu' ? 'eu' : 'us';
const rawMode = (import.meta.env.PUBLIC_POSTHOG_MODE || cfg.mode || 'off').trim().toLowerCase();
if (rawMode !== 'off' && rawMode !== 'events') throw new Error(`Unsupported PUBLIC_POSTHOG_MODE=${JSON.stringify(rawMode)}; expected "off" or "events".`);
if (rawMode === 'events' && !key) throw new Error('PUBLIC_POSTHOG_MODE=events requires PUBLIC_POSTHOG_KEY.');
const enabled = rawMode === 'events' && Boolean(key);
const ingest = `https://${region}.i.posthog.com`;
---
{enabled && (
