const id=/^[a-z0-9._-]{1,64}$/i,path=/^\/[a-z0-9/_.-]{0,95}$/i,platform=/^(mac|windows|linux|ios)$/,tier=/^(direct|vercel|worker|github)$/;
const schemas=Object.freeze({page_viewed:{path},hero_primary_clicked:{},hero_secondary_clicked:{},principle_opened:{principle:id},guided_demo_started:{},guided_demo_completed:{resolution:id},product_selected:{product_id:id},quickstart_command_copied:{command_id:id},download_menu_opened:{},download_platform_selected:{platform},download_started:{platform},download_fallback_used:{platform,tier},docs_clicked:{},github_clicked:{},discord_clicked:{}});
