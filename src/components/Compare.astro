---
// Capability comparison: Coven vs. a raw harness vs. other agent tools.
// A grid-of-lanes (not a <table>): every verdict is a labelled pill, each
// lane carries an always-visible takeaway, and each lane expands its own
// deep-dive independently. Reflows to stacked cards on mobile.

const columns = [
  { id: 'raw',   label: 'Raw harness', sub: 'Claude Code, Codex direct' },
  { id: 'other', label: 'Other tools', sub: 'IDE-bound agents, suites' },
  { id: 'coven', label: 'Coven',       sub: 'recommended runtime', badge: 'Best fit', highlight: true },
];

// status values: 'yes' | 'partial' | 'no'  (rendered Yes / Limited / No)
const rows = [
  {
    id: 'memory',
    label: 'Cross-session memory',
    take: 'Notes persist and resurface in the next session',
    cells: { raw: 'no', other: 'partial', coven: 'yes' },
    detail:
      'Raw harnesses lose state when the chat ends; most other tools save chat history but not curated working memory per familiar. Coven stores explicit notes that persist and surface in the next session.',
  },
  {
    id: 'scope',
    label: 'Project-scoped boundary',
    take: 'Every session bound to one project record',
    cells: { raw: 'partial', other: 'partial', coven: 'yes' },
    detail:
      'Most tools assume the current directory and trust you to remember. Coven binds every session to a project record — filesystem, git, terminals, and docs all scoped to that root.',
  },
  {
    id: 'multi',
    label: 'Multi-harness through one interface',
    take: 'Codex, Claude Code, and more through one adapter',
    cells: { raw: 'no', other: 'partial', coven: 'yes' },
    detail:
      'A raw harness only knows itself; suites bundle one or two. Coven exposes a neutral adapter contract so Codex, Claude Code, and future CLIs all run the same way.',
  },
  {
    id: 'tools',
    label: 'Inspectable tool contracts',
    take: 'One auditable gateway — fs, git, exec, web',
    cells: { raw: 'partial', other: 'partial', coven: 'yes' },
    detail:
      'Each harness has its own permission model and prompt style. Coven funnels every tool call through one auditable gateway: fs, git, exec, web — same contract, visible logs.',
  },
  {
    id: 'resume',
    label: 'Detach and resume any time',
    take: 'Detach, reboot, resume the live session',
    cells: { raw: 'no', other: 'partial', coven: 'yes' },
    detail:
      'Raw harness sessions die with their terminal. Coven keeps the PTY alive in the runtime, so you can detach, reboot, and pick up exactly where the agent left off.',
  },
  {
    id: 'open',
    label: 'Open framework, locally owned',
    take: 'Read it, swap the adapter, own it locally',
    cells: { raw: 'yes', other: 'no', coven: 'yes' },
    detail:
      "Raw harnesses already run locally; SaaS suites don't. Coven is open and inspectable end-to-end — you can read what it runs, swap the adapter, or replace the gateway.",
  },
];

const verdict = { yes: 'Yes', partial: 'Limited', no: 'No' };
---

<section class="cmp content-section" id="compare" aria-labelledby="cmp-heading">
  <div class="section-header" data-reveal>
    <p class="section-kicker">Compare</p>
    <h2 id="cmp-heading">Why Coven, not just a harness?</h2>
    <p>Same agent CLIs, different runtime around them. Open a capability to see how each option actually behaves.</p>
  </div>

  <div class="cmp-frame panel" data-reveal>
    <div class="cmp-matrix">
      <div class="cmp-head">
        <div class="cmp-corner"><span class="sr-only">Capability</span></div>
        {columns.map((c) => (
          <div class:list={["cmp-colhead", { "is-coven": c.highlight }]}>
            {c.badge && <span class="cmp-badge">{c.badge}</span>}
            <span class="cmp-colhead-label">{c.label}</span>
            <span class="cmp-colhead-sub">{c.sub}</span>
          </div>
        ))}
      </div>

      {rows.map((r, i) => (
        <div class="cmp-lane" data-lane={r.id}>
          <button
            class="cmp-toggle"
            type="button"
            id={`cmp-t-${r.id}`}
            aria-controls={`cmp-d-${r.id}`}
            aria-expanded={i === 0 ? 'true' : 'false'}
          >
            <span class="cmp-toggle-main">
              <span class="cmp-lane-title">{r.label}</span>
              <span class="cmp-lane-take">{r.take}</span>
            </span>
            <svg class="cmp-chevron" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 6l4 4 4-4"/></svg>
          </button>
          {columns.map((c) => {
            const v = r.cells[c.id];
            return (
              <div class:list={["cmp-cell", { "is-coven": c.highlight }]}>
                <span class="cmp-opt">{c.label}</span>
                <span class={`cmp-pill is-${v}`} aria-label={`${c.label} — ${verdict[v]}`}>{verdict[v]}</span>
              </div>
            );
          })}
          <div
            class:list={["cmp-detail", { "is-open": i === 0 }]}
            id={`cmp-d-${r.id}`}
            role="region"
            aria-labelledby={`cmp-t-${r.id}`}
          >
            <div class="cmp-detail-inner"><p>{r.detail}</p></div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<script>
  (function () {
    const root = document.querySelector('.cmp');
    if (!root) return;
    const toggles = Array.from(root.querySelectorAll('.cmp-toggle'));

    function setOpen(btn, open) {
      const detail = document.getElementById(btn.getAttribute('aria-controls'));
      btn.setAttribute('aria-expanded', open ? 'true' : 'false');
      if (detail) detail.classList.toggle('is-open', open);
    }

    toggles.forEach((btn, i) => {
      // Each lane toggles only itself — multiple can stay open at once.
      btn.addEventListener('click', () => {
        setOpen(btn, btn.getAttribute('aria-expanded') !== 'true');
      });
      // Arrow keys move between lane toggles; Enter/Space toggle natively.
      btn.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowDown') { e.preventDefault(); toggles[Math.min(i + 1, toggles.length - 1)].focus(); }
        else if (e.key === 'ArrowUp') { e.preventDefault(); toggles[Math.max(i - 1, 0)].focus(); }
        else if (e.key === 'Home') { e.preventDefault(); toggles[0].focus(); }
        else if (e.key === 'End') { e.preventDefault(); toggles[toggles.length - 1].focus(); }
      });
      // Normalize state to match markup (first open, rest closed).
      setOpen(btn, i === 0);
    });
  })();
</script>

<style>
  .cmp-frame { position: relative; }

  /* Grid pseudo-table: lanes use display:contents so their children align
     to these columns; the detail spans the full width beneath. */
  .cmp-matrix {
    display: grid;
    grid-template-columns: minmax(0, 1.5fr) repeat(3, minmax(92px, 0.9fr));
    row-gap: 0;
  }
  .cmp-head, .cmp-lane { display: contents; }

  /* ── Column headers ── */
  .cmp-corner { border-bottom: 1px solid rgba(154, 142, 205, 0.16); }
  .cmp-colhead {
    display: flex; flex-direction: column; align-items: center; gap: 3px;
    padding: 16px 12px 14px; text-align: center;
    border-bottom: 1px solid rgba(154, 142, 205, 0.16);
  }
  .cmp-colhead-label { font-size: 0.7812rem; font-weight: 700; color: var(--white); }
  .cmp-colhead-sub { font-family: var(--mono); font-size: 0.5625rem; letter-spacing: 0.06em; color: var(--muted); }
  .cmp-badge {
    font-family: var(--mono); font-size: 0.5rem; font-weight: 700;
    letter-spacing: 0.12em; text-transform: uppercase;
    color: var(--vtext);
    background: rgba(154, 142, 205, 0.18);
    border: 1px solid rgba(154, 142, 205, 0.35);
    border-radius: 999px; padding: 2px 8px; margin-bottom: 2px;
  }

  /* ── Coven rail: one continuous highlighted band, header → last cell ── */
  .cmp-colhead.is-coven,
  .cmp-cell.is-coven {
    background: linear-gradient(180deg, rgba(154, 142, 205, 0.14), rgba(154, 142, 205, 0.05));
    border-left: 1px solid rgba(154, 142, 205, 0.30);
    border-right: 1px solid rgba(154, 142, 205, 0.30);
  }
  .cmp-colhead.is-coven { border-top: 1px solid rgba(154, 142, 205, 0.30); border-bottom-color: rgba(154, 142, 205, 0.30); }
  .cmp-lane:last-child .cmp-cell.is-coven { border-bottom: 1px solid rgba(154, 142, 205, 0.30); }

  /* ── Lane toggle (col 1) ── */
  .cmp-toggle {
    display: flex; align-items: center; justify-content: space-between; gap: 12px;
    width: 100%; text-align: left; cursor: pointer;
    background: transparent; border: none;
    padding: 15px 18px;
    border-bottom: 1px solid rgba(154, 142, 205, 0.08);
    transition: background var(--dur-ui) ease;
  }
  .cmp-toggle-main { display: flex; flex-direction: column; gap: 3px; min-width: 0; }
  .cmp-lane-title { font-size: 0.8438rem; font-weight: 600; color: var(--white); }
  .cmp-lane-take { font-size: 0.75rem; line-height: 1.4; color: var(--oc-text-muted); }
  .cmp-chevron { width: 14px; height: 14px; flex: 0 0 auto; color: var(--muted); transition: transform var(--dur-ui) ease; }
  .cmp-toggle[aria-expanded='true'] .cmp-chevron { transform: rotate(180deg); color: var(--vtext); }

  /* ── Verdict cells (cols 2–4) ── */
  .cmp-cell {
    display: flex; align-items: center; justify-content: center;
    padding: 15px 8px;
    border-bottom: 1px solid rgba(154, 142, 205, 0.08);
  }
  .cmp-opt { display: none; } /* shown only in the mobile card layout */
  .cmp-pill {
    display: inline-flex; align-items: center; justify-content: center;
    min-width: 60px; padding: 4px 11px;
    font-size: 0.6875rem; font-weight: 600; letter-spacing: 0.01em;
    border-radius: 999px; border: 1px solid transparent;
  }
  /* Colourblind-safe: distinct text + border-style, not hue alone */
  .cmp-pill.is-yes {
    color: var(--green);
    background: rgba(48, 209, 88, 0.10);
    border-color: rgba(48, 209, 88, 0.30);
  }
  .cmp-pill.is-partial {
    color: var(--coven-violet-light);
    background: rgba(154, 142, 205, 0.10);
    border-color: rgba(154, 142, 205, 0.28);
  }
  .cmp-pill.is-no {
    color: var(--muted);
    background: rgba(255, 255, 255, 0.02);
    border: 1px dashed rgba(255, 255, 255, 0.18);
  }
  .cmp-cell.is-coven .cmp-pill.is-yes {
    font-weight: 700;
    box-shadow: 0 0 10px rgba(48, 209, 88, 0.22);
  }

  /* ── Per-lane detail: animated grid-rows disclosure (motion-gated) ── */
  .cmp-detail {
    grid-column: 1 / -1;
    display: grid;
    grid-template-rows: 1fr; /* no-JS: open */
  }
  :global(.js-on) .cmp-detail {
    grid-template-rows: 0fr;
    transition: grid-template-rows var(--dur-ui) ease;
  }
  :global(.js-on) .cmp-detail.is-open { grid-template-rows: 1fr; }
  .cmp-detail-inner { overflow: hidden; min-height: 0; }
  .cmp-detail-inner p {
    padding: 4px 18px 18px;
    font-size: 0.8125rem; line-height: 1.6;
    color: var(--oc-text-muted);
    max-width: 68ch;
  }

  @media (hover: hover) {
    .cmp-toggle:hover { background: rgba(154, 142, 205, 0.05); }
    .cmp-toggle:hover .cmp-lane-title { color: #fff; }
  }

  /* ── Mobile: reflow to stacked capability cards (not a shrunk table) ── */
  @media (max-width: 720px) {
    .cmp-matrix { display: block; }
    .cmp-head { display: none; }
    .cmp-lane {
      display: block;
      border: 1px solid var(--border-v);
      border-radius: var(--radius-md);
      overflow: hidden;
      margin-bottom: 10px;
    }
    .cmp-lane:last-child { margin-bottom: 0; }
    .cmp-toggle { border-bottom: 1px solid rgba(154, 142, 205, 0.12); }
    .cmp-cell {
      justify-content: space-between;
      padding: 11px 16px;
      border-bottom: 1px solid rgba(154, 142, 205, 0.06);
      border-left: none; border-right: none;
    }
    .cmp-cell.is-coven {
      background: rgba(154, 142, 205, 0.10);
      border-left: 2px solid rgba(154, 142, 205, 0.45);
    }
    .cmp-opt { display: inline; font-size: 0.75rem; color: var(--muted); }
    .cmp-detail { display: block; grid-template-rows: none; }
    :global(.js-on) .cmp-detail { display: none; }
    :global(.js-on) .cmp-detail.is-open { display: block; }
    .cmp-detail-inner p { padding: 12px 16px 14px; }
  }
</style>
