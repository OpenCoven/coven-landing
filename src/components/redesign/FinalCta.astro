---
import DownloadCta from './DownloadCta.astro';
---
<section id="get" data-dl-scope="" style="border-top: 1px solid var(--cv-border-hairline)">
  <div style="max-width: 1140px; margin: 0 auto; padding: 84px 32px 92px; display: flex; flex-direction: column; align-items: flex-start; gap: 20px">
    <h2 data-anim="" style="font-family: 'EB Garamond', serif; font-weight: 400; letter-spacing: -0.018em; margin: 0; font-size: 46px; max-width: 24ch">Install Cave, then open a repo.</h2>
    <p style="font-size: 16px; line-height: 1.65; color: var(--cv-text-secondary); max-width: 52ch; margin: 0; text-wrap: pretty">The daemon runs on your machine. Point it at a project and every session working there shares one record.</p>
    <div data-r="ctarow" style="display: flex; align-items: center; gap: 18px; margin-top: 8px">
      <DownloadCta />
      <button type="button" data-copy="npm install -g @opencoven/cli" data-action="copy" data-r="copybtn" style="font-family: 'JetBrains Mono', monospace; font-variant-ligatures: none; font-size: 12.5px; color: var(--cv-text-secondary); background: var(--cv-bg-raised); border: 1px solid var(--cv-border-hairline); border-radius: 8px; padding: 12px 14px; cursor: pointer; white-space: nowrap; box-sizing: border-box; align-self: stretch; display: inline-flex; align-items: center; gap: 0; transition: background-color 160ms cubic-bezier(0.2,0,0,1), color 160ms cubic-bezier(0.2,0,0,1)" class="rh0">npm i -g @opencoven/cli<span data-copy-label="" style="letter-spacing: 0.06em; text-transform: uppercase; font-size: 9.5px">copy</span></button>
    </div>
    
    <p data-dl-status="" role="status" aria-live="polite" style="display: none; font-family: 'JetBrains Mono', monospace; font-variant-ligatures: none; font-size: 11px; color: var(--cv-text-secondary); margin: 0; align-items: center; gap: 10px"></p>
  </div>
</section>
