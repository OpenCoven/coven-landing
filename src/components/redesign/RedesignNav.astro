---
// Shared across the landing page and the secondary pages. The landing page
// scrolls to its own in-page anchors, so those stay the defaults; pages that
// have no #top/#get section of their own pass absolute paths back to home.
interface Props {
  brandHref?: string;
  ctaHref?: string;
}
const { brandHref = '#top', ctaHref = '#get' } = Astro.props;
---
<nav data-nav="" style="position: fixed; top: 0; left: 0; right: 0; min-width: 1140px; z-index: 60; background: transparent; border-bottom: 1px solid transparent; will-change: transform; transition: transform 300ms cubic-bezier(0.2,0,0,1), background-color 220ms cubic-bezier(0.2,0,0,1), border-color 220ms cubic-bezier(0.2,0,0,1)">
  <div style="max-width: 1140px; margin: 0 auto; padding: 0 32px; height: 60px; display: flex; align-items: center; justify-content: space-between">
    <a href={brandHref} style="display: flex; align-items: center; gap: 11px; font-weight: 600; font-size: 16px; letter-spacing: -0.01em">
      <img src="/assets/opencoven-mark-line.svg" alt="OpenCoven" width="34" height="34" style="width: 34px; height: 34px; display: block; filter: var(--cv-logo-filter)">
      OpenCoven
    </a>
    <div style="display: flex; align-items: center; gap: 20px; font-size: 14px; color: var(--cv-text-secondary)">
      <span data-r="navlinks" style="display: flex; align-items: center; gap: 20px">
        <a href="/how-it-works" style="color: var(--cv-text-secondary)">How it works</a>
        <a href="https://github.com/OpenCoven/coven" style="color: var(--cv-text-secondary)">GitHub</a>
      </span>
      <a data-r="navcta" href={ctaHref} style="display: none; align-items: center; padding: 8px 14px; border-radius: 999px; background: var(--cv-accent); color: var(--cv-accent-fg); font-size: 13px; font-weight: 500">Download</a>
      <button type="button" data-action="toggleTheme" aria-label="Switch to light mode" data-dcb="themeAria:aria-label" style="width: 34px; height: 34px; border-radius: 999px; border: 1px solid var(--cv-border-hairline); background: var(--cv-bg-raised); color: var(--cv-text-secondary); font-size: 13px; cursor: pointer; display: inline-flex; align-items: center; justify-content: center; font-family: inherit" class="rh0"><i class="ph ph-moon-stars" data-dcb="themeIcon:class" aria-hidden="true" style="font-size: 15px; line-height: 1"></i></button>
    </div>
  </div>
</nav>
