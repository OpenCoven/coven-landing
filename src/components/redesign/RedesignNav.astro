---
// Shared across the landing page and the secondary pages. The landing page
// scrolls to its own in-page anchors, so those stay the defaults; pages that
// have no #top/#get section of their own pass absolute paths back to home.
interface Props {
  brandHref?: string;
  ctaHref?: string;
}
const { brandHref = '#top', ctaHref = '#get' } = Astro.props;

// One list feeds the desktop links and the narrow-width menu, so the two cannot drift.
// Docs points at the Getting started page the footer already links.
const navLinks = [
  { label: 'How it works', href: '/how-it-works' },
  { label: 'Docs', href: 'https://docs.opencoven.ai/docs/guide/getting-started' },
  { label: 'GitHub', href: 'https://github.com/OpenCoven/coven' },
];
---
<nav data-nav="" style="position: fixed; top: 0; left: 0; right: 0; min-width: 1140px; z-index: 60; background: transparent; border-bottom: 1px solid transparent; will-change: transform; transition: transform 300ms cubic-bezier(0.2,0,0,1), background-color 220ms cubic-bezier(0.2,0,0,1), border-color 220ms cubic-bezier(0.2,0,0,1)">
  <div class="landing-container" style=" padding-block: 0; height: 60px; display: flex; align-items: center; justify-content: space-between">
    <a href={brandHref} style="display: flex; align-items: center; gap: 10px; font-weight: 600; font-size: 17.5px; letter-spacing: -0.015em">
      <img src="/assets/opencoven-mark-line.svg" alt="" width="30" height="30" style="width: 30px; height: 30px; display: block; filter: var(--cv-logo-filter)">
      <span data-r="wordmark">OpenCoven</span>
    </a>
    <div data-r="navtools" style="display: flex; align-items: center; gap: 20px; font-size: 14px; color: var(--cv-text-secondary)">
      <span data-r="navlinks" style="display: flex; align-items: center; gap: 20px">
        {navLinks.map((link) => (
          <a href={link.href} style="color: var(--cv-text-secondary)">{link.label}</a>
        ))}
      </span>
      <a data-r="navcta" href={ctaHref} style="display: none; align-items: center; padding: 8px 14px; border-radius: 999px; background: var(--cv-accent); color: var(--cv-accent-fg); font-size: 13px; font-weight: 500">Download</a>
      <button type="button" data-r="themebtn" data-action="toggleTheme" aria-label="Switch to light mode" data-dcb="themeAria:aria-label" style="width: 34px; height: 34px; border-radius: 999px; border: 1px solid var(--cv-border-hairline); background: var(--cv-bg-raised); color: var(--cv-text-secondary); font-size: 13px; cursor: pointer; display: inline-flex; align-items: center; justify-content: center; font-family: inherit" class="rh0"><i class="ph ph-moon-stars" data-dcb="themeIcon:class" aria-hidden="true" style="font-size: 15px; line-height: 1"></i></button>
      <!-- Below 720px the three links move into this menu. It is a native disclosure, so it
           opens without JavaScript; nav.js adds Escape, outside-tap close and focus return. -->
      <details data-nav-menu="" data-r="navmenu" style="display: none; position: relative">
        <summary aria-label="Menu" style="width: 34px; height: 34px; box-sizing: border-box; border-radius: 999px; border: 1px solid var(--cv-border-hairline); background: var(--cv-bg-raised); color: var(--cv-text-secondary); cursor: pointer; display: inline-flex; align-items: center; justify-content: center; list-style: none" class="rh0"><i class="ph ph-list" aria-hidden="true" style="font-size: 16px; line-height: 1"></i></summary>
        <div data-nav-menu-panel="" style="position: absolute; top: calc(100% + 10px); right: 0; z-index: 70; min-width: 196px; display: flex; flex-direction: column; padding: 6px; background: var(--cv-bg-elevated); border: 1px solid var(--cv-border-hairline); border-radius: 12px; box-shadow: var(--cv-shadow)">
          {navLinks.map((link) => (
            <a href={link.href} style="display: flex; align-items: center; min-height: 44px; padding: 0 12px; border-radius: 8px; font-size: 15px; color: var(--cv-text-primary)" class="rh0">{link.label}</a>
          ))}
        </div>
      </details>
    </div>
  </div>
</nav>
