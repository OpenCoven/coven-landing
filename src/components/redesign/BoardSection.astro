---
import Board from './Board.astro';
---
<section id="board" class="landing-container" style=" padding: 24px 32px 80px">
  <Board />

  <div data-anim="" style="display: flex; flex-direction: column; align-items: flex-start; gap: 14px; margin-top: 40px">
    <h2 style="font-family: 'EB Garamond', serif; font-weight: 400; font-size: 42px; letter-spacing: -0.018em; margin: 0; max-width: 22ch">One shared record.</h2>
    <p style="font-size: 15px; line-height: 1.6; color: var(--cv-text-secondary); max-width: 62ch; margin: 0">Every session keeps its own memory and its own worktree. None of them knows about the other three. Coven caught this overlap before either agent shipped.</p>
    <div style="display: flex; align-items: center; gap: 20px; margin-top: 20px">
      <a href="/how-it-works" style="display: inline-flex; align-items: center; gap: 8px; padding: 12px 18px; border: 1px solid var(--cv-border-hairline); border-radius: 8px; font-size: 14px; font-weight: 500; color: var(--cv-text-secondary); transition: background-color 160ms cubic-bezier(0.2,0,0,1), color 160ms cubic-bezier(0.2,0,0,1)" class="rh2">See how it works <span style="font-size: 13px" aria-hidden="true">→</span></a>
    </div>
  </div>
</section>

<!-- Three outcomes -->
