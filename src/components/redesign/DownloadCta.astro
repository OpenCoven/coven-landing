<div
  data-r="dlwrap"
  style="font-family: 'Inter', system-ui, sans-serif; position: relative; display: inline-flex; align-items: stretch"
>
  <a
    data-dl-btn=""
    data-dl-platform="mac"
    data-dl-label="Download Cave for macOS"
    href="/download/mac"
    style="position: relative; min-width: 244px; padding: 13px 22px; border: none; background: var(--cv-accent, #6859ac); color: var(--cv-accent-fg, oklch(0.99 0.004 291)); border-radius: 8px 0 0 8px; box-sizing: border-box; font-family: inherit; font-size: 15px; font-weight: 500; cursor: pointer; display: inline-flex; align-items: center; justify-content: center; gap: 9px; transition: background-color 160ms cubic-bezier(0.2,0,0,1)"
    class="rh4"
  >
    <i class="ph ph-download-simple" aria-hidden="true" style="font-size: 16px; line-height: 1"></i>
    <span data-dl-label="">Download Cave for macOS</span>
  </a>

  <button
    type="button"
    data-action="toggleDownloads"
    aria-label="Choose another Cave platform or inspect release artifacts"
    aria-expanded="false"
    aria-haspopup="true"
    style="width: 44px; border: none; border-left: 1px solid color-mix(in oklch, var(--cv-accent-fg, oklch(0.99 0.004 291)) 26%, transparent); background: var(--cv-accent, #6859ac); color: var(--cv-accent-fg, oklch(0.99 0.004 291)); border-radius: 0 8px 8px 0; cursor: pointer; font-family: inherit; font-size: 10px; display: inline-flex; align-items: center; justify-content: center; transition: background-color 160ms cubic-bezier(0.2,0,0,1)"
    class="rh5"
  >
    <span aria-hidden="true">▾</span>
  </button>

  <div
    data-dl-menu=""
    hidden
    role="region"
    aria-label="Cave download options"
    style="position: absolute; top: calc(100% + 8px); left: 0; width: min(380px, calc(100vw - 40px)); text-align: left; background: var(--cv-bg-elevated, oklch(0.995 0.004 291)); border: 1px solid var(--cv-border-hairline, oklch(0.26 0.020 291 / 14%)); border-radius: 12px; box-shadow: 0 1px 2px oklch(0.1 0.02 291 / 14%), 0 22px 52px oklch(0.1 0.02 291 / 26%); padding: 6px; opacity: 0; visibility: hidden; transform: translateY(-6px); transition: opacity 180ms cubic-bezier(0.2,0,0,1), transform 180ms cubic-bezier(0.2,0,0,1), visibility 180ms; z-index: 80"
  >
    <div style="padding: 10px 11px 8px; display: flex; flex-direction: column; gap: 4px">
      <span style="font-family: 'JetBrains Mono', monospace; font-size: 10px; letter-spacing: 0.1em; text-transform: uppercase; color: var(--cv-text-muted)">Cave desktop release</span>
      <span style="font-size: 12.5px; line-height: 1.45; color: var(--cv-text-secondary)">The primary link uses your browser's download manager. Release metadata below updates from the signed GitHub release when available.</span>
    </div>

    <div data-dl-panes="">
      <div data-dl-pane="mac" role="tabpanel" style="display: flex; flex-direction: column">
        <div style="display: flex; align-items: baseline; gap: 8px; padding: 8px 11px 5px">
          <span style="font-family: 'JetBrains Mono', monospace; font-size: 10px; letter-spacing: 0.08em; text-transform: uppercase; color: var(--cv-text-muted)">macOS · <span data-art-ver="">latest release</span></span>
        </div>
        <a data-art="mac-arm64" href="https://github.com/OpenCoven/coven-cave/releases/latest" style="display: grid; grid-template-columns: 28px minmax(0, 1fr) auto; align-items: center; gap: 3px 11px; padding: 9px 11px; border-radius: 8px" class="rh6">
          <span style="grid-row: 1 / 3; width: 28px; height: 28px; border-radius: 7px; border: 1px solid var(--cv-border-hairline); background: var(--cv-bg-raised); display: inline-flex; align-items: center; justify-content: center; color: var(--cv-text-secondary)"><i class="ph ph-apple-logo" aria-hidden="true" style="font-size: 15px"></i></span>
          <span style="font-size: 14px; font-weight: 500">Apple silicon</span>
          <span data-art-size="" style="font-family: 'JetBrains Mono', monospace; font-size: 10.5px; color: var(--cv-text-muted)">current release</span>
          <span data-art-file="" style="grid-column: 2 / -1; font-family: 'JetBrains Mono', monospace; font-size: 10.5px; color: var(--cv-text-muted); overflow: hidden; text-overflow: ellipsis; white-space: nowrap">Open the latest signed release</span>
        </a>
        <div style="display: flex; gap: 6px; padding: 0 11px 8px">
          <button type="button" data-art-verify="mac-arm64" data-copy="" data-action="copy" hidden title="Copy the SHA-256 verification command" style="flex: 1; min-width: 0; align-items: center; text-align: left; font-family: 'JetBrains Mono', monospace; font-size: 10.5px; color: var(--cv-text-muted); background: var(--cv-bg-sunken); border: 1px solid var(--cv-border-hairline); border-radius: 6px; padding: 6px 8px; cursor: pointer" class="rh7"><span data-art-hash="">SHA-256</span><span data-copy-label="" style="margin-left: auto">copy</span></button>
          <a data-art-sig="mac-arm64" href="https://github.com/OpenCoven/coven-cave/releases/latest" hidden style="font-family: 'JetBrains Mono', monospace; font-size: 10.5px; color: var(--cv-text-muted); border: 1px solid var(--cv-border-hairline); border-radius: 6px; padding: 6px 8px" class="rh8">.sig</a>
        </div>
        <a data-art="mac-x64" href="https://github.com/OpenCoven/coven-cave/releases/latest" style="display: grid; grid-template-columns: 28px minmax(0, 1fr) auto; align-items: center; gap: 3px 11px; padding: 9px 11px; border-radius: 8px" class="rh6">
          <span style="grid-row: 1 / 3; width: 28px; height: 28px; border-radius: 7px; border: 1px solid var(--cv-border-hairline); background: var(--cv-bg-raised); display: inline-flex; align-items: center; justify-content: center; color: var(--cv-text-secondary)"><i class="ph ph-cpu" aria-hidden="true" style="font-size: 15px"></i></span>
          <span style="font-size: 14px; font-weight: 500">Intel</span>
          <span data-art-size="" style="font-family: 'JetBrains Mono', monospace; font-size: 10.5px; color: var(--cv-text-muted)">current release</span>
          <span data-art-file="" style="grid-column: 2 / -1; font-family: 'JetBrains Mono', monospace; font-size: 10.5px; color: var(--cv-text-muted); overflow: hidden; text-overflow: ellipsis; white-space: nowrap">Open the latest signed release</span>
        </a>
        <div style="display: flex; gap: 6px; padding: 0 11px 8px">
          <button type="button" data-art-verify="mac-x64" data-copy="" data-action="copy" hidden title="Copy the SHA-256 verification command" style="flex: 1; min-width: 0; align-items: center; text-align: left; font-family: 'JetBrains Mono', monospace; font-size: 10.5px; color: var(--cv-text-muted); background: var(--cv-bg-sunken); border: 1px solid var(--cv-border-hairline); border-radius: 6px; padding: 6px 8px; cursor: pointer" class="rh7"><span data-art-hash="">SHA-256</span><span data-copy-label="" style="margin-left: auto">copy</span></button>
          <a data-art-sig="mac-x64" href="https://github.com/OpenCoven/coven-cave/releases/latest" hidden style="font-family: 'JetBrains Mono', monospace; font-size: 10.5px; color: var(--cv-text-muted); border: 1px solid var(--cv-border-hairline); border-radius: 6px; padding: 6px 8px" class="rh8">.sig</a>
        </div>
      </div>

      <div data-dl-pane="windows" role="tabpanel" hidden style="display: none; flex-direction: column">
        <div style="padding: 8px 11px 5px"><span style="font-family: 'JetBrains Mono', monospace; font-size: 10px; letter-spacing: 0.08em; text-transform: uppercase; color: var(--cv-text-muted)">Windows · <span data-art-ver="">latest release</span></span></div>
        <a data-art="win-x64" href="https://github.com/OpenCoven/coven-cave/releases/latest" style="display: grid; grid-template-columns: 28px minmax(0, 1fr) auto; align-items: center; gap: 3px 11px; padding: 9px 11px; border-radius: 8px" class="rh6">
          <span style="grid-row: 1 / 3; width: 28px; height: 28px; border-radius: 7px; border: 1px solid var(--cv-border-hairline); background: var(--cv-bg-raised); display: inline-flex; align-items: center; justify-content: center; color: var(--cv-text-secondary)"><i class="ph ph-windows-logo" aria-hidden="true" style="font-size: 15px"></i></span>
          <span style="font-size: 14px; font-weight: 500">Windows x64</span>
          <span data-art-size="" style="font-family: 'JetBrains Mono', monospace; font-size: 10.5px; color: var(--cv-text-muted)">current release</span>
          <span data-art-file="" style="grid-column: 2 / -1; font-family: 'JetBrains Mono', monospace; font-size: 10.5px; color: var(--cv-text-muted); overflow: hidden; text-overflow: ellipsis; white-space: nowrap">Open the latest signed release</span>
        </a>
        <div style="display: flex; gap: 6px; padding: 0 11px 8px">
          <button type="button" data-art-verify="win-x64" data-copy="" data-action="copy" hidden title="Copy the SHA-256 verification command" style="flex: 1; min-width: 0; align-items: center; text-align: left; font-family: 'JetBrains Mono', monospace; font-size: 10.5px; color: var(--cv-text-muted); background: var(--cv-bg-sunken); border: 1px solid var(--cv-border-hairline); border-radius: 6px; padding: 6px 8px; cursor: pointer" class="rh7"><span data-art-hash="">SHA-256</span><span data-copy-label="" style="margin-left: auto">copy</span></button>
          <a data-art-sig="win-x64" href="https://github.com/OpenCoven/coven-cave/releases/latest" hidden style="font-family: 'JetBrains Mono', monospace; font-size: 10.5px; color: var(--cv-text-muted); border: 1px solid var(--cv-border-hairline); border-radius: 6px; padding: 6px 8px" class="rh8">.sig</a>
        </div>
      </div>

      <div data-dl-pane="linux" role="tabpanel" hidden style="display: none; flex-direction: column">
        <div style="padding: 8px 11px 5px"><span style="font-family: 'JetBrains Mono', monospace; font-size: 10px; letter-spacing: 0.08em; text-transform: uppercase; color: var(--cv-text-muted)">Linux · <span data-art-ver="">latest release</span></span></div>
        <a data-art="linux-amd64" href="https://github.com/OpenCoven/coven-cave/releases/latest" style="display: grid; grid-template-columns: 28px minmax(0, 1fr) auto; align-items: center; gap: 3px 11px; padding: 9px 11px; border-radius: 8px" class="rh6">
          <span style="grid-row: 1 / 3; width: 28px; height: 28px; border-radius: 7px; border: 1px solid var(--cv-border-hairline); background: var(--cv-bg-raised); display: inline-flex; align-items: center; justify-content: center; color: var(--cv-text-secondary)"><i class="ph ph-linux-logo" aria-hidden="true" style="font-size: 15px"></i></span>
          <span style="font-size: 14px; font-weight: 500">Linux x86_64 AppImage</span>
          <span data-art-size="" style="font-family: 'JetBrains Mono', monospace; font-size: 10.5px; color: var(--cv-text-muted)">current release</span>
          <span data-art-file="" style="grid-column: 2 / -1; font-family: 'JetBrains Mono', monospace; font-size: 10.5px; color: var(--cv-text-muted); overflow: hidden; text-overflow: ellipsis; white-space: nowrap">Open the latest signed release</span>
        </a>
        <div style="display: flex; gap: 6px; padding: 0 11px 8px">
          <button type="button" data-art-verify="linux-amd64" data-copy="" data-action="copy" hidden title="Copy the SHA-256 verification command" style="flex: 1; min-width: 0; align-items: center; text-align: left; font-family: 'JetBrains Mono', monospace; font-size: 10.5px; color: var(--cv-text-muted); background: var(--cv-bg-sunken); border: 1px solid var(--cv-border-hairline); border-radius: 6px; padding: 6px 8px; cursor: pointer" class="rh7"><span data-art-hash="">SHA-256</span><span data-copy-label="" style="margin-left: auto">copy</span></button>
          <a data-art-sig="linux-amd64" href="https://github.com/OpenCoven/coven-cave/releases/latest" hidden style="font-family: 'JetBrains Mono', monospace; font-size: 10.5px; color: var(--cv-text-muted); border: 1px solid var(--cv-border-hairline); border-radius: 6px; padding: 6px 8px" class="rh8">.sig</a>
        </div>
      </div>
    </div>

    <div data-art-prov-block="" hidden style="padding: 8px 11px; border-top: 1px solid var(--cv-border-hairline)">
      <a href="https://github.com/OpenCoven/coven-cave/attestations" style="display: inline-flex; align-items: center; gap: 7px; font-size: 12.5px; color: var(--cv-text-secondary)" class="rh9"><i class="ph ph-git-commit" aria-hidden="true"></i>Build provenance — commit and workflow</a>
    </div>

    <div role="tablist" aria-label="Cave download platform" style="display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 5px; padding: 6px; border-top: 1px solid var(--cv-border-hairline)">
      <button type="button" role="tab" data-dl-plat="mac" data-action="pickPlatform" aria-selected="true" tabindex="0" style="border: 1px solid color-mix(in oklch, var(--cv-accent) 45%, transparent); border-radius: 7px; padding: 8px 6px; background: var(--cv-bg-hover); color: var(--cv-text-primary); font-family: inherit; cursor: pointer">macOS</button>
      <button type="button" role="tab" data-dl-plat="windows" data-action="pickPlatform" aria-selected="false" tabindex="-1" style="border: 1px solid var(--cv-border-hairline); border-radius: 7px; padding: 8px 6px; background: transparent; color: var(--cv-text-secondary); font-family: inherit; cursor: pointer">Windows</button>
      <button type="button" role="tab" data-dl-plat="linux" data-action="pickPlatform" aria-selected="false" tabindex="-1" style="border: 1px solid var(--cv-border-hairline); border-radius: 7px; padding: 8px 6px; background: transparent; color: var(--cv-text-secondary); font-family: inherit; cursor: pointer">Linux</button>
    </div>

    <a href="https://testflight.apple.com/join/61Dqw8y4" style="display: flex; align-items: center; gap: 8px; margin: 2px 6px 6px; padding: 9px 11px; border-radius: 8px; font-size: 12.5px; color: var(--cv-text-secondary)" class="rh6"><i class="ph ph-device-mobile" aria-hidden="true"></i>iOS companion · TestFlight</a>
  </div>
</div>
