---
const groups = [
  { title: 'Start', links: [
    ['How it works', '/how-it-works'],
    ['Getting started', 'https://docs.opencoven.ai/docs/guide/getting-started'],
    ['Core concepts', 'https://docs.opencoven.ai/docs/guide/concepts'],
    ['CLI reference', 'https://docs.opencoven.ai/docs/cli'],
  ] },
  { title: 'Resources', links: [
    ['Architecture', 'https://docs.opencoven.ai/docs/guide/architecture'],
    ['Harnesses', 'https://docs.opencoven.ai/docs/harnesses'],
    ['Component browser', 'https://ui.opencoven.ai'],
    ['Changelog', 'https://github.com/OpenCoven/coven-cave/releases'],
  ] },
  { title: 'Project', links: [
    ['GitHub', 'https://github.com/OpenCoven/coven'],
    ['Issues', 'https://github.com/OpenCoven/coven/issues'],
    ['Contributing', 'https://github.com/OpenCoven/coven/blob/main/CONTRIBUTING.md'],
    ['MIT licence', 'https://github.com/OpenCoven/coven/blob/main/LICENSE'],
  ] },
  { title: 'Community & legal', links: [
    ['Discord', 'https://discord.gg/opencoven'],
    ['X', 'https://x.com/opencvn'],
    ['Privacy', '/privacy'],
    ['Terms', '/terms'],
  ] },
];
---
<footer style="font-family: 'Inter', system-ui, sans-serif; border-top: 1px solid var(--cv-border-hairline, oklch(0.26 0.020 291 / 14%)); background: var(--cv-bg-base, oklch(0.958 0.010 291)); position: relative; overflow: hidden">
  <div data-r="footcols" class="footer-columns">
    <div style="display: none; flex-direction: column; gap: 14px">
      <span style="font-family: 'JetBrains Mono', monospace; font-variant-ligatures: none; font-size: 10px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--cv-text-muted, oklch(0.515 0.014 291))">Product</span>
      <div style="display: flex; flex-direction: column; gap: 11px; align-items: flex-start">
        <a href="https://opencoven.ai/cave" style="color: var(--cv-text-secondary, oklch(0.44 0.016 291)); font-size: 13.5px; line-height: 1" class="rh9">Cave</a>
        <a href="https://opencoven.ai/cli" style="color: var(--cv-text-secondary, oklch(0.44 0.016 291)); font-size: 13.5px; line-height: 1" class="rh9">CLI</a>
        <a href="https://opencoven.ai/code" style="color: var(--cv-text-secondary, oklch(0.44 0.016 291)); font-size: 13.5px; line-height: 1" class="rh9">Code</a>
      </div>
    </div>
    {groups.map(group => (
      <div class="footer-column">
        <span class="footer-heading">{group.title}</span>
        <div class="footer-links">
          {group.links.map(([label, href]) => <a href={href} class="rh9">{label}</a>)}
        </div>
      </div>
    ))}
  </div>

  <div style="border-top: 1px solid var(--cv-border-hairline, oklch(0.26 0.020 291 / 14%))">
    <div data-r="footrow" style="max-width: 1140px; margin: 0 auto; padding: 22px 32px 26px; display: flex; align-items: center; justify-content: space-between; gap: 20px; font-size: 13px; color: var(--cv-text-muted, oklch(0.515 0.014 291))">
      <span>© 2026 OpenCoven · MIT licensed</span>
      <a href="https://www.daytona.io/" target="_blank" rel="noopener noreferrer" aria-label="Daytona (opens in a new tab)" style="display: inline-flex; align-items: center; align-self: flex-end; margin-left: auto; color: inherit" class="rh9">
        <img data-daytona-logo="light" src="/assets/daytona.svg" alt="" width="210" height="41" style="display: block; width: 210px !important; max-width: 100%; height: auto" />
        <img data-daytona-logo="dark" src="/assets/daytona-dark.svg" alt="" width="210" height="41" style="display: none; width: 210px !important; max-width: 100%; height: auto" />
      </a>
    </div>
  </div>

  <!-- the wordmark the page ends on: half-cropped so the footer reads as ground, not a band -->
  <div data-r="footmark" aria-hidden="true" style="position: relative; height: 200px; margin-top: 8px; overflow: hidden; pointer-events: none">
    <div style="position: absolute; left: 50%; top: 0; transform: translateX(-50%); width: 1140px; max-width: 100%; padding: 0 32px; box-sizing: border-box; font-family: 'Inter', system-ui, sans-serif; font-weight: 400; font-size: min(190px, calc((100vw - 68px) / 5.65)); line-height: 0.86; letter-spacing: -0.01em; white-space: nowrap; color: transparent; -webkit-text-stroke: 1px var(--cv-border-hairline, oklch(0.26 0.020 291 / 14%)); mask-image: linear-gradient(180deg, #000 0 42%, transparent 88%); -webkit-mask-image: linear-gradient(180deg, #000 0 42%, transparent 88%)">OpenCoven</div>
  </div>
</footer>

<style>
  .footer-columns { max-width: 1140px; margin: 0 auto; padding: 48px 32px 40px; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 32px 40px; }
  .footer-column { display: grid; grid-template-rows: auto 1fr; gap: 14px; }
  .footer-heading { font-family: 'JetBrains Mono', monospace; font-variant-ligatures: none; font-size: 10px; line-height: 1.5; letter-spacing: .12em; text-transform: uppercase; color: var(--cv-text-muted, oklch(0.515 0.014 291)); }
  .footer-links { display: grid; grid-template-rows: repeat(4, 1fr); gap: 8px; }
  .footer-links a { color: var(--cv-text-secondary, oklch(0.44 0.016 291)); font-size: 13.5px; line-height: 1.5; align-content: center; overflow-wrap: anywhere; }
  @media (max-width: 719px) {
    .footer-links { grid-template-rows: repeat(4, minmax(44px, 1fr)); }
  }
</style>
