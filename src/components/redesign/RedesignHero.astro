---
import DownloadCta from './DownloadCta.astro';
---
<header id="top" style="position: relative; max-width: 1140px; margin: 0 auto; padding: 132px 32px 40px; display: grid; grid-template-columns: minmax(0, 560px) minmax(0, 1fr); gap: 40px; align-items: center; text-align: left">
  <div data-hero="" data-dl-scope="" style="position: relative; display: flex; flex-direction: column; align-items: flex-start; gap: 24px; top: -41px">
    <h1 style="font-family: 'EB Garamond', serif; font-weight: 400; font-size: 72px; line-height: 0.98; letter-spacing: -0.028em; margin: 0; max-width: 13ch; text-wrap: balance">Stop being your agents' control plane.</h1>
    <p style="font-size: 18px; line-height: 1.6; color: var(--cv-text-secondary); max-width: 46ch; margin: 0; text-wrap: pretty">When two agents reach for the same files, one loses the work. Coven decides who waits, and keeps the record of why.</p>
    <div data-r="ctarow" style="display: flex; align-items: center; gap: 18px; margin-top: 4px">
      <DownloadCta />
      <button type="button" data-copy="npm install -g @opencoven/cli" data-action="copy" data-r="copybtn" style="font-family: 'JetBrains Mono', monospace; font-variant-ligatures: none; font-size: 12.5px; color: var(--cv-text-secondary); background: var(--cv-bg-raised); border: 1px solid var(--cv-border-hairline); border-radius: 8px; padding: 12px 14px; cursor: pointer; white-space: nowrap; box-sizing: border-box; align-self: stretch; display: inline-flex; align-items: center; gap: 0; transition: background-color 160ms cubic-bezier(0.2,0,0,1), color 160ms cubic-bezier(0.2,0,0,1)" class="rh0">npm i -g @opencoven/cli<span data-copy-label="" style="letter-spacing: 0.06em; text-transform: uppercase; font-size: 9.5px">copy</span></button>
    </div>
    <p data-dl-status="" role="status" aria-live="polite" style="display: none; font-family: 'JetBrains Mono', monospace; font-variant-ligatures: none; font-size: 11px; color: var(--cv-text-secondary); margin: 0; align-items: center; gap: 10px"></p>
    <p data-r="mobilenote" style="display: none; font-size: 13px; line-height: 1.5; color: var(--cv-text-muted); margin: 0">Cave is a desktop app. Copy the install line and run it on the machine your agents work on.</p>

    <div style="display: flex; align-items: center; gap: 14px; flex-wrap: wrap; font-family: 'JetBrains Mono', monospace; font-variant-ligatures: none; font-size: 11px; color: var(--cv-text-muted)">
      <!-- every figure here is fetched live; each item hides itself if its API call fails -->
      <a data-proof="stars" data-proof-display="inline-flex" href="https://github.com/OpenCoven" style="position: relative; display: none; align-items: center; color: var(--cv-text-secondary)" class="rh1"><i class="ph ph-github-logo" aria-hidden="true" style="font-size: 14px; line-height: 1; margin-right: 5px"></i><span style="white-space: nowrap"><span data-stars-count="">0</span> stars</span><span data-stars-pop="" style="position: absolute; top: calc(100% + 9px); left: -9px; z-index: 50; width: 252px; box-sizing: border-box; display: flex; flex-direction: column; gap: 2px; padding: 10px 12px 11px; text-align: left; background: var(--cv-bg-elevated); border: 1px solid var(--cv-border-hairline); border-radius: 10px; box-shadow: 0 1px 2px oklch(0.1 0.02 291 / 14%), 0 18px 44px oklch(0.1 0.02 291 / 26%); color: var(--cv-text-secondary)"><span style="font-size: 10px; letter-spacing: 0.1em; text-transform: uppercase; color: var(--cv-text-muted); padding-bottom: 5px">Across the org</span><span data-stars-rows="" style="display: flex; flex-direction: column"></span></span></a>
      <span data-proof-sep="stars" style="display: none">·</span>
      <a data-proof="downloads" href="https://github.com/OpenCoven/coven-cave/releases" style="display: none; color: var(--cv-text-secondary)" class="rh1"><span data-dlcount="">0</span> downloads</a>
      <span data-proof-sep="downloads" style="display: none">·</span>
      <a data-proof="discord" data-proof-display="inline-flex" href="https://discord.gg/opencoven" style="display: none; align-items: center; color: var(--cv-text-secondary)" class="rh1"><i class="ph ph-discord-logo" aria-hidden="true" style="font-size: 14px; line-height: 1; margin-right: 5px"></i><span style="white-space: nowrap"><span data-discord-count="">0</span> <span data-discord-label="">members</span></span></a>
    </div>
  </div>

  <div data-braid="" data-live="off" data-dcb="braidPower:data-live" style="position: absolute; left: -56px; right: -8px; top: 18px; bottom: -18px; z-index: 0; pointer-events: none">
    <!-- the board itself: turned metal, concentric under the seat and dissolving well before
         it reaches any copy -->
    <div data-board-metal="" aria-hidden="true" style="position: absolute; left: var(--braid-cx, 74%); top: var(--braid-cy, 46%); width: calc(var(--braid-r, 150px) * 11); height: calc(var(--braid-r, 150px) * 11); transform: translate(-50%, -50%); border-radius: 50%; pointer-events: none; opacity: 0.55; background: repeating-radial-gradient(circle at 50% 50%, rgba(255,255,255,0.032) 0 1px, rgba(0,0,0,0.03) 1px 2px, transparent 2px 7px); mask-image: radial-gradient(circle closest-side, #000 0 18%, rgba(0,0,0,0.74) 38%, rgba(0,0,0,0.42) 55%, rgba(0,0,0,0.18) 71%, rgba(0,0,0,0.06) 85%, transparent 97%); -webkit-mask-image: radial-gradient(circle closest-side, #000 0 18%, rgba(0,0,0,0.74) 38%, rgba(0,0,0,0.42) 55%, rgba(0,0,0,0.18) 71%, rgba(0,0,0,0.06) 85%, transparent 97%)">
      <div style="position: absolute; inset: 0; border-radius: 50%; mix-blend-mode: overlay; background: conic-gradient(from 205deg, rgba(255,255,255,0.06) 0 4%, transparent 15% 43%, rgba(255,255,255,0.04) 51% 57%, transparent 69% 95%, rgba(255,255,255,0.06) 100%)"></div>
      <div data-ripple="" style="position: absolute; inset: 0; border-radius: 50%; background: radial-gradient(circle, transparent 0 54%, rgba(255,255,255,0.13) 65%, rgba(255,255,255,0.045) 71%, transparent 79%); mask-image: conic-gradient(from 8deg, #000 0 54deg, transparent 54deg 360deg); -webkit-mask-image: conic-gradient(from 8deg, #000 0 54deg, transparent 54deg 360deg); animation-duration: 7.4s; animation-delay: -0.6s"></div>
      <div data-ripple="" style="position: absolute; inset: 0; border-radius: 50%; background: radial-gradient(circle, transparent 0 54%, rgba(255,255,255,0.13) 65%, rgba(255,255,255,0.045) 71%, transparent 79%); mask-image: conic-gradient(from 76deg, #000 0 42deg, transparent 42deg 360deg); -webkit-mask-image: conic-gradient(from 76deg, #000 0 42deg, transparent 42deg 360deg); animation-duration: 9.1s; animation-delay: -4.2s"></div>
      <div data-ripple="" style="position: absolute; inset: 0; border-radius: 50%; background: radial-gradient(circle, transparent 0 54%, rgba(255,255,255,0.13) 65%, rgba(255,255,255,0.045) 71%, transparent 79%); mask-image: conic-gradient(from 136deg, #000 0 68deg, transparent 68deg 360deg); -webkit-mask-image: conic-gradient(from 136deg, #000 0 68deg, transparent 68deg 360deg); animation-duration: 6.3s; animation-delay: -2.1s"></div>
      <div data-ripple="" style="position: absolute; inset: 0; border-radius: 50%; background: radial-gradient(circle, transparent 0 54%, rgba(255,255,255,0.13) 65%, rgba(255,255,255,0.045) 71%, transparent 79%); mask-image: conic-gradient(from 212deg, #000 0 40deg, transparent 40deg 360deg); -webkit-mask-image: conic-gradient(from 212deg, #000 0 40deg, transparent 40deg 360deg); animation-duration: 10.4s; animation-delay: -7.8s"></div>
      <div data-ripple="" style="position: absolute; inset: 0; border-radius: 50%; background: radial-gradient(circle, transparent 0 54%, rgba(255,255,255,0.13) 65%, rgba(255,255,255,0.045) 71%, transparent 79%); mask-image: conic-gradient(from 258deg, #000 0 56deg, transparent 56deg 360deg); -webkit-mask-image: conic-gradient(from 258deg, #000 0 56deg, transparent 56deg 360deg); animation-duration: 8.2s; animation-delay: -5.5s"></div>
      <div data-ripple="" style="position: absolute; inset: 0; border-radius: 50%; background: radial-gradient(circle, transparent 0 54%, rgba(255,255,255,0.13) 65%, rgba(255,255,255,0.045) 71%, transparent 79%); mask-image: conic-gradient(from 326deg, #000 0 38deg, transparent 38deg 360deg); -webkit-mask-image: conic-gradient(from 326deg, #000 0 38deg, transparent 38deg 360deg); animation-duration: 11.1s; animation-delay: -9.4s"></div>
    </div>
    <!-- the containment well: opaque out to just inside the bezel so the board stops at the
         seat, with a soft shade that reads as depth rather than a disc -->
    <div data-seat-plate="" style="position: absolute; left: var(--braid-cx, 74%); top: var(--braid-cy, 46%); width: calc(var(--braid-r, 150px) * 3.2); height: calc(var(--braid-r, 150px) * 3.2); transform: translate(-50%, -50%); border-radius: 50%; pointer-events: none; background: radial-gradient(circle, var(--cv-bg-base) 0 76%, color-mix(in oklch, var(--cv-bg-base) 62%, transparent) 88%, transparent 100%)">
      <div style="position: absolute; inset: 0; border-radius: 50%; background: radial-gradient(circle, color-mix(in oklch, #000 40%, transparent) 0 46%, color-mix(in oklch, #000 18%, transparent) 62%, transparent 74%)"></div>
    </div>
    <warded-braid data-look="studio" data-cursor="on" style="position: absolute; inset: 0; width: 100%; height: 100%"></warded-braid>

    <!-- the seat: machined bezel the object sits inside. The braid publishes its own screen
         circle as --braid-cx/cy/r, since only it knows this camera and this frame height. -->
    <div data-seat="" style="position: absolute; left: var(--braid-cx, 74%); top: var(--braid-cy, 46%); width: calc(var(--braid-r, 150px) * 2.34); height: calc(var(--braid-r, 150px) * 2.34); transform: translate(-50%, -50%); border-radius: 50%; pointer-events: none; background: radial-gradient(circle, transparent 57%, color-mix(in oklch, var(--cv-bg-panel) 34%, transparent) 63%, color-mix(in oklch, var(--cv-bg-panel) 22%, transparent) 71%, transparent 74%)">
      <div style="position: absolute; inset: 0; border-radius: 50%; border: 1px solid var(--cv-border-hairline)"></div>
      <div data-band="inner" style="position: absolute; inset: 11%; border-radius: 50%; border: 1px solid color-mix(in oklch, var(--cv-border-hairline) 52%, transparent); mask-image: conic-gradient(from 0deg, #000 0 8deg, transparent 8deg 26deg, #000 26deg 40deg, transparent 40deg 62deg, #000 62deg 84deg, transparent 84deg 104deg, #000 104deg 128deg, transparent 128deg 146deg, #000 146deg 172deg, transparent 172deg 196deg, #000 196deg 218deg, transparent 218deg 240deg, #000 240deg 262deg, transparent 262deg 286deg, #000 286deg 308deg, transparent 308deg 332deg, #000 332deg 360deg)"></div>
      <div data-band="outer" style="position: absolute; inset: -1px; border-radius: 50%; background: conic-gradient(from 0deg, transparent 0 1.4deg, color-mix(in oklch, var(--cv-text-muted) 18%, transparent) 1.4deg 2.2deg, transparent 2.2deg 6deg); mask-image: radial-gradient(circle, transparent 84%, #000 87%, #000 96%, transparent 99%)"></div>
      <div data-grill-fan="" aria-hidden="true" style="position: absolute; left: 50%; top: 50%; width: calc(var(--braid-r, 150px) * 2.78); height: calc(var(--braid-r, 150px) * 2.78); transform: translate(-50%, -50%); border-radius: 50%; pointer-events: none; background: repeating-conic-gradient(from 0deg, rgba(212,205,236,0) 0 4.6deg, rgba(212,205,236,0.20) 4.6deg 7.4deg, rgba(212,205,236,0) 7.4deg 12deg); mask-image: radial-gradient(circle, transparent 0 84.5%, #000 85.5% 99.5%); -webkit-mask-image: radial-gradient(circle, transparent 0 84.5%, #000 85.5% 99.5%)"></div>
      <!-- the intake grill: stamped louvres in the gap between bezel edge and the first lead,
           swept 9 degrees off radial so the ring reads as a fan shroud, not a dotted rule -->
      <svg data-grill="" viewBox="-130 -130 260 260" aria-hidden="true" style="position: absolute; left: 50%; top: 50%; width: calc(var(--braid-r, 150px) * 3.04); height: calc(var(--braid-r, 150px) * 3.04); transform: translate(-50%, -50%); opacity: 0.82; pointer-events: none">
