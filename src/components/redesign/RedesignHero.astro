---
import HeroSculpture from './HeroSculpture.astro';
import DownloadCta from './DownloadCta.astro';
---
<header id="top" data-r="hero" class="landing-container hero">
  <div data-hero="" data-dl-scope="" class="hero__copy">
    <h1 data-r="headline" class="hero__headline">Stop being your agents' control plane.</h1>
    <p style="font-size: 18px; line-height: 1.6; color: var(--cv-text-secondary); max-width: 60ch; margin: 0; text-wrap: pretty">When two agents reach for the same files, one loses the work. Coven decides who waits, and keeps the record of why.</p>
    <div data-r="ctarow" style="display: flex; align-items: center; gap: 18px; margin-top: 4px">
      <DownloadCta />
      <button type="button" data-copy="npm install -g @opencoven/cli" data-action="copy" data-r="copybtn" style="font-family: 'JetBrains Mono', monospace; font-variant-ligatures: none; font-size: 12.5px; color: var(--cv-text-secondary); background: var(--cv-bg-raised); border: 1px solid var(--cv-border-hairline); border-radius: 8px; padding: 12px 14px; cursor: pointer; white-space: nowrap; box-sizing: border-box; align-self: stretch; display: inline-flex; align-items: center; gap: 0; transition: background-color 160ms cubic-bezier(0.2,0,0,1), color 160ms cubic-bezier(0.2,0,0,1)" class="rh0"><span data-copy-text="">npm i -g @opencoven/cli</span><span data-copy-label="" style="letter-spacing: 0.06em; text-transform: uppercase; font-size: 9.5px">copy</span></button>
    </div>
    <p data-dl-status="" role="status" aria-live="polite" style="display: none; font-family: 'JetBrains Mono', monospace; font-variant-ligatures: none; font-size: 11px; color: var(--cv-text-secondary); margin: 0; align-items: center; gap: 10px"></p>
    <p data-r="caveline" style="font-size: 13.5px; line-height: 1.5; color: var(--cv-text-secondary); margin: 0">Cave is the desktop app for Coven.</p>
    <p data-r="mobilenote" style="display: none; font-size: 13px; line-height: 1.5; color: var(--cv-text-muted); margin: 0">Cave is a desktop app. Copy the install line and run it on the machine your agents work on.</p>

    <!-- The three links are always present and the row height is reserved, so the hero does not
         move when /api/site-stats answers. A count is only ever added to a link, never invented:
         if the request fails the links stay as they are. -->
    <div data-r="proofrow" style="display: flex; align-items: center; gap: 4px 14px; flex-wrap: wrap; min-height: 18px; font-family: 'JetBrains Mono', monospace; font-variant-ligatures: none; font-size: 11px; line-height: 18px; color: var(--cv-text-muted)">
      <a data-proof="stars" href="https://github.com/OpenCoven" style="position: relative; display: inline-flex; align-items: center; color: var(--cv-text-secondary)" class="rh1"><i class="ph ph-github-logo" aria-hidden="true" style="font-size: 14px; line-height: 1; margin-right: 5px"></i><span style="white-space: nowrap"><span class="cv-sr">GitHub </span><span data-proof-count="" data-stars-count=""></span>stars</span><span data-stars-pop="" style="position: absolute; top: calc(100% + 9px); left: -9px; z-index: 50; width: 252px; box-sizing: border-box; display: none; flex-direction: column; gap: 2px; padding: 10px 12px 11px; text-align: left; background: var(--cv-bg-elevated); border: 1px solid var(--cv-border-hairline); border-radius: 10px; box-shadow: 0 1px 2px oklch(0.1 0.02 291 / 14%), 0 18px 44px oklch(0.1 0.02 291 / 26%); color: var(--cv-text-secondary)"><span style="font-size: 10px; letter-spacing: 0.1em; text-transform: uppercase; color: var(--cv-text-muted); padding-bottom: 5px">Across the org</span><span data-stars-rows="" style="display: flex; flex-direction: column"></span></span></a>
      <span aria-hidden="true">·</span>
      <a data-proof="downloads" href="https://github.com/OpenCoven/coven-cave/releases" style="display: inline-flex; align-items: center; color: var(--cv-text-secondary)" class="rh1"><span style="white-space: nowrap"><span class="cv-sr">Cave </span><span data-proof-count="" data-dlcount=""></span>downloads</span></a>
      <span aria-hidden="true">·</span>
      <a data-proof="discord" href="https://discord.gg/opencoven" style="display: inline-flex; align-items: center; color: var(--cv-text-secondary)" class="rh1"><i class="ph ph-discord-logo" aria-hidden="true" style="font-size: 14px; line-height: 1; margin-right: 5px"></i><span style="white-space: nowrap"><span class="cv-sr">Discord </span><span data-proof-count="" data-discord-count=""></span><span data-discord-label="">members</span></span></a>
    </div>
  </div>
  <HeroSculpture />
</header>


<!-- The live board -->
