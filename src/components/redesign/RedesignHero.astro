            <stop offset="0" stop-color="#9b93a6"></stop>
            <stop offset="0.28" stop-color="#6a6474"></stop>
            <stop offset="0.62" stop-color="#38343f"></stop>
            <stop offset="1" stop-color="#1d1b22"></stop>
          </linearGradient>
        </defs>
