---
import { quickstartProducts } from '../data/quickstart';
---

<section
  class="product-constellation"
  id="products"
  aria-labelledby="products-heading"
>
  <header class="constellation-header">
    <p class="section-kicker">Choose a surface</p>
    <h2 id="products-heading">One foundation. Five ways to work.</h2>
    <p>
      Start with the surface that matches the work in front of you. Each path
      leads to its own verifiable Quick Start.
    </p>
  </header>

  <div class="constellation-shell">
    <div class="constellation-core" aria-hidden="true">
      <strong>Coven</strong>
      <span>shared local-first runtime</span>
    </div>

    <ul data-product-constellation role="list">
      {quickstartProducts.map((product) => (
        <li>
          <a class="product-card" href={`/quickstart#${product.id}`}>
            <span class="product-trace" aria-hidden="true"></span>
            <span class="product-sigil" aria-hidden="true">{product.sigil}</span>
            <span class="product-content">
              <span class="product-heading">
                <small>{product.eyebrow}</small>
                <strong>{product.name}</strong>
              </span>
              <span class="product-summary">{product.summary}</span>
              <span class="product-best">
                <small>Best for</small>
                {product.bestFor}
              </span>
              <span class="product-meta">
                <span>{product.status}</span>
                <span>{product.platforms}</span>
              </span>
              <span class="product-cue" aria-hidden="true">Open guide →</span>
            </span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .product-constellation {
    position: relative;
    z-index: 1;
    width: min(100%, 1280px);
    margin: 0 auto;
    padding: 112px 32px;
    scroll-margin-top: 76px;
  }

  .constellation-header {
    max-width: 760px;
    margin-bottom: 64px;
  }

  .constellation-header h2 {
    max-width: 17ch;
  }

  .constellation-header > p:last-child {
    max-width: 62ch;
    color: var(--muted);
    font-size: 1rem;
    line-height: 1.7;
  }

  .constellation-core {
    display: grid;
    width: max-content;
    max-width: 100%;
    justify-items: center;
    gap: 5px;
    margin: 0 auto 32px;
    padding: 12px 18px;
    border: 1px solid var(--border-v);
    border-radius: 8px;
    background: var(--accent-wash);
    font-family: var(--mono);
  }

  .constellation-core strong {
    color: var(--white);
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .constellation-core span {
    color: var(--muted);
    font-size: 0.625rem;
    letter-spacing: 0.04em;
  }

  [data-product-constellation] {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: 16px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  [data-product-constellation] > li {
    grid-column: span 2;
    min-width: 0;
  }

  [data-product-constellation] > li:nth-child(n + 4) {
    grid-column: span 3;
  }

  .product-card {
    position: relative;
    display: grid;
    min-height: 330px;
    height: 100%;
    grid-template-columns: 44px minmax(0, 1fr);
    align-items: start;
    gap: 18px;
    padding: 26px;
    border: 1px solid var(--oc-border-subtle);
    border-radius: 12px;
    background: var(--surface);
    color: var(--white);
    text-decoration: none;
    transition:
      transform 180ms ease,
      border-color 180ms ease,
      background 180ms ease,
      box-shadow 180ms ease;
  }

  .product-trace {
    position: absolute;
    top: -33px;
    left: 50%;
    width: 1px;
    height: 32px;
    background: linear-gradient(
      to bottom,
      transparent,
      var(--accent-strong)
    );
    opacity: 0;
    pointer-events: none;
    transition: opacity 180ms ease;
  }

  .product-card:is(:hover, :focus, :focus-visible) .product-trace {
    opacity: 1;
  }

  .product-card:focus-visible {
    border-color: var(--accent-strong);
  }

  .product-sigil {
    display: grid;
    width: 44px;
    height: 44px;
    place-items: center;
    border: 1px solid var(--border-v);
    border-radius: 8px;
    background: var(--accent-wash);
    color: var(--vtext);
    font: 700 0.75rem/1 var(--mono);
  }

  .product-content {
    display: flex;
    min-width: 0;
    height: 100%;
    flex-direction: column;
  }

  .product-heading,
  .product-best {
    display: grid;
  }

  .product-heading small,
  .product-best small {
    margin-bottom: 7px;
    color: var(--vtext);
    font: 700 0.625rem/1.35 var(--mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .product-heading strong {
    color: var(--white);
    font-family: var(--font-display);
    font-size: 1.25rem;
    line-height: 1.2;
    letter-spacing: -0.02em;
  }

  .product-summary {
    margin-top: 18px;
    color: var(--muted);
    font-size: 0.875rem;
    line-height: 1.6;
  }

  .product-best {
    margin-top: 20px;
    padding-top: 18px;
    border-top: 1px solid var(--oc-border-subtle);
    color: var(--white);
    font-size: 0.8125rem;
    line-height: 1.55;
  }

  .product-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 7px;
    margin-top: auto;
    padding-top: 24px;
  }

  .product-meta span {
    padding: 5px 8px;
    border: 1px solid var(--oc-border-subtle);
    border-radius: 999px;
    background: var(--accent-wash);
    color: var(--muted);
    font: 0.625rem/1.3 var(--mono);
  }

  .product-cue {
    margin-top: 18px;
    color: var(--vtext);
    font-size: 0.75rem;
    font-weight: 700;
  }

  @media (hover: hover) and (pointer: fine) {
    .product-card {
      will-change: transform;
    }

    .product-card:hover {
      transform: translateY(-2px);
      border-color: var(--accent-strong);
      background:
        linear-gradient(var(--accent-wash), var(--accent-wash)),
        var(--surface);
      box-shadow: var(--oc-hover-glow);
    }
  }

  @media (max-width: 1000px) {
    [data-product-constellation] {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    [data-product-constellation] > li,
    [data-product-constellation] > li:nth-child(n + 4) {
      grid-column: span 1;
    }

    [data-product-constellation] > li:last-child {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 680px) {
    .product-constellation {
      padding: 80px 20px;
    }

    .constellation-core {
      justify-items: start;
      margin-inline: 0;
    }

    [data-product-constellation] {
      grid-template-columns: minmax(0, 1fr);
    }

    [data-product-constellation] > li,
    [data-product-constellation] > li:nth-child(n + 4),
    [data-product-constellation] > li:last-child {
      grid-column: span 1;
    }

    .product-card {
      min-height: 0;
    }

    .product-trace {
      display: none;
    }
  }

  @media (max-width: 400px) {
    .product-constellation {
      padding-inline: 16px;
    }
  }
</style>
