---
// Pre-paint theme resolution shared by legacy and vNext routes. Canonical vNext
// tokens read data-oc-theme; legacy styles still read data-theme during the
// incremental migration. The saved preference is constrained to system/light/dark.
---
<script is:inline>
  (function () {
    var html = document.documentElement;
    function resolve(pref) {
      if (pref === 'light' || pref === 'dark') return pref;
      return window.matchMedia && matchMedia('(prefers-color-scheme: light)').matches
        ? 'light'
        : 'dark';
    }
    try {
      var pref = localStorage.getItem('theme');
      if (pref !== 'light' && pref !== 'dark' && pref !== 'system') pref = 'system';
      var resolved = resolve(pref);
      html.dataset.ocTheme = resolved;
      html.dataset.theme = resolved;
      html.dataset.themePref = pref;
    } catch (e) {
      var resolved = resolve('system');
      html.dataset.ocTheme = resolved;
      html.dataset.theme = resolved;
      html.dataset.themePref = 'system';
    }
  })();
</script>
