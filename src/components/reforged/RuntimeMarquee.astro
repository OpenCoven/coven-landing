---
import { runtimeHarnesses } from '../../data/reforged';
---

<section class="runtime-marquee" id="runtimes" aria-labelledby="runtimes-heading">
  <div class="runtime-marquee__inner">
    <header class="runtime-marquee__heading">
      <h2 id="runtimes-heading"><span></span>the runtimes it speaks</h2>
      <p>bound to the tools you already own</p>
    </header>

    <div class="runtime-marquee__viewport">
      <div class="runtime-marquee__track" data-runtime-track>
        {runtimeHarnesses.map((harness) => (
          <button
            type="button"
            class="runtime-chip"
            data-runtime-chip={harness.id}
            data-command={harness.command}
            aria-pressed="false"
          >
            <img
              src={harness.asset}
              alt=""
              width="28"
              height="28"
              loading="lazy"
              decoding="async"
            />
            <span>{harness.name}</span>
          </button>
        ))}
      </div>
      <div class="runtime-marquee__track" data-runtime-track aria-hidden="true">
        {runtimeHarnesses.map((harness) => (
          <span class="runtime-chip runtime-chip--clone">
            <img
              src={harness.asset}
              alt=""
              width="28"
              height="28"
              loading="lazy"
              decoding="async"
            />
            <span>{harness.name}</span>
          </span>
        ))}
      </div>
    </div>

    <div
      class="runtime-command"
      data-runtime-command-panel
      data-active="false"
      data-copy-surface
    >
      <span data-runtime-name>OpenAI Codex</span>
      <code data-runtime-command>coven run codex "explain this repo"</code>
      <button
        type="button"
        data-copy-command={'coven run codex "explain this repo"'}
        aria-label="Copy OpenAI Codex command"
      >
        copy
      </button>
      <p data-copy-guidance hidden></p>
    </div>

    <ul class="runtime-command-list" aria-label="Supported runtime commands">
      {runtimeHarnesses.map((harness) => (
        <li>
          <span>{harness.name}</span>
          <code data-runtime-fallback-command>{harness.command}</code>
        </li>
      ))}
    </ul>
  </div>
</section>
