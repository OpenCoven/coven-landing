---
const DOWNLOAD_MAC = '/download/mac';
const TESTFLIGHT_URL = 'https://testflight.apple.com/join/61Dqw8y4';
// Origin of the CORS streaming proxy (workers/download-proxy). When set,
// the primary card streams the installer with in-button progress; when
// empty, clicks resolve through /download/:platform as plain navigation.
const STREAM_ORIGIN = import.meta.env.PUBLIC_DOWNLOAD_STREAM_ORIGIN ?? '';
---

<section class="reforged-hero" id="top" aria-labelledby="hero-heading">
  <div class="hero-card">
    <p class="hero-kicker">
      <span><i aria-hidden="true"></i>public beta</span>
      <b aria-hidden="true">/</b>
      free · open source · local-first
    </p>

    <h1 id="hero-heading">
      Summon once.<br />
      <em>Remember forever.</em>
    </h1>

    <p class="hero-lede">
      A familiar is an AI agent with a memory, bound to your project. Close the
      terminal and the context, conventions, and unfinished work stay.
    </p>

    <div
      class="hero-downloads"
      data-download-cta
      data-stream-origin={STREAM_ORIGIN}
    >
      <a
        class="download-card download-card--primary"
        href={DOWNLOAD_MAC}
        data-download-primary
        data-platform="mac"
        data-state="idle"
      >
        <svg class="download-card__glyph" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M12 3v11"></path>
          <path d="m7 10 5 5 5-5"></path>
          <path d="M4.5 19.5h15"></path>
        </svg>
        <svg class="download-card__check" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="m4.5 12.5 5 5 10-11"></path>
        </svg>
        <span>
          <strong data-download-label>Download for macOS</strong>
          <small data-download-sub>CovenCave · .dmg · signed · free</small>
        </span>
      </a>
      <a
        class="download-card"
        href={TESTFLIGHT_URL}
        target="_blank"
        rel="noopener noreferrer"
        data-download-ios
      >
        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M17.05 20.28c-.98.95-2.05.8-3.08.35-1.09-.46-2.09-.48-3.24 0-1.44.62-2.2.44-3.06-.35C2.79 15.25 3.51 7.59 9.05 7.31c1.35.07 2.29.74 3.08.8 1.18-.24 2.31-.93 3.57-.84 1.51.12 2.65.72 3.4 1.8-3.12 1.87-2.38 5.98.48 7.13-.57 1.5-1.31 2.99-2.53 4.08ZM12.03 7.25c-.15-2.23 1.66-4.07 3.74-4.25.29 2.58-2.34 4.5-3.74 4.25Z"></path>
        </svg>
        <span>
          <strong>Download for iOS</strong>
          <small>CovenCave · TestFlight · iPhone/iPad</small>
        </span>
      </a>
      <span class="download-live" data-download-live aria-live="polite"></span>
    </div>

    <div class="hero-links">
      <a href="https://discord.gg/opencoven" target="_blank" rel="noopener noreferrer">Join Discord</a>
      <a href="https://docs.opencoven.ai" target="_blank" rel="noopener noreferrer">Read the docs <span aria-hidden="true">↗</span></a>
    </div>
  </div>

  <div class="hero-portal" aria-label="Watch the Coven Cave explainer">
    <a
      href="/reforged/coven-cave-explainer.mp4"
      aria-label="Watch the Coven Cave explainer"
    >
      <span class="hero-portal__halo" aria-hidden="true"></span>
      <span class="hero-portal__core" aria-hidden="true"></span>
      <span class="hero-portal__label">
        <i aria-hidden="true">▶</i>
        watch the summoning
      </span>
    </a>
  </div>
</section>
