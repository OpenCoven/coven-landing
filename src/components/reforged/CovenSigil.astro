---
type Props = {
  small?: boolean;
};

const { small = false } = Astro.props;
---

<svg
  class:list={['coven-sigil', { 'coven-sigil--small': small }]}
  viewBox="0 0 24 34"
  aria-hidden="true"
>
  <defs>
    <linearGradient id={small ? 'sigil-small-a' : 'sigil-a'} x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#C4B9F0" stop-opacity=".55"></stop>
      <stop offset="1" stop-color="#6D5BAF" stop-opacity=".7"></stop>
    </linearGradient>
    <linearGradient id={small ? 'sigil-small-b' : 'sigil-b'} x1="1" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#7A6FB3" stop-opacity=".75"></stop>
      <stop offset="1" stop-color="#191622" stop-opacity=".9"></stop>
    </linearGradient>
  </defs>
  <polygon points="2,11 12,14 12,30 2,23" fill={`url(#${small ? 'sigil-small-a' : 'sigil-a'})`}></polygon>
  <polygon points="22,11 12,14 12,30 22,23" fill={`url(#${small ? 'sigil-small-b' : 'sigil-b'})`}></polygon>
  <polygon points="2,11 12,1 12,14" fill="#C4B9F0" fill-opacity=".42"></polygon>
  <polygon points="22,11 12,1 12,14" fill="#7A6FB3" fill-opacity=".55"></polygon>
  <polygon points="2,23 12,33 12,30" fill="#B4AAEB" fill-opacity=".3"></polygon>
  <polygon points="22,23 12,33 12,30" fill="#55409B" fill-opacity=".6"></polygon>
  <path
    d="M12 1 2 11v12l10 10 10-10V11L12 1ZM2 11l10 3 10-3M12 14v16M2 23l10 7 10-7"
    fill="none"
    stroke="#E8E0F0"
    stroke-opacity=".55"
    stroke-width=".8"
    stroke-linejoin="round"
  ></path>
</svg>
