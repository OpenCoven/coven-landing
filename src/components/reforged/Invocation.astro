---
import { invocationSteps } from '../../data/reforged';

const firstStep = invocationSteps[0];
---

<section
  class="chapter chapter--invocation"
  id="invocation"
  aria-labelledby="invocation-heading"
  data-invocation
>
  <div class="chapter__sticky">
    <div class="chapter-panel">
      <header class="chapter-heading">
        <p>
          <span>III</span>
          the invocation
          <small>~2 minutes · no account</small>
        </p>
        <div>
          <h2 id="invocation-heading">Three commands to first summon.</h2>
          <p>
            Nothing to sign up for. Install the runtime, let it read your
            project, then bind a familiar to it — each step runs as you scroll.
          </p>
        </div>
      </header>

      <ol class="invocation-steps">
        {invocationSteps.map((step, index) => (
          <li data-copy-surface>
            <button
              type="button"
              data-invocation-step={step.id}
              data-command={step.command}
              data-label={`${step.index} · ${step.label}`}
              data-output={JSON.stringify(step.output)}
              aria-pressed={index === 0 ? 'true' : 'false'}
            >
              <span><i>{step.index}</i><small>{step.label}</small><em>{index === 0 ? 'running' : 'run'}</em></span>
              <strong>{step.title}</strong>
              <code>$ {step.command}</code>
            </button>
            <button
              type="button"
              class="invocation-step__copy"
              data-copy-command={step.command}
              aria-label={`Copy ${step.label.toLowerCase()} command`}
            >copy</button>
            <p data-copy-guidance hidden></p>
            <div
              class="invocation-step__output-fallback"
              data-invocation-output-fallback
              aria-label={`${step.label} expected output`}
            >
              {step.output.map((line) => (
                <p data-tone={line.tone ?? 'default'}>{line.text}</p>
              ))}
            </div>
          </li>
        ))}
      </ol>

      <div class="invocation-terminal" data-copy-surface>
        <header>
          <span><i></i><i></i><i></i></span>
          coven — zsh
          <b data-terminal-label>{firstStep.index} · {firstStep.label}</b>
          <button
            type="button"
            data-copy-command={firstStep.command}
            aria-label="Copy active command"
          >copy</button>
        </header>
        <div>
          <p><span>❯</span><code data-terminal-command>{firstStep.command}</code><i></i></p>
          <div data-terminal-output>
            {firstStep.output.map((line) => (
              <p data-tone={line.tone ?? 'default'}>{line.text}</p>
            ))}
          </div>
        </div>
        <p data-copy-guidance hidden></p>
      </div>

      <div class="invocation-next">
        <p>After the third command the familiar is yours — pick a surface and its guide carries you the rest of the way.</p>
        <div>
          <a href="#surfaces">Choose any product →</a>
          <a href="https://docs.opencoven.ai" target="_blank" rel="noopener noreferrer">Read the full docs ↗</a>
        </div>
      </div>
    </div>
  </div>
</section>
