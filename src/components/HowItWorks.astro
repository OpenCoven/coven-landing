---
// Tabbed deep-dives that replace the old Familiars + Runtime sections.
// Four tabs (Memory / Sessions / Harnesses / Tools), each with descriptive
// copy plus a small interactive widget on the right.

const tabs = [
  { id: 'memory',    label: 'Memory'    },
  { id: 'sessions',  label: 'Sessions'  },
  { id: 'harnesses', label: 'Harnesses' },
  { id: 'tools',     label: 'Tools'     },
];

// Memory widget data — notes accumulating across three sessions
const memoryTimeline = [
  {
    session: 'Session 1',
    when: 'Mon · v0.1 spike',
    notes: [
      { text: 'project: opencoven · stack: astro + vanilla',     meta: 'context' },
    ],
  },
  {
    session: 'Session 2',
    when: 'Wed · feature work',
    notes: [
      { text: 'project: opencoven · stack: astro + vanilla',     meta: 'context' },
      { text: 'prefers terse PR summaries · no trailing recap',  meta: 'preference' },
    ],
  },
  {
    session: 'Session 3',
    when: 'Fri · today',
    notes: [
      { text: 'project: opencoven · stack: astro + vanilla',     meta: 'context' },
      { text: 'prefers terse PR summaries · no trailing recap',  meta: 'preference' },
      { text: 'resumed feat/interactive-deep-dive · 4 files staged', meta: 'state' },
    ],
  },
];

// Sessions widget data
const sessionsData = [
  { id: 's-1', project: 'opencoven',       harness: 'claude',  status: 'running',  age: '2m'  },
  { id: 's-2', project: 'open-meow',       harness: 'codex',   status: 'idle',     age: '38m' },
  { id: 's-3', project: 'coven-dash',      harness: 'claude',  status: 'idle',     age: '4h'  },
  { id: 's-4', project: 'castcodes',       harness: 'codex',   status: 'archived', age: '2d'  },
];

// Harness widget data
const harnessRows = [
  { id: 'claude', name: 'Claude Code', vendor: 'Anthropic', logo: '/logos/anthropic.svg', detail: "Anthropic's official CLI. Streamed output, tool-use protocol, long-context first.", status: 'active',   meta: 'in use · 12 sessions' },
  { id: 'codex',  name: 'Codex',       vendor: 'OpenAI',    logo: '/logos/openai.svg',    detail: 'OpenAI coding agent. Inline edits, project-scoped runs, sandboxed tool calls.',     status: 'idle',     meta: 'last used 2h ago'      },
  { id: 'future', name: '+ Future',    vendor: null,        logo: null,                   detail: 'New agent CLIs join by implementing one adapter contract — no rewriting Coven.',    status: 'adapter', meta: 'open spec'             },
];

// Tools widget data — categories + their gate contract
const toolGates = [
  { id: 'fs',    label: 'fs',        title: 'Filesystem',        rule: 'Reads + writes scoped to the project directory. Out-of-tree paths require an explicit grant.' },
  { id: 'git',   label: 'git',       title: 'Git',               rule: 'Branches, commits, history. No force-push, no history rewrite without an explicit confirmation.' },
  { id: 'exec',  label: 'exec',      title: 'Shell execution',   rule: 'Commands run inside a managed PTY. The session captures stdout/stderr and the exit code.' },
  { id: 'fetch', label: 'web',       title: 'Web fetch',         rule: 'Outbound HTTP gated per-domain. Responses streamed back through the session log.' },
];
---

<section class="howitworks-section content-section" id="how-it-works" aria-labelledby="how-it-works-heading">
  <div class="section-header" data-reveal>
    <p class="section-kicker">How It Works</p>
    <h2 id="how-it-works-heading">Pick a layer. See what it actually does.</h2>
    <p>Memory, sessions, harnesses, and tools are the four moving parts. Each tab is a working preview of how that piece behaves in a real Coven session.</p>
  </div>

  <div class="howit-frame panel" data-reveal>
    <div class="howit-railbar" aria-hidden="true">
      <span class="howit-dots"><span></span><span></span><span></span></span>
      <span class="howit-rail-label">coven · runtime</span>
      <span class="howit-rail-status">local</span>
    </div>
    <div class="howit-tabs" role="tablist" aria-label="Coven moving parts">
      {tabs.map((t, i) => (
        <button
          class={`howit-tab${i === 0 ? ' is-active' : ''}`}
          role="tab"
          type="button"
          data-tab={t.id}
          aria-selected={i === 0 ? 'true' : 'false'}
          aria-controls={`howit-panel-${t.id}`}
          id={`howit-tab-${t.id}`}
          tabindex={i === 0 ? '0' : '-1'}
        >{t.label}</button>
      ))}
    </div>

    <div class="howit-stage">
    <!-- Memory panel -->
    <div
      class="howit-panel is-active"
      role="tabpanel"
      id="howit-panel-memory"
      aria-labelledby="howit-tab-memory"
      data-panel="memory"
    >
      <div class="howit-copy">
        <p class="card-kicker">Memory</p>
        <h3>Continuity that survives the chat window.</h3>
        <p>Project context, decisions, and preferences accumulate per familiar across sessions. Step through the timeline on the right to see how a familiar's working memory grows from one session to the next.</p>
      </div>
      <div class="howit-widget memory-widget">
        <div class="memory-scrubber" role="radiogroup" aria-label="Session in the timeline">
          {memoryTimeline.map((s, i) => (
            <button
              class={`memory-step${i === memoryTimeline.length - 1 ? ' is-active' : ''}`}
              type="button"
              role="radio"
              data-memory-step={i}
              aria-checked={i === memoryTimeline.length - 1 ? 'true' : 'false'}
            >
              <span class="memory-step-num">{String(i + 1).padStart(2, '0')}</span>
              <span class="memory-step-label">{s.session}</span>
              <span class="memory-step-when">{s.when}</span>
            </button>
          ))}
        </div>
        <div class="memory-board swap-fade" aria-live="polite">
          {memoryTimeline[memoryTimeline.length - 1].notes.map((n) => (
            <div class="memory-note-row">
              <span class="memory-note-tag">{n.meta}</span>
              <span class="memory-note-text">{n.text}</span>
            </div>
          ))}
        </div>
      </div>
    </div>

    <!-- Sessions panel -->
    <div
      class="howit-panel"
      role="tabpanel"
      id="howit-panel-sessions"
      aria-labelledby="howit-tab-sessions"
      data-panel="sessions"
      hidden
    >
      <div class="howit-copy">
        <p class="card-kicker">Sessions</p>
        <h3>Project-scoped, lifecycle-aware, replayable.</h3>
        <p>Each harness run is a session record bound to a directory and a familiar. Filter the list on the right to see how Coven tracks running, idle, and archived work — all visible, never abandoned.</p>
      </div>
      <div class="howit-widget sessions-widget">
        <div class="sessions-filters" role="group" aria-label="Filter sessions by status">
          <button class="sessions-filter is-active" type="button" data-filter="all"      aria-pressed="true">All</button>
          <button class="sessions-filter"           type="button" data-filter="running"  aria-pressed="false">Running</button>
          <button class="sessions-filter"           type="button" data-filter="idle"     aria-pressed="false">Idle</button>
          <button class="sessions-filter"           type="button" data-filter="archived" aria-pressed="false">Archived</button>
        </div>
        <div class="sessions-results" aria-live="polite">
        <ul class="sessions-list">
          {sessionsData.map((s) => (
            <li class="sessions-row" data-status={s.status}>
              <span class={`sessions-dot status-${s.status}`} aria-hidden="true"></span>
              <span class="sessions-project">{s.project}</span>
              <span class="sessions-harness">{s.harness}</span>
              <span class={`sessions-status status-${s.status}`}>{s.status}</span>
              <span class="sessions-age">{s.age}</span>
            </li>
          ))}
        </ul>
        <p class="sessions-empty" hidden>No sessions match this filter.</p>
        </div>
      </div>
    </div>

    <!-- Harnesses panel -->
    <div
      class="howit-panel"
      role="tabpanel"
      id="howit-panel-harnesses"
      aria-labelledby="howit-tab-harnesses"
      data-panel="harnesses"
      hidden
    >
      <div class="howit-copy">
        <p class="card-kicker">Harnesses</p>
        <h3>One adapter contract. Many agent CLIs.</h3>
        <p>Codex, Claude Code, and any future harness plug in through the same neutral interface. Click a harness on the right to see how it shows up inside the runtime.</p>
      </div>
      <div class="howit-widget harnesses-widget">
        <ul class="harness-list" role="radiogroup" aria-label="Supported harness">
          {harnessRows.map((h, i) => (
            <li>
              <button
                class={`harness-row${i === 0 ? ' is-active' : ''}`}
                type="button"
                role="radio"
                data-harness={h.id}
                aria-checked={i === 0 ? 'true' : 'false'}
              >
                <span class="harness-logo" aria-hidden="true">
                  {h.logo ? (
                    <img src={h.logo} alt="" width="22" height="22" />
                  ) : (
                    <span class="harness-logo-placeholder">+</span>
                  )}
                </span>
                <span class="harness-name">
                  {h.name}
                  {h.vendor && <span class="harness-vendor">{h.vendor}</span>}
                </span>
                <span class={`harness-status status-${h.status}`}>{h.status}</span>
                <span class="harness-meta">{h.meta}</span>
              </button>
            </li>
          ))}
        </ul>
        <div class="harness-detail swap-fade" aria-live="polite">
          <p class="harness-detail-tag">contract</p>
          <p class="harness-detail-text">{harnessRows[0].detail}</p>
        </div>
      </div>
    </div>

    <!-- Tools panel -->
    <div
      class="howit-panel"
      role="tabpanel"
      id="howit-panel-tools"
      aria-labelledby="howit-tab-tools"
      data-panel="tools"
      hidden
    >
      <div class="howit-copy">
        <p class="card-kicker">Tools</p>
        <h3>Every tool call passes through an inspectable gate.</h3>
        <p>The tool gateway mediates filesystem, git, shell, and web access. Pick a tool category to see the contract Coven enforces before that tool ever runs.</p>
      </div>
      <div class="howit-widget tools-widget">
        <div class="tool-pills" role="radiogroup" aria-label="Tool category">
          {toolGates.map((t, i) => (
            <button
              class={`tool-pill${i === 0 ? ' is-active' : ''}`}
              type="button"
              role="radio"
              data-tool={t.id}
              aria-checked={i === 0 ? 'true' : 'false'}
            >{t.label}</button>
          ))}
        </div>
        <div class="tool-flow">
          <div class="tool-flow-step">request</div>
          <div class="tool-flow-arrow" aria-hidden="true">→</div>
          <div class="tool-flow-step tool-flow-gate">gate</div>
          <div class="tool-flow-arrow" aria-hidden="true">→</div>
          <div class="tool-flow-step">execute</div>
          <div class="tool-flow-arrow" aria-hidden="true">→</div>
          <div class="tool-flow-step">result</div>
        </div>
        <div class="tool-rule swap-fade" aria-live="polite">
          <p class="tool-rule-title">{toolGates[0].title}</p>
          <p class="tool-rule-text">{toolGates[0].rule}</p>
        </div>
      </div>
    </div>
    </div>
  </div>
</section>

<script is:inline define:vars={{ memoryTimeline, harnessRows, toolGates }}>
  window.__HOWIT__ = { memoryTimeline, harnessRows, toolGates };
</script>

<script>
  import { fadeSwap, wireRadioGroup } from '../scripts/shared.js';

  (function () {
    const root = document.querySelector('.howitworks-section');
    if (!root) return;

    // ── Tab switching ────────────────────────────────────────
    const tabs = root.querySelectorAll('.howit-tab');
    const panels = root.querySelectorAll('.howit-panel');

    function activateTab(id) {
      tabs.forEach((t) => {
        const match = t.getAttribute('data-tab') === id;
        t.classList.toggle('is-active', match);
        t.setAttribute('aria-selected', match ? 'true' : 'false');
        t.setAttribute('tabindex', match ? '0' : '-1');
      });
      panels.forEach((p) => {
        const match = p.getAttribute('data-panel') === id;
        p.classList.toggle('is-active', match);
        if (match) p.removeAttribute('hidden');
        else p.setAttribute('hidden', '');
      });
    }
    tabs.forEach((t) => {
      t.addEventListener('click', () => activateTab(t.getAttribute('data-tab')));
      t.addEventListener('keydown', (e) => {
        const order = Array.from(tabs);
        const i = order.indexOf(t);
        if (e.key === 'ArrowRight' || e.key === 'ArrowDown') {
          e.preventDefault();
          const next = order[(i + 1) % order.length];
          next.focus();
          activateTab(next.getAttribute('data-tab'));
        } else if (e.key === 'ArrowLeft' || e.key === 'ArrowUp') {
          e.preventDefault();
          const prev = order[(i - 1 + order.length) % order.length];
          prev.focus();
          activateTab(prev.getAttribute('data-tab'));
        }
      });
    });

    // ── Memory scrubber ──────────────────────────────────────
    const memoryTimeline = window.__HOWIT__?.memoryTimeline || [];
    const memoryButtons = root.querySelectorAll('[data-memory-step]');
    const memoryBoard = root.querySelector('.memory-board');
    function paintMemory(stepIdx) {
      const data = memoryTimeline[stepIdx];
      if (!data || !memoryBoard) return;
      // Crossfade the board while rebuilding rows via DOM construction
      // (safe vs. arbitrary text in notes).
      fadeSwap(memoryBoard, () => {
        memoryBoard.replaceChildren();
        data.notes.forEach((n) => {
          const row = document.createElement('div');
          row.className = 'memory-note-row';
          const tag = document.createElement('span');
          tag.className = 'memory-note-tag';
          tag.textContent = n.meta;
          const text = document.createElement('span');
          text.className = 'memory-note-text';
          text.textContent = n.text;
          row.append(tag, text);
          memoryBoard.appendChild(row);
        });
      });
      memoryButtons.forEach((b) => {
        const match = Number(b.getAttribute('data-memory-step')) === stepIdx;
        b.classList.toggle('is-active', match);
        b.setAttribute('aria-checked', match ? 'true' : 'false');
      });
    }
    wireRadioGroup(memoryButtons, 'aria-checked', (b) => {
      paintMemory(Number(b.getAttribute('data-memory-step')));
    });

    // ── Sessions filter (hide non-matches, announce empty state) ──
    const filters = root.querySelectorAll('.sessions-filter');
    const rows = root.querySelectorAll('.sessions-row');
    const emptyMsg = root.querySelector('.sessions-empty');
    filters.forEach((f) => {
      f.addEventListener('click', () => {
        const filter = f.getAttribute('data-filter');
        filters.forEach((other) => {
          const match = other === f;
          other.classList.toggle('is-active', match);
          other.setAttribute('aria-pressed', match ? 'true' : 'false');
        });
        let visible = 0;
        rows.forEach((r) => {
          const match = filter === 'all' || r.getAttribute('data-status') === filter;
          r.hidden = !match;
          if (match) visible += 1;
        });
        if (emptyMsg) emptyMsg.hidden = visible !== 0;
      });
    });

    // ── Harnesses selector ──────────────────────────────────
    const harnessData = window.__HOWIT__?.harnessRows || [];
    const harnessButtons = root.querySelectorAll('[data-harness]');
    const harnessDetail = root.querySelector('.harness-detail-text');
    const harnessDetailBox = root.querySelector('.harness-detail');
    function selectHarness(b) {
      const id = b.getAttribute('data-harness');
      const data = harnessData.find((h) => h.id === id);
      if (!data) return;
      fadeSwap(harnessDetailBox, () => { if (harnessDetail) harnessDetail.textContent = data.detail; });
      harnessButtons.forEach((other) => {
        const match = other === b;
        other.classList.toggle('is-active', match);
        other.setAttribute('aria-checked', match ? 'true' : 'false');
      });
    }
    wireRadioGroup(harnessButtons, 'aria-checked', selectHarness);

    // ── Tools picker ────────────────────────────────────────
    const toolData = window.__HOWIT__?.toolGates || [];
    const toolButtons = root.querySelectorAll('[data-tool]');
    const toolTitle = root.querySelector('.tool-rule-title');
    const toolText = root.querySelector('.tool-rule-text');
    const toolRuleBox = root.querySelector('.tool-rule');
    function selectTool(b) {
      const id = b.getAttribute('data-tool');
      const data = toolData.find((t) => t.id === id);
      if (!data) return;
      fadeSwap(toolRuleBox, () => {
        if (toolTitle) toolTitle.textContent = data.title;
        if (toolText)  toolText.textContent  = data.rule;
      });
      toolButtons.forEach((other) => {
        const match = other === b;
        other.classList.toggle('is-active', match);
        other.setAttribute('aria-checked', match ? 'true' : 'false');
      });
    }
    wireRadioGroup(toolButtons, 'aria-checked', selectTool);
  })();
</script>

<style>
  /* Frame surface comes from the shared .panel; here we add the console
     topbar rail (echoes the hero card top bar). */
  .howit-railbar {
    display: flex; align-items: center; gap: 10px;
    padding: 10px 16px;
    border-bottom: 1px solid rgba(154,142,205,0.12);
    background: rgba(5,4,9,0.55);
  }
  .howit-dots { display: inline-flex; gap: 6px; }
  .howit-dots span {
    width: 10px; height: 10px; border-radius: 50%;
    background: rgba(255,255,255,0.08);
    border: 1px solid rgba(255,255,255,0.12);
  }
  .howit-rail-label {
    font-family: var(--mono); font-size: 9px; font-weight: 700;
    letter-spacing: 0.14em; text-transform: uppercase;
    color: rgba(180,170,235,0.5);
  }
  .howit-rail-status {
    margin-left: auto;
    display: inline-flex; align-items: center; gap: 6px;
    font-family: var(--mono); font-size: 9px; letter-spacing: 0.08em;
    text-transform: uppercase; color: rgba(255,255,255,0.3);
  }
  .howit-rail-status::before {
    content: ''; width: 6px; height: 6px; border-radius: 50%;
    background: var(--green); box-shadow: 0 0 6px rgba(48,209,88,0.5);
  }
  .howit-tabs {
    display: flex;
    gap: 4px;
    padding: 8px;
    border-bottom: 1px solid rgba(154,142,205,0.12);
    background: rgba(5,4,9,0.6);
  }
  .howit-tab {
    flex: 1;
    background: transparent;
    border: 1px solid transparent;
    color: var(--muted);
    font-family: var(--mono);
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    padding: 9px 14px;
    border-radius: 6px;
    cursor: pointer;
    outline: none;
    transition: color 0.18s ease, background 0.18s ease, border-color 0.18s ease;
  }
  .howit-tab:hover { color: var(--white); }
  .howit-tab.is-active {
    background: var(--accent-active);
    color: #fff;
    border-color: var(--accent-strong);
  }

  /* Stage: min-height locked so switching tabs never reflows the page. */
  .howit-stage { min-height: 336px; }
  .howit-panel {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    gap: 28px;
    padding: 32px;
  }
  .howit-panel[hidden] { display: none; }
  /* Crossfade the incoming panel (presentational only; gated on motion). */
  .motion-on .howit-panel.is-active { animation: howit-fade-in 0.3s var(--ease-out); }
  @keyframes howit-fade-in {
    from { opacity: 0; transform: translateY(6px); }
    to   { opacity: 1; transform: none; }
  }

  .howit-copy h3 {
    font-size: 1.375rem;
    font-weight: 700;
    color: var(--white);
    margin: 10px 0 12px;
    letter-spacing: -0.01em;
    line-height: 1.25;
  }
  .howit-copy p {
    font-size: 0.8438rem;
    line-height: 1.7;
    color: var(--muted);
  }

  .howit-widget {
    background: rgba(5,4,9,0.5);
    border: 1px solid rgba(154,142,205,0.14);
    border-radius: 8px;
    padding: 18px;
    display: flex;
    flex-direction: column;
    gap: 14px;
    min-height: 220px;
  }

  /* ── Memory widget ─────────────────────────────────────── */
  .memory-scrubber {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 6px;
  }
  .memory-step {
    background: transparent;
    border: 1px solid rgba(154,142,205,0.16);
    border-radius: 6px;
    padding: 8px 10px;
    color: var(--muted);
    text-align: left;
    cursor: pointer;
    display: flex;
    flex-direction: column;
    gap: 2px;
    transition: background 0.18s ease, border-color 0.18s ease, color 0.18s ease;
    outline: none;
  }
  .memory-step:hover { background: rgba(154,142,205,0.06); color: var(--white); }
  .memory-step.is-active {
    background: rgba(154,142,205,0.18);
    border-color: rgba(180,170,235,0.5);
    color: #fff;
  }
  .memory-step-num {
    font-family: var(--mono);
    font-size: 0.5625rem;
    letter-spacing: 0.14em;
    color: rgba(180,170,235,0.55);
  }
  .memory-step-label {
    font-size: 0.75rem;
    font-weight: 600;
  }
  .memory-step-when {
    font-family: var(--mono);
    font-size: 0.5938rem;
    color: rgba(255,255,255,0.35);
    letter-spacing: 0.04em;
  }
  .memory-board {
    display: flex;
    flex-direction: column;
    gap: 8px;
    font-family: var(--mono);
    font-size: 0.7188rem;
    color: rgba(232,224,240,0.7);
    padding-top: 4px;
  }
  .memory-note-row {
    display: flex;
    align-items: baseline;
    gap: 10px;
    padding: 6px 0;
    border-top: 1px solid rgba(255,255,255,0.05);
  }
  .memory-note-row:first-child { border-top: none; }
  .memory-note-tag {
    font-size: 0.5625rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgba(180,170,235,0.55);
    flex-shrink: 0;
    width: 60px;
  }
  .memory-note-text { flex: 1; }

  /* ── Sessions widget ─────────────────────────────────────── */
  .sessions-filters {
    display: flex;
    gap: 4px;
    flex-wrap: wrap;
  }
  .sessions-filter {
    background: transparent;
    border: 1px solid rgba(154,142,205,0.16);
    color: var(--muted);
    font-family: var(--mono);
    font-size: 0.625rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding: 5px 11px;
    border-radius: 4px;
    cursor: pointer;
    outline: none;
    transition: background 0.18s ease, color 0.18s ease, border-color 0.18s ease;
  }
  .sessions-filter:hover { color: var(--white); }
  .sessions-filter.is-active {
    background: rgba(154,142,205,0.18);
    border-color: rgba(180,170,235,0.5);
    color: #fff;
  }
  .sessions-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .sessions-row {
    display: grid;
    grid-template-columns: 10px minmax(0, 1.4fr) minmax(0, 1fr) auto auto;
    gap: 12px;
    align-items: center;
    padding: 8px 12px;
    border-radius: 6px;
