---
const COPY_ICON_SVG = `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 01-2-2V4a2 2 0 012-2h9a2 2 0 012 2v1"/></svg>`;

const steps = [
  {
    kicker: '01 · Install',
    command: 'npm install -g @opencoven/cli',
    body: 'Installs the Coven CLI through npm so the coven command is available on your PATH.',
  },
  {
    kicker: '02 · Verify',
    command: 'coven doctor',
    body: 'Checks your environment and detects supported harnesses — Codex, Claude Code, and more.',
  },
  {
    kicker: '03 · Start a session',
    command: 'coven run claude "fix the failing tests"',
    body: "Launches a project-scoped session through Coven's managed PTY, bound to the current working directory.",
  },
];
---
<section class="content-section" id="quickstart" aria-labelledby="quickstart-heading">
  <div class="section-header" data-reveal>
    <p class="section-kicker">Quick Start</p>
    <h2 id="quickstart-heading">Run your first familiar in three commands.</h2>
    <p>Coven runs locally inside the projects you already have. Install, verify, and start — memory persists across every session.</p>
  </div>
  <div class="card-grid three">
    {steps.map((step) => (
      <div class="glass-card qs-step" data-reveal>
        <p class="card-kicker">{step.kicker}</p>
        <div class="qs-codeblock">
          <code>{step.command}</code>
          <button class="qs-copy" type="button" aria-label="Copy command" data-copy={step.command}>
            <Fragment set:html={COPY_ICON_SVG} />
          </button>
        </div>
        <p>{step.body}</p>
      </div>
    ))}
  </div>
  <div class="qs-actions" data-reveal>
    <a class="btn-primary" href="https://docs.opencoven.ai">Read the full docs</a>
    <a class="btn-secondary" href="https://github.com/OpenCoven/coven">View on GitHub ↗</a>
  </div>
</section>
