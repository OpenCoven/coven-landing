---
const COPY_ICON_SVG = `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 01-2-2V4a2 2 0 012-2h9a2 2 0 012 2v1"/></svg>`;

// Each step drives both the copied plaintext (`command`) and the coloured
// display (`tokens`). Keep the two in sync — the reconstructed token text
// must equal `command`. `out` is the expected-output hint (what success
// looks like); the last step lights up as "you're running now".
const steps = [
  {
    kicker: 'Step 1 · Install',
    title: 'Add the Coven CLI',
    command: 'npm install -g @opencoven/cli',
    tokens: [
      { t: 'npm', c: 'bin' },
      { t: 'install', c: 'sub' },
      { t: '-g', c: 'flag' },
      { t: '@opencoven/cli', c: 'pkg' },
    ],
    out: '✓ coven is available on PATH',
    note: 'Installs the coven command globally through npm.',
    copyLabel: 'Copy install command',
  },
  {
    kicker: 'Step 2 · Prepare',
    title: 'Run the guided preflight',
    command: 'coven doctor',
    tokens: [
      { t: 'coven', c: 'bin' },
      { t: 'doctor', c: 'sub' },
    ],
    out: '✓ project and at least one harness ready',
    note: "Follow doctor's exact Codex or Claude Code install/auth next step. This compact preview uses Codex; the full product guide includes the Claude run.",
    copyLabel: 'Copy preflight command',
  },
  {
    kicker: 'Step 3 · Run',
    title: 'Create your first recorded session',
    command: 'coven run codex "explain this repo in 5 bullets"',
    tokens: [
      { t: 'coven', c: 'bin' },
      { t: 'run', c: 'sub' },
      { t: 'codex', c: 'arg' },
      { t: '"explain this repo in 5 bullets"', c: 'str' },
    ],
    out: '✓ session created · output attached · history recorded',
    note: 'Creates a recorded session with attached output and durable history.',
    copyLabel: 'Copy run command',
    now: true,
  },
];
---
<section class="content-section qs-section" id="quickstart" aria-labelledby="quickstart-heading">
  <div class="section-header" data-reveal>
    <p class="section-kicker">Quick Start</p>
    <h2 id="quickstart-heading">Run your first familiar in three commands.</h2>
    <p>Coven runs locally inside the projects you already have. Install, verify, and summon — memory persists across every session.</p>
  </div>

  <ol class="qs-steps reveal-stagger">
    {steps.map((step, i) => (
      <li class:list={["qs-step", { "is-now": step.now }]} data-reveal>
        <div class="qs-rail" aria-hidden="true">
          <span class="qs-node">{i + 1}</span>
        </div>
        <div class="qs-body glass-card">
          <p class="qs-step-kicker">{step.kicker}</p>
          <h3 class="qs-step-title">{step.title}</h3>
          <div class="qs-codeblock">
            <code>{step.tokens.map((tok, j) => (
              <span class={`qs-tok qs-tok-${tok.c}`}>{j > 0 ? ' ' : ''}{tok.t}</span>
            ))}</code>
            <button class="qs-copy" type="button" aria-label={step.copyLabel} data-copy={step.command}>
              <Fragment set:html={COPY_ICON_SVG} />
            </button>
          </div>
          <p class="qs-out">
            <span class="qs-out-label">expect</span>
            <span class="qs-out-text">{step.out}</span>
          </p>
          <p class="qs-note">{step.note}</p>
        </div>
      </li>
    ))}
  </ol>

  <div class="qs-actions" data-reveal>
    <a class="btn-primary" href="/quickstart">Choose any product</a>
    <a class="btn-secondary" href="https://docs.opencoven.ai">Read the full docs</a>
  </div>

  <!-- Announces copy success to screen readers (written by main.js) -->
  <div class="sr-only" role="status" aria-live="polite" data-copy-live></div>
</section>
