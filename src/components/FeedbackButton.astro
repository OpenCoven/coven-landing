---
// Floating launcher that loads the OpenCoven Feedback SDK on first click.
// Until the user actually engages, no widget JS runs — this is what keeps
// the landing's mobile Lighthouse clean (the SDK eagerly pulls a multi-MB
// admin React bundle and throws a hydration error, neither of which we
// can fix from this repo).
---
<button
  id="feedback-trigger"
  type="button"
  class="feedback-fab"
  aria-label="Send feedback"
>
  <svg
    viewBox="0 0 24 24"
    width="16"
    height="16"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z" />
  </svg>
  <span class="feedback-fab-label">Feedback</span>
</button>

<script>
  // @ts-nocheck
  (function () {
    const btn = document.getElementById('feedback-trigger');
    if (!btn) return;

    let sdkRequested = false;

    function loadSdk() {
      if (sdkRequested) return;
      sdkRequested = true;
      const s = document.createElement('script');
      s.id = 'opencoven-feedback-sdk';
      s.async = true;
      s.src = 'https://feedback.opencoven.ai/api/widget/sdk.js';
      document.head.appendChild(s);
    }

    btn.addEventListener('click', () => {
      loadSdk();
      // Queue the open command. The SDK consumes the queue when it boots,
      // so this works whether the SDK is still loading or already in memory.
      if (typeof window.OpenCovenFeedback === 'function') {
        window.OpenCovenFeedback('open');
      }
    });
  })();
</script>

<style>
  .feedback-fab {
    position: fixed;
    bottom: 24px;
    right: 24px;
    z-index: 200;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: var(--violet-cta);
    color: #fff;
    border: 1px solid var(--violet-cta);
    border-radius: 999px;
    padding: 11px 18px;
    font-family: var(--font-ui);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    cursor: pointer;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.45);
    transition: background 0.18s ease, border-color 0.18s ease, transform 0.18s ease, box-shadow 0.18s ease;
    outline: none;
  }
  @media (hover: hover) {
    .feedback-fab:hover {
      background: var(--vtext);
      border-color: var(--vtext);
      color: var(--bg);
      transform: translateY(-2px);
      box-shadow: 0 12px 28px rgba(0, 0, 0, 0.5);
    }
  }
  .feedback-fab:focus-visible {
    outline: 2px solid #E8DBFF;
    outline-offset: 3px;
  }
  .feedback-fab svg { display: block; }

  @media (max-width: 520px) {
    .feedback-fab { bottom: 16px; right: 16px; padding: 12px; }
    .feedback-fab-label { display: none; }
  }
</style>
