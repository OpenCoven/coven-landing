---
// Sticky header with brand mark, desktop nav, mobile hamburger, and Join CTA.
const isGithub = Astro.url.pathname.replace(/\/$/, '') === '/github';
---
<header class="site-header">
  <div class="header-inner">
    <a class="brand" href="/#top" aria-label="OpenCoven home">
      <span class="brand-mark"><img src="/favicon.svg" alt="" /></span>
      <span>OpenCoven</span>
    </a>
    <button class="mobile-toggle" aria-label="Open menu" aria-expanded="false" aria-controls="mobile-nav">
      <svg width="22" height="16" viewBox="0 0 22 16" fill="none"><rect y="0" width="22" height="2" rx="1" fill="currentColor"/><rect y="7" width="22" height="2" rx="1" fill="currentColor"/><rect y="14" width="22" height="2" rx="1" fill="currentColor"/></svg>
    </button>
    <nav class="desktop-nav">
      <a href="/#how-it-works">How It Works</a>
      <a href="/#quickstart">Quick Start</a>
      <a href="/github" aria-current={isGithub ? 'page' : undefined}>GitHub App</a>
      <a href="https://docs.opencoven.ai">Docs</a>
    </nav>
    <div class="header-social">
      <a class="header-social-link" href="https://github.com/OpenCoven/coven" aria-label="OpenCoven on GitHub">
        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 .5A11.5 11.5 0 0 0 .5 12a11.5 11.5 0 0 0 7.86 10.92c.58.1.79-.25.79-.56v-2c-3.2.7-3.88-1.37-3.88-1.37-.53-1.34-1.28-1.7-1.28-1.7-1.05-.71.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.72-1.55-2.55-.29-5.24-1.28-5.24-5.7 0-1.26.45-2.29 1.19-3.1-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.18 1.18a11 11 0 0 1 5.8 0c2.2-1.5 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.84 1.19 3.1 0 4.43-2.7 5.4-5.26 5.69.41.36.78 1.06.78 2.14v3.17c0 .31.21.67.8.56A11.5 11.5 0 0 0 23.5 12 11.5 11.5 0 0 0 12 .5Z"/></svg>
      </a>
      <a class="header-social-link" href="https://x.com/OpenCvn" aria-label="OpenCoven on X">
        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M18.25 2.25h3.31l-7.23 8.26 8.5 11.24h-6.66l-5.21-6.82-5.97 6.82H1.68l7.73-8.84L1.25 2.25h6.83l4.71 6.23 5.46-6.23Zm-1.16 17.52h1.83L7.08 4.13H5.12l11.97 15.64Z"/></svg>
      </a>
      <a class="header-social-link" href="https://discord.gg/opencoven" aria-label="OpenCoven on Discord">
        <svg viewBox="0 0 127.14 96.36" fill="currentColor" aria-hidden="true"><path d="M107.7 8.07A105.15 105.15 0 0 0 81.47 0a72.06 72.06 0 0 0-3.36 6.83 97.68 97.68 0 0 0-29.11 0A72.37 72.37 0 0 0 45.64 0a105.89 105.89 0 0 0-26.25 8.09C2.79 32.65-1.71 56.6.54 80.21A105.73 105.73 0 0 0 32.71 96.36a77.7 77.7 0 0 0 6.89-11.11 68.42 68.42 0 0 1-10.85-5.18c.91-.66 1.8-1.34 2.66-2a75.57 75.57 0 0 0 64.32 0c.87.71 1.76 1.39 2.66 2a68.68 68.68 0 0 1-10.87 5.19 77 77 0 0 0 6.89 11.1 105.25 105.25 0 0 0 32.19-16.14c2.64-27.38-4.51-51.11-18.9-72.15ZM42.45 65.69C36.18 65.69 31 60 31 53s5-12.74 11.43-12.74S54 46 53.89 53s-5.05 12.69-11.44 12.69Zm42.24 0C78.41 65.69 73.25 60 73.25 53s5-12.74 11.44-12.74S96.23 46 96.12 53s-5.05 12.69-11.43 12.69Z"/></svg>
      </a>
    </div>
    <a class="btn-join" href="https://discord.gg/opencoven">
      Join the Coven <span class="join-diamond">✦</span>
    </a>
  </div>
</header>
