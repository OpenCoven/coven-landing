---
import '@fontsource-variable/geist';
import '@fontsource-variable/inter';
import '@fontsource-variable/jetbrains-mono';
import '../styles/tokens.css';
import '../styles/vnext.css';
import ThemeInit from '../components/ThemeInit.astro';
import { ogImage } from '../lib/og.js';

interface Props {
  title: string;
  description: string;
  canonicalPath?: string;
}

const { title, description, canonicalPath = Astro.url.pathname } = Astro.props;
const canonicalUrl = new URL(canonicalPath, 'https://opencoven.ai').toString();
const pathname = Astro.url.pathname.replace(/\/$/, '') || '/';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content="OpenCoven" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@OpenCvn" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <ThemeInit />
  </head>
  <body>
    <a class="skip-link" href="#content">Skip to content</a>
    <header class="site-header" data-oc-primitive="global-navigation">
      <div class="site-shell site-header__inner">
        <a class="brand-link" href="/" data-oc-part="brand-link" aria-label="OpenCoven home">
          <img src="/favicon.svg" alt="" width="31" height="31" />
          <span>OpenCoven</span>
        </a>
        <nav class="desktop-nav" aria-label="Primary" data-oc-part="primary-links">
          <a href="/#how-it-works">How it works</a>
          <a href="/#products">Products</a>
          <a href="/quickstart" aria-current={pathname === '/quickstart' ? 'page' : undefined}>Quickstart</a>
          <a href="/github" aria-current={pathname === '/github' ? 'page' : undefined}>GitHub</a>
          <a href="https://docs.opencoven.ai">Docs</a>
        </nav>
        <details class="mobile-nav" data-oc-primitive="mobile-navigation">
          <summary aria-label="Open navigation" data-oc-part="trigger">Menu</summary>
          <div class="mobile-nav__panel" data-oc-part="panel">
            <nav aria-label="Mobile primary" data-oc-part="links">
              <a href="/#how-it-works">How it works</a>
              <a href="/#products">Products</a>
              <a href="/quickstart">Quickstart</a>
              <a href="/github">GitHub</a>
              <a href="https://docs.opencoven.ai">Docs</a>
            </nav>
          </div>
        </details>
      </div>
    </header>
    <main id="content"><slot /></main>
    <footer class="site-footer">
      <div class="site-shell site-footer__inner">
        <span>OpenCoven · identity-preserving familiar infrastructure</span>
        <nav aria-label="Footer">
          <a href="https://github.com/OpenCoven">GitHub</a>
          <a href="https://docs.opencoven.ai">Docs</a>
          <a href="/privacy">Privacy</a>
          <a href="/terms">Terms</a>
        </nav>
      </div>
    </footer>
  </body>
</html>
