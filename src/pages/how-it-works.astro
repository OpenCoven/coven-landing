---
import SiteLayout from '../layouts/SiteLayout.astro';
import '../styles/routes.css';
import { canonicalFoundationCommands } from '../data/products.ts';

const title = 'How Coven works · OpenCoven';
const description =
  'How the current Coven runtime coordinates local agent sessions through durable state, shared claims, explicit authorization boundaries, and inspectable evidence.';

const runtimeSteps = [
  {
    title: 'A session enters a local project.',
    body: 'Coven binds work to an explicit project boundary and restores durable session context rather than treating each terminal process as the whole system.',
  },
  {
    title: 'Intent becomes inspectable.',
    body: 'Claims and records make overlapping work visible so sessions do not coordinate through prompt folklore or silent last-writer-wins behavior.',
  },
  {
    title: 'Authorization is evaluated before effects.',
    body: 'Threads owns protected-surface authorization decisions. Coven revalidates the authorized operation at the runtime boundary and can hold protected work for principal approval.',
  },
  {
    title: 'The evidence outlives the shell.',
    body: 'Durable session, claim, event, and artifact state remains inspectable after an individual harness or terminal process exits.',
  },
];

const ownershipCards = [
  {
    title: 'Coven runtime authority',
    body: 'Owns daemon authority, local IPC, project and session validation, persistence, execution, and enforcement of authorized operations at the local boundary.',
  },
  {
    title: 'Threads authorization',
    body: 'Owns protected-surface authorization decisions. Possessing context, filesystem access, or a session identifier does not itself grant permission.',
  },
  {
    title: 'Familiar Contract identity',
    body: 'Defines the governed familiar self and its protected identity boundary. Coven consumes authorized identity; it does not invent a familiar from a display name or prompt.',
  },
  {
    title: 'Psyche orchestration',
    body: 'Owns task, lane, lease, approval, receipt, recovery, and orchestration semantics. It snapshots authorized identity into work rather than becoming the identity root.',
  },
];
---

<SiteLayout title={title} description={description} canonicalPath="/how-it-works">
  <section class="site-shell hero" id="top">
    <div class="hero__copy">
      <p class="eyebrow">Current runtime behavior</p>
      <h1>The local layer your agent sessions share.</h1>
      <p class="hero__lede">
        Your coding harness still reasons and edits. Coven owns durable local session
        state, claims, persistence, execution, and runtime enforcement. Threads remains
        the protected-surface authorization authority, and the principal decides whether
        held work may proceed.
      </p>
      <div class="button-row">
        <a
          class="action action--primary"
          data-oc-primitive="action"
          data-oc-part="label"
          data-oc-state="idle"
          href="/quickstart"
        >Start locally</a>
        <a
          class="action"
          data-oc-primitive="action"
          data-oc-part="label"
          data-oc-state="idle"
          href="/protocol"
        >See the protocol map</a>
      </div>
    </div>
    <aside class="evidence-card" aria-labelledby="runtime-scope-heading">
      <span
        class="status status--available"
        data-oc-primitive="status-indicator"
        data-oc-part="label"
        data-oc-state="success"
      >Current runtime proof</span>
      <h2 class="card-heading" id="runtime-scope-heading">Scope of this route</h2>
      <p class="muted">
        This page describes shipped local Coven behavior. Familiar identity, continuity,
        cross-device state, and broader conformance remain separate maturity-scoped work.
      </p>
    </aside>
  </section>

  <section class="band" aria-labelledby="runtime-flow-heading">
    <div class="site-shell">
      <div class="band__intro">
        <h2 id="runtime-flow-heading">One project. Shared local evidence.</h2>
        <p>
          Coven does not collapse every process into one agent. It gives independent
          sessions a common record, explicit authority checks, and durable evidence.
        </p>
      </div>
      <ol class="proof-sequence" aria-label="Current Coven runtime sequence">
        {runtimeSteps.map((step) => (
          <li class="proof-step">
            <div class="proof-step__body">
              <h3>{step.title}</h3>
              <p>{step.body}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="band" aria-labelledby="ownership-heading">
    <div class="site-shell">
      <div class="band__intro">
        <h2 id="ownership-heading">Each semantic boundary keeps one owner.</h2>
        <p>
          Runtime, authorization, identity, and orchestration are related but not
          interchangeable. The landing page summarizes those contracts; it does not own them.
        </p>
      </div>
      <div class="product-grid">
        {ownershipCards.map((card) => (
          <article class="product-card">
            <h3>{card.title}</h3>
            <p>{card.body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="band" aria-labelledby="limits-heading">
    <div class="site-shell">
      <div class="band__intro">
        <h2 id="limits-heading">Local-first is a boundary, not a sandbox claim.</h2>
        <p>
          Coven validates requests and keeps its API on same-user local IPC by default.
          Supported harnesses still run with the user&apos;s privileges, and the current runtime
          does not claim containment against hostile local processes, prompts, or providers.
        </p>
      </div>
      <div class="architecture">
        <ol>
          <li>Capability advertisement describes availability; it never grants permission.</li>
          <li>Project, path, harness, version, and session validation happen before effects.</li>
          <li>Mutation replay is explicit and never silently inferred.</li>
          <li>Remote and tunnel transports require their own authenticated boundary; raw local IPC must not be exposed to a network or browser.</li>
        </ol>
      </div>
      <div class="button-row button-row--spaced">
        <a
          class="action"
          data-oc-primitive="action"
          data-oc-part="label"
          data-oc-state="idle"
          href="https://github.com/OpenCoven/coven/blob/main/SECURITY.md"
        >Read the runtime security policy</a>
      </div>
    </div>
  </section>

  <section class="band" aria-labelledby="runtime-start-heading">
    <div class="site-shell">
      <div class="band__intro">
        <h2 id="runtime-start-heading">Verify the foundation from one project.</h2>
        <p>The canonical local sequence remains deliberately small and registry-backed.</p>
      </div>
      <ol class="command-block" aria-label="Canonical Coven foundation">
        {canonicalFoundationCommands.map((item, index) => (
          <li class="command-row">
            <span>{index + 1}</span>
            <code>{item.command}</code>
          </li>
        ))}
      </ol>
    </div>
  </section>
</SiteLayout>
