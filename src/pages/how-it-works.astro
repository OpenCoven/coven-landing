---
import '@fontsource/eb-garamond/400.css';
import '@fontsource/eb-garamond/400-italic.css';
import '@fontsource/eb-garamond/500.css';
import '@fontsource/inter/400.css';
import '@fontsource/inter/500.css';
import '@fontsource/inter/600.css';
import '@fontsource/jetbrains-mono/400.css';
import '@fontsource/jetbrains-mono/500.css';
import '@phosphor-icons/web/regular';
import '../styles/redesign.css';

import ThemeInit from '../components/ThemeInit.astro';
import PosthogSnippet from '../components/redesign/PosthogSnippet.astro';
import Board from '../components/redesign/Board.astro';
import DownloadCta from '../components/redesign/DownloadCta.astro';
import RedesignFooter from '../components/redesign/RedesignFooter.astro';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>How it works · OpenCoven</title>
    <meta
      name="description"
      content="How Coven coordinates coding agents: the daemon, claims, the shared record, familiars, and guards, from install to first held claim."
    />
    <meta property="og:title" content="How it works · OpenCoven" />
    <meta
      property="og:description"
      content="How Coven coordinates coding agents: the daemon, claims, the shared record, familiars, and guards, from install to first held claim."
    />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://opencoven.ai/how-it-works" />
    <meta property="og:image" content="https://opencoven.ai/og.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@OpenCvn" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <ThemeInit />
    <PosthogSnippet />
  </head>
  <body>
    <nav data-nav="" style="position: sticky; top: 0; z-index: 60; background: transparent; border-bottom: 1px solid transparent; will-change: transform; transition: transform 300ms cubic-bezier(0.2,0,0,1), background-color 220ms cubic-bezier(0.2,0,0,1), border-color 220ms cubic-bezier(0.2,0,0,1)">
      <div style="max-width: 1140px; margin: 0 auto; padding: 0 32px; height: 60px; display: flex; align-items: center; justify-content: space-between">
        <a href="/" style="display: flex; align-items: center; gap: 10px; font-weight: 600; font-size: 16px; letter-spacing: -0.01em">
          <img data-logo="" src="/assets/opencoven-black.svg" alt="OpenCoven" width="34" height="34" style="width: 34px; height: 34px; display: block">
          OpenCoven
        </a>
        <div data-r="navlinks" style="display: flex; align-items: center; gap: 26px; font-size: 14px; color: var(--cv-text-secondary)">
          <a href="/" style="color: var(--cv-text-secondary)">Overview</a>
          <a href="https://docs.opencoven.ai" style="color: var(--cv-text-secondary)">Docs</a>
          <a href="https://github.com/OpenCoven/coven" style="color: var(--cv-text-secondary)">GitHub</a>
          <a href="https://discord.gg/opencoven" style="color: var(--cv-text-secondary)">Discord</a>
        </div>
        <div style="display: flex; align-items: center; gap: 8px">
          <button type="button" data-action="toggleTheme" aria-label="Switch to light mode" data-dcb="themeAria:aria-label" style="width: 34px; height: 34px; border-radius: 999px; border: 1px solid var(--cv-border-hairline); background: var(--cv-bg-raised); color: var(--cv-text-secondary); font-size: 13px; cursor: pointer; display: inline-flex; align-items: center; justify-content: center; font-family: inherit" class="rh0"><i class="ph ph-moon-stars" data-dcb="themeIcon:class" aria-hidden="true" style="font-size: 15px; line-height: 1"></i></button>
              </div>
      </div>
    </nav>
    <main>
      <div data-screen-label="How it works v3" data-r="shell" style="min-width: 1140px; background: var(--cv-bg-base)">

        <header style="max-width: 1140px; margin: 0 auto; padding: 80px 32px 64px">
          <div data-hero="" style="max-width: 68ch">
            <a href="/" style="font-family: 'JetBrains Mono', monospace; font-variant-ligatures: none; font-size: 11px; letter-spacing: 0.06em; text-transform: uppercase; color: var(--cv-text-muted)">← Back to home</a>
            <h1 style="font-family: 'EB Garamond', serif; font-weight: 400; font-size: 76px; line-height: 1.05; letter-spacing: -0.02em; margin: 22px 0 20px; white-space: nowrap">The layer your agents <em style="font-style: italic; position: relative; display: inline-block">share<span data-hero-underline="" style="position: absolute; left: 0; right: 0; bottom: 0.1em; height: 3px; border-radius: 2px; background: var(--cv-accent); transform: scaleX(0); transform-origin: left center; transition: transform 1s cubic-bezier(0.2,0,0,1)"></span></em>.</h1>
            <p style="font-size: 19px; line-height: 1.6; color: var(--cv-text-secondary); margin: 0; max-width: 68ch">Coven sits between the agent CLIs you already run and the project they are working in. Your harness keeps reasoning and writing code. Coven holds the state those sessions have to share: intent, ownership, authority, and evidence.</p>
          </div>
        </header>

        <!-- Architecture -->
        <section id="architecture" style="border-top: 1px solid var(--cv-border-hairline); background: var(--cv-bg-panel)">
          <div style="max-width: 1140px; margin: 0 auto; padding: 76px 32px">
            <div data-anim="" style="display: flex; flex-direction: column; align-items: flex-start; gap: 14px; margin-bottom: 40px">
              <h2 style="font-family: 'EB Garamond', serif; font-weight: 400; font-size: 46px; letter-spacing: -0.018em; margin: 0">Three layers, one boundary</h2>
              <p style="font-size: 15px; line-height: 1.6; color: var(--cv-text-secondary); max-width: 62ch; margin: 0">Commands go down. Output and memory come back up.&nbsp;<br>Coven attributes every crossing to a session.</p>
            </div>

            <div data-arch="" style="display: flex; flex-direction: column">
              <div data-arch-card="0" style="border: 1px solid var(--cv-border-hairline); border-radius: 12px; background: var(--cv-bg-elevated); padding: 22px 24px; display: flex; align-items: center; gap: 24px; transition: border-color 400ms cubic-bezier(0.2,0,0,1), background-color 400ms cubic-bezier(0.2,0,0,1)">
                <span data-arch-label="" style="font-family: 'JetBrains Mono', monospace; font-variant-ligatures: none; font-size: 10px; letter-spacing: 0.08em; text-transform: uppercase; color: var(--cv-text-muted); flex-shrink: 0; transition: color 400ms">Harness layer</span>
                <span style="display: flex; gap: 8px; flex-wrap: wrap"><span style="display: inline-flex; align-items: center; gap: 8px; border: 1px solid var(--cv-border-hairline); border-radius: 999px; padding: 6px 13px; font-size: 13px; color: var(--cv-text-secondary)"><i class="ph ph-terminal-window" aria-hidden="true" style="font-size: 16px; line-height: 1; color: inherit"></i>Claude Code</span><span style="display: inline-flex; align-items: center; gap: 8px; border: 1px solid var(--cv-border-hairline); border-radius: 999px; padding: 6px 13px; font-size: 13px; color: var(--cv-text-secondary)"><i class="ph ph-terminal-window" aria-hidden="true" style="font-size: 16px; line-height: 1; color: inherit"></i>Codex</span><span style="display: inline-flex; align-items: center; gap: 8px; border: 1px solid var(--cv-border-hairline); border-radius: 999px; padding: 6px 13px; font-size: 13px; color: var(--cv-text-secondary)"><i class="ph ph-terminal-window" aria-hidden="true" style="font-size: 16px; line-height: 1; color: inherit"></i>Hermes</span><span style="display: inline-flex; align-items: center; gap: 8px; border: 1px solid var(--cv-border-hairline); border-radius: 999px; padding: 6px 13px; font-size: 13px; color: var(--cv-text-secondary)"><i class="ph ph-terminal-window" aria-hidden="true" style="font-size: 16px; line-height: 1; color: inherit"></i>OpenCode</span><span style="display: inline-flex; align-items: center; gap: 8px; border: 1px solid var(--cv-border-hairline); border-radius: 999px; padding: 6px 13px; font-size: 13px; color: var(--cv-text-secondary)"><i class="ph ph-terminal-window" aria-hidden="true" style="font-size: 16px; line-height: 1; color: inherit"></i>OpenClaw</span><span style="display: inline-flex; align-items: center; gap: 8px; border: 1px dashed var(--cv-border-hairline); border-radius: 999px; padding: 6px 13px; font-size: 13px; color: var(--cv-text-muted)"><i class="ph ph-plus" aria-hidden="true" style="font-size: 16px; line-height: 1; color: inherit"></i>whatever ships next</span></span>
              </div>
              <div style="display: grid; grid-template-columns: 128px 1fr; gap: 24px; padding: 0 24px">
                <span></span>
                <span style="display: flex; align-items: center; gap: 16px; height: 56px">
                  <span style="position: relative; width: 1px; height: 56px; background: var(--cv-border-hairline); overflow: hidden">
                    <span data-flow="down" style="position: absolute; inset: 0; background: var(--cv-accent); transform: scaleY(0); transform-origin: top center"></span>
                  </span>
                  <span style="font-family: 'JetBrains Mono', monospace; font-variant-ligatures: none; font-size: 10.5px; color: var(--cv-text-muted)">commands down</span>
                </span>
              </div>
              <div data-arch-card="1" style="border: 1px solid color-mix(in oklch, var(--cv-accent) 40%, transparent); border-radius: 12px; background: var(--cv-accent-soft); padding: 22px 24px; display: flex; align-items: center; gap: 24px; transition: border-color 400ms cubic-bezier(0.2,0,0,1), background-color 400ms cubic-bezier(0.2,0,0,1)">
                <span data-arch-label="" style="font-family: 'JetBrains Mono', monospace; font-variant-ligatures: none; font-size: 10px; letter-spacing: 0.08em; text-transform: uppercase; color: var(--cv-accent); flex-shrink: 0; transition: color 400ms">Coven runtime</span>
                <span style="display: flex; gap: 8px; flex-wrap: wrap"><span style="display: inline-flex; align-items: center; gap: 8px; border: 1px solid var(--cv-border-hairline); border-radius: 999px; padding: 6px 13px; font-size: 13px; color: var(--cv-text-secondary)"><i class="ph ph-stack" aria-hidden="true" style="font-size: 16px; line-height: 1; color: inherit"></i>Sessions</span><span style="display: inline-flex; align-items: center; gap: 8px; border: 1px solid var(--cv-border-hairline); border-radius: 999px; padding: 6px 13px; font-size: 13px; color: var(--cv-text-secondary)"><i class="ph ph-file-text" aria-hidden="true" style="font-size: 16px; line-height: 1; color: inherit"></i>Memory</span><span style="display: inline-flex; align-items: center; gap: 8px; border: 1px solid var(--cv-border-hairline); border-radius: 999px; padding: 6px 13px; font-size: 13px; color: var(--cv-text-secondary)"><i class="ph ph-plug" aria-hidden="true" style="font-size: 16px; line-height: 1; color: inherit"></i>Adapter</span><span style="display: inline-flex; align-items: center; gap: 8px; border: 1px solid var(--cv-border-hairline); border-radius: 999px; padding: 6px 13px; font-size: 13px; color: var(--cv-text-secondary)"><i class="ph ph-shield-check" aria-hidden="true" style="font-size: 16px; line-height: 1; color: inherit"></i>Tool gateway</span></span>
              </div>
              <div style="display: grid; grid-template-columns: 128px 1fr; gap: 24px; padding: 0 24px">
                <span></span>
                <span style="display: flex; align-items: center; gap: 16px; height: 56px">
                  <span style="position: relative; width: 1px; height: 56px; background: var(--cv-border-hairline); overflow: hidden">
                    <span data-flow="up" style="position: absolute; inset: 0; background: var(--cv-accent); transform: scaleY(0); transform-origin: bottom center"></span>
                  </span>
                  <span style="font-family: 'JetBrains Mono', monospace; font-variant-ligatures: none; font-size: 10.5px; color: var(--cv-text-muted)">output and memory up</span>
                </span>
              </div>
              <div data-arch-card="2" style="border: 1px solid var(--cv-border-hairline); border-radius: 12px; background: var(--cv-bg-elevated); padding: 22px 24px; display: flex; align-items: center; gap: 24px; transition: border-color 400ms cubic-bezier(0.2,0,0,1), background-color 400ms cubic-bezier(0.2,0,0,1)">
                <span data-arch-label="" style="font-family: 'JetBrains Mono', monospace; font-variant-ligatures: none; font-size: 10px; letter-spacing: 0.08em; text-transform: uppercase; color: var(--cv-text-muted); flex-shrink: 0; transition: color 400ms">Your project</span>
                <span style="display: flex; gap: 8px; flex-wrap: wrap"><span style="display: inline-flex; align-items: center; gap: 8px; border: 1px solid var(--cv-border-hairline); border-radius: 999px; padding: 6px 13px; font-size: 13px; color: var(--cv-text-secondary)"><i class="ph ph-folder" aria-hidden="true" style="font-size: 16px; line-height: 1; color: inherit"></i>Filesystem</span><span style="display: inline-flex; align-items: center; gap: 8px; border: 1px solid var(--cv-border-hairline); border-radius: 999px; padding: 6px 13px; font-size: 13px; color: var(--cv-text-secondary)"><i class="ph ph-git-branch" aria-hidden="true" style="font-size: 16px; line-height: 1; color: inherit"></i>Git</span><span style="display: inline-flex; align-items: center; gap: 8px; border: 1px solid var(--cv-border-hairline); border-radius: 999px; padding: 6px 13px; font-size: 13px; color: var(--cv-text-secondary)"><i class="ph ph-terminal-window" aria-hidden="true" style="font-size: 16px; line-height: 1; color: inherit"></i>Terminals</span><span style="display: inline-flex; align-items: center; gap: 8px; border: 1px solid var(--cv-border-hairline); border-radius: 999px; padding: 6px 13px; font-size: 13px; color: var(--cv-text-secondary)"><i class="ph ph-file-text" aria-hidden="true" style="font-size: 16px; line-height: 1; color: inherit"></i>Docs</span></span>
              </div>
              <div style="display: grid; grid-template-columns: 128px 1fr; gap: 24px; padding: 20px 24px 0; margin-top: 4px">
                <span style="font-family: 'JetBrains Mono', monospace; font-variant-ligatures: none; font-size: 10px; letter-spacing: 0.08em; text-transform: uppercase; color: var(--cv-text-muted)">Boundary</span>
                <span style="font-size: 13.5px; color: var(--cv-text-secondary)">Every session works inside one project root. Anything out of tree needs a written grant.</span>
              </div>
            </div>
          </div>
        </section>

        <section id="layers" style="border-top: 1px solid var(--cv-border-hairline)">
          <div style="max-width: 1140px; margin: 0 auto; padding: 76px 32px; display: grid; grid-template-columns: 320px minmax(0,1fr); gap: 72px; align-items: start">
            <div style="position: sticky; top: 108px">
              <h2 style="font-family: 'EB Garamond', serif; font-weight: 400; font-size: 44px; letter-spacing: -0.018em; line-height: 1.05; margin: 0 0 16px">What Coven keeps</h2>
              <p style="font-size: 15px; line-height: 1.65; color: var(--cv-text-secondary); margin: 0 0 26px">Memory, sessions, harnesses, and actions. These four decide what a session can do.</p>
              <div style="display: flex; flex-direction: column; gap: 2px">
                <a href="#layer-memory" data-toc="layer-memory" style="display: flex; align-items: center; gap: 12px; padding: 9px 0; font-size: 14px; color: var(--cv-text-muted); border-top: 1px solid var(--cv-border-hairline)"><span style="font-family: 'JetBrains Mono', monospace; font-variant-ligatures: none; font-size: 11px">01</span>Memory</a>
                <a href="#layer-sessions" data-toc="layer-sessions" style="display: flex; align-items: center; gap: 12px; padding: 9px 0; font-size: 14px; color: var(--cv-text-muted); border-top: 1px solid var(--cv-border-hairline)"><span style="font-family: 'JetBrains Mono', monospace; font-variant-ligatures: none; font-size: 11px">02</span>Sessions</a>
                <a href="#layer-harnesses" data-toc="layer-harnesses" style="display: flex; align-items: center; gap: 12px; padding: 9px 0; font-size: 14px; color: var(--cv-text-muted); border-top: 1px solid var(--cv-border-hairline)"><span style="font-family: 'JetBrains Mono', monospace; font-variant-ligatures: none; font-size: 11px">03</span>Harnesses</a>
                <a href="#layer-tools" data-toc="layer-tools" style="display: flex; align-items: center; gap: 12px; padding: 9px 0; font-size: 14px; color: var(--cv-text-muted); border-top: 1px solid var(--cv-border-hairline); border-bottom: 1px solid var(--cv-border-hairline)"><span style="font-family: 'JetBrains Mono', monospace; font-variant-ligatures: none; font-size: 11px">04</span>Actions</a>
              </div>
            </div>

            <div style="display: flex; flex-direction: column; gap: 20px">
              <div id="layer-memory" data-layer-panel="" style="scroll-margin-top: 100px; border: 1px solid var(--cv-border-hairline); border-radius: 12px; background: var(--cv-bg-raised); padding: 32px">
                <span style="font-family: 'JetBrains Mono', monospace; font-variant-ligatures: none; font-size: 10px; letter-spacing: 0.08em; text-transform: uppercase; color: var(--cv-accent)">01 · Memory</span>
                <h3 style="font-family: 'EB Garamond', serif; font-weight: 400; font-size: 30px; letter-spacing: -0.012em; margin: 12px 0 10px">Memory that carries between sessions</h3>
                <p style="font-size: 15px; line-height: 1.65; color: var(--cv-text-secondary); margin: 0 0 22px; max-width: 58ch; font-size: 16px">A file on your disk. The next session reads it first.</p>
                <div data-mem-cap="" style="font-family: 'JetBrains Mono', monospace; font-variant-ligatures: none; font-size: 11.5px; color: var(--cv-code-dim); margin-bottom: 10px">~/.coven/familiars/hexi/memory.md</div>
                <div data-mem-grid="" style="display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px">
                  <div style="border: 1px solid var(--cv-border-hairline); border-radius: 10px; background: var(--cv-bg-elevated); padding: 14px 16px; display: flex; flex-direction: column; gap: 9px; min-width: 0">
                    <span style="display: flex; align-items: center; gap: 8px; font-family: 'JetBrains Mono', monospace; font-variant-ligatures: none; font-size: 10px; letter-spacing: 0.08em; text-transform: uppercase; color: var(--cv-text-muted)"><i class="ph ph-folder-simple" aria-hidden="true" style="font-size: 15px; line-height: 1; color: var(--cv-accent)"></i>Project</span>
                    <span style="font-family: 'JetBrains Mono', monospace; font-variant-ligatures: none; font-size: 12.5px; line-height: 1.5; color: var(--cv-code-fg); text-wrap: pretty">opencoven, Astro, no build step</span>
                  </div>
                  <div style="border: 1px solid var(--cv-border-hairline); border-radius: 10px; background: var(--cv-bg-elevated); padding: 14px 16px; display: flex; flex-direction: column; gap: 9px; min-width: 0">
                    <span style="display: flex; align-items: center; gap: 8px; font-family: 'JetBrains Mono', monospace; font-variant-ligatures: none; font-size: 10px; letter-spacing: 0.08em; text-transform: uppercase; color: var(--cv-text-muted)"><i class="ph ph-repeat" aria-hidden="true" style="font-size: 15px; line-height: 1; color: var(--cv-accent)"></i>Habit</span>
                    <span style="font-family: 'JetBrains Mono', monospace; font-variant-ligatures: none; font-size: 12.5px; line-height: 1.5; color: var(--cv-code-fg); text-wrap: pretty">keep PR summaries short</span>
                  </div>
                  <div style="border: 1px solid var(--cv-border-hairline); border-radius: 10px; background: var(--cv-bg-elevated); padding: 14px 16px; display: flex; flex-direction: column; gap: 9px; min-width: 0">
                    <span style="display: flex; align-items: center; gap: 8px; font-family: 'JetBrains Mono', monospace; font-variant-ligatures: none; font-size: 10px; letter-spacing: 0.08em; text-transform: uppercase; color: var(--cv-text-muted)"><i class="ph ph-bookmark-simple" aria-hidden="true" style="font-size: 15px; line-height: 1; color: var(--cv-accent)"></i>Left off</span>
                    <span style="font-family: 'JetBrains Mono', monospace; font-variant-ligatures: none; font-size: 12.5px; line-height: 1.5; color: var(--cv-code-fg); text-wrap: pretty">feat/runtime-attach, 4 files staged</span>
                  </div>
                  <div style="border: 1px solid var(--cv-border-hairline); border-radius: 10px; background: var(--cv-bg-elevated); padding: 14px 16px; display: flex; flex-direction: column; gap: 9px; min-width: 0">
                    <span style="display: flex; align-items: center; gap: 8px; font-family: 'JetBrains Mono', monospace; font-variant-ligatures: none; font-size: 10px; letter-spacing: 0.08em; text-transform: uppercase; color: var(--cv-text-muted)"><i class="ph ph-shield-check" aria-hidden="true" style="font-size: 15px; line-height: 1; color: var(--cv-accent)"></i>Rule</span>
                    <span style="font-family: 'JetBrains Mono', monospace; font-variant-ligatures: none; font-size: 12.5px; line-height: 1.5; color: var(--cv-code-fg); text-wrap: pretty">ask before touching infra/</span>
                  </div>
                </div>
              </div>

              <div id="layer-sessions" data-layer-panel="" style="scroll-margin-top: 100px; border: 1px solid var(--cv-border-hairline); border-radius: 12px; background: var(--cv-bg-raised); padding: 32px">
                <span style="font-family: 'JetBrains Mono', monospace; font-variant-ligatures: none; font-size: 10px; letter-spacing: 0.08em; text-transform: uppercase; color: var(--cv-text-muted)">02 · Sessions</span>
                <h3 style="font-family: 'EB Garamond', serif; font-weight: 400; font-size: 30px; letter-spacing: -0.012em; margin: 12px 0 10px">A session outlives its terminal</h3>
                <p style="font-size: 15px; line-height: 1.65; color: var(--cv-text-secondary); margin: 0 0 22px; max-width: 58ch">Reboot mid-task and the record comes back. The process does not.</p>
                <div data-session-demo="" style="position: relative; border: 1px solid var(--cv-border-hairline); border-radius: 10px; overflow: hidden; transition: border-color 320ms cubic-bezier(0.2,0,0,1)">
                  <div style="display: flex; align-items: center; gap: 10px; padding: 10px 16px; background: var(--cv-bg-panel); border-bottom: 1px solid var(--cv-border-hairline)">
                    <span style="font-size: 12.5px; font-weight: 500">hexi · claude code</span>
                    <span data-sess-phase="" style="font-family: 'JetBrains Mono', monospace; font-variant-ligatures: none; font-size: 10px; letter-spacing: 0.07em; text-transform: uppercase; color: var(--cv-text-muted); margin-left: auto; transition: color 300ms">live</span>
                  </div>
                  <div data-sess-sweep="" style="position: absolute; left: 0; right: 0; top: 41px; height: 1px; background: var(--cv-accent); opacity: 0; transform: scaleX(0); transform-origin: left center; transition: transform 900ms cubic-bezier(0.2,0,0,1), opacity 300ms"></div>
                  <div data-proc-body="" style="display: grid; grid-template-columns: minmax(0,1fr) 132px; gap: 20px; padding: 20px 18px 18px">
                    <div style="min-width: 0">
                      <div style="display: flex; align-items: center; padding-bottom: 22px">
                      <div data-proc-node="harness" style="position: relative; flex: 0 0 auto; width: 38px; height: 38px; border: 1px solid var(--cv-border-hairline); border-radius: 9px; background: var(--cv-bg-panel); display: grid; place-items: center; transition: border-color 320ms cubic-bezier(0.2,0,0,1), background-color 320ms cubic-bezier(0.2,0,0,1)">
                        <i class="ph ph-terminal-window" aria-hidden="true" style="font-size: 17px; line-height: 1; color: var(--cv-text-secondary); transition: color 320ms, opacity 320ms"></i>
