---
import SiteLayout from '../layouts/SiteLayout.astro';
import '../styles/routes.css';
import {
  activeProducts,
  archivedProducts,
  canonicalFoundationCommands,
} from '../data/products.ts';

const title = 'OpenCoven Quickstart · Start locally';
const description =
  'Install the shared OpenCoven runtime, verify your project, then choose the current product surface that matches the job.';

const productState = (maturity: string) => {
  if (maturity === 'available') return 'success';
  if (maturity === 'gated-beta') return 'unavailable';
  return 'selected';
};

const collectionJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'OpenCoven Quickstart',
  description,
  url: 'https://opencoven.ai/quickstart',
  mainEntity: {
    '@type': 'ItemList',
    itemListElement: activeProducts.map((product, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: product.name,
      url: product.canonicalUrl.startsWith('/')
        ? `https://opencoven.ai${product.canonicalUrl}`
        : product.canonicalUrl,
    })),
  },
};
---

<SiteLayout title={title} description={description} canonicalPath="/quickstart">
  <script type="application/ld+json" set:html={JSON.stringify(collectionJsonLd)} />

  <section class="site-shell hero" id="top">
    <div class="hero__copy">
      <p class="eyebrow">Quickstart</p>
      <h1>Start with one local foundation.</h1>
      <p class="hero__lede">
        Install the shared Coven CLI/runtime, check the current project, and open Coven.
        Then choose Code, Cave, or GitHub delivery only when the job calls for that surface.
      </p>
      <div class="button-row">
        <a
          class="action action--primary"
          data-oc-primitive="action"
          data-oc-part="label"
          data-oc-state="idle"
          href="#foundation"
        >Run the three commands</a>
        <a
          class="action"
          data-oc-primitive="action"
          data-oc-part="label"
          data-oc-state="idle"
          href="#surfaces"
        >Choose a surface</a>
      </div>
    </div>
    <aside class="evidence-card" aria-labelledby="arrival-heading">
      <span
        class="status status--available"
        data-oc-primitive="status-indicator"
        data-oc-part="label"
        data-oc-state="success"
      >Current start path</span>
      <h2 class="card-heading" id="arrival-heading">What success looks like</h2>
      <p class="muted">
        <code>coven doctor</code> reports a usable project and provider boundary, then
        <code>coven</code> opens the current project without an extra init ceremony.
      </p>
    </aside>
  </section>

  <section class="band" id="foundation" aria-labelledby="foundation-heading">
    <div class="site-shell">
      <div class="band__intro">
        <h2 id="foundation-heading">Three commands. One canonical source.</h2>
        <p>
          These commands come directly from the checked-in product registry. Their text
          remains visible and selectable when JavaScript or clipboard permission is unavailable.
        </p>
      </div>

      <ol class="command-block command-block--wide" aria-label="Canonical local foundation commands">
        {canonicalFoundationCommands.map((item) => (
          <li
            class="copy-control"
            data-copy-surface
            data-oc-primitive="copy-control"
            data-oc-state="idle"
          >
            <div class="copy-control__main">
              <span class="copy-control__label">{item.label}</span>
              <code data-oc-part="source">{item.command}</code>
            </div>
            <div class="copy-control__actions">
              <button
                class="copy-button action"
                type="button"
                data-oc-part="trigger"
                data-copy={item.command}
                aria-label={`Copy command: ${item.label}`}
              >Copy</button>
              <span
                class="copy-status"
                data-oc-part="status"
                aria-live="polite"
                aria-atomic="true"
              ></span>
            </div>
          </li>
        ))}
      </ol>
      <noscript>
        <p class="muted">Clipboard enhancement is off. Select and copy the visible commands normally.</p>
      </noscript>
    </div>
  </section>

  <section class="band" id="surfaces" aria-labelledby="surfaces-heading">
    <div class="site-shell">
      <div class="band__intro">
        <h2 id="surfaces-heading">Then branch by job, not by branding.</h2>
        <p>
          Each current product has one registry-backed status, owner, platform boundary,
          canonical destination, and primary action.
        </p>
      </div>
      <div class="product-grid" data-active-product-grid>
        {activeProducts.map((product) => (
          <article
            class="product-card"
            id={product.id}
            data-product-lifecycle="active"
          >
            <span
              class:list={["status", `status--${product.maturity}`]}
              data-oc-primitive="status-indicator"
              data-oc-part="label"
              data-oc-state={productState(product.maturity)}
            >{product.statusLabel}</span>
            <p class="eyebrow">{product.category}</p>
            <h3>{product.name}</h3>
            <p>{product.summary}</p>
            <p><strong>Best for:</strong> {product.bestFor}</p>
            <p class="muted">{product.platforms}</p>
            <p class="route-meta mono">Owner: {product.ownerRepository}</p>
            <div class="button-row">
              <a
                class="action"
                data-oc-primitive="action"
                data-oc-part="label"
                data-oc-state="idle"
                href={product.primaryAction.href}
              >{product.primaryAction.label}</a>
              {product.docsUrl && <a href={product.docsUrl}>Docs</a>}
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="band" id="archive" aria-labelledby="archive-heading">
    <div class="site-shell">
      <div class="band__intro">
        <h2 id="archive-heading">Historical lineage stays visible, not recommended.</h2>
        <p>
          Archived products remain available for migration and release history only. They
          do not participate in the current start sequence or active product JSON-LD.
        </p>
      </div>
      <div class="archive-stack" data-archived-product-grid>
        {archivedProducts.map((product) => (
          <article
            class="evidence-card"
            id={product.id}
            data-product-lifecycle="archived"
          >
            <span
              class="status"
              data-oc-primitive="status-indicator"
              data-oc-part="label"
              data-oc-state="unavailable"
            >{product.statusLabel}</span>
            <h3 class="card-heading">{product.name}</h3>
            <p>{product.summary}</p>
            <p class="muted">{product.bestFor}</p>
            <a href={product.primaryAction.href}>{product.primaryAction.label}</a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <script>
    const resetTimers = new WeakMap();

    function selectCommand(element) {
      const selection = window.getSelection();
      if (!selection) return;
      const range = document.createRange();
      range.selectNodeContents(element);
      selection.removeAllRanges();
      selection.addRange(range);
    }

    document.querySelectorAll('[data-copy-surface]').forEach((surface) => {
      const button = surface.querySelector('[data-copy]');
      const source = surface.querySelector('[data-oc-part="source"]');
      const status = surface.querySelector('[data-oc-part="status"]');
      if (!(button instanceof HTMLButtonElement) || !source || !status) return;

      surface.setAttribute('data-copy-ready', '');
      button.addEventListener('click', async () => {
        const text = button.getAttribute('data-copy') ?? '';
        surface.setAttribute('data-oc-state', 'copying');
        button.disabled = true;

        try {
          if (!navigator.clipboard?.writeText) throw new Error('Clipboard unavailable');
          await navigator.clipboard.writeText(text);
          surface.setAttribute('data-oc-state', 'success');
          status.textContent = `Copied: ${text}`;
        } catch {
          selectCommand(source);
          surface.setAttribute('data-oc-state', 'error');
          status.textContent = 'Copy unavailable. Command selected; copy it manually.';
        }

        clearTimeout(resetTimers.get(surface));
        resetTimers.set(surface, window.setTimeout(() => {
          button.disabled = false;
          status.textContent = '';
          surface.setAttribute('data-oc-state', 'idle');
        }, 3000));
      });
    });
  </script>
</SiteLayout>
