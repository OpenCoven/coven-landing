---
import SiteLayout from '../layouts/SiteLayout.astro';
import { activeProducts, archivedProducts, canonicalFoundationCommands } from '../data/products.ts';

const title = 'OpenCoven Quickstart · Start locally';
const description = 'Install the shared OpenCoven runtime, verify your project, then choose the product surface that matches your job.';

const collectionJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'OpenCoven Quickstart',
  description,
  url: 'https://opencoven.ai/quickstart',
  mainEntity: {
    '@type': 'ItemList',
    itemListElement: activeProducts.map((product, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: product.name,
      url: product.canonicalUrl.startsWith('/')
        ? `https://opencoven.ai${product.canonicalUrl}`
        : product.canonicalUrl,
    })),
  },
};
---

<SiteLayout title={title} description={description} canonicalPath="/quickstart">
  <script type="application/ld+json" set:html={JSON.stringify(collectionJsonLd)} />

  <section class="site-shell hero" id="top">
    <div class="hero__copy">
      <p class="eyebrow">Quickstart</p>
      <h1>Start with one local foundation.</h1>
      <p class="hero__lede">
        Install the shared Coven CLI/runtime, check the current project, and open Coven.
        After that, choose Code, Cave, or GitHub delivery only when the job calls for it.
      </p>
      <div class="button-row">
        <a class="action action--primary" data-oc-primitive="action" href="#foundation">Run the three commands</a>
        <a class="action" data-oc-primitive="action" href="#surfaces">Choose a surface</a>
      </div>
    </div>
    <aside class="evidence-card" aria-labelledby="arrival-heading">
      <span class="status status--available" data-oc-primitive="status-indicator">Current start path</span>
      <h2 id="arrival-heading" style="font-size: var(--oc-type-2); margin-top: var(--oc-space-4)">What success looks like</h2>
      <p class="muted">`coven doctor` reports a usable project/provider boundary and `coven` opens the current project without an extra init ceremony.</p>
    </aside>
  </section>

  <section class="band" id="foundation" aria-labelledby="foundation-heading">
    <div class="site-shell">
      <div class="band__intro">
        <h2 id="foundation-heading">Three commands. One canonical source.</h2>
        <p>
          These strings come directly from the checked-in public product registry. The
          visible text remains selectable when clipboard access or JavaScript is unavailable.
        </p>
      </div>
      <div class="command-block">
        {canonicalFoundationCommands.map((item, index) => (
          <div class="command-row" data-oc-primitive="copy-control" data-copy-surface>
            <span>{index + 1}</span>
            <div>
              <code data-oc-part="source">{item.command}</code>
              <div class="button-row" style="margin-top: .55rem">
                <button class="copy-button" type="button" data-oc-part="trigger" data-copy={item.command}>Copy command</button>
                <span class="copy-status" data-oc-part="status" aria-live="polite" aria-atomic="true"></span>
              </div>
            </div>
          </div>
        ))}
      </div>
      <noscript><p class="muted">Clipboard enhancement is off. Select and copy the visible commands normally.</p></noscript>
    </div>
  </section>

  <section class="band" id="surfaces" aria-labelledby="surfaces-heading">
    <div class="site-shell">
      <div class="band__intro">
        <h2 id="surfaces-heading">Then branch by job, not by branding.</h2>
        <p>Each current product has one truthful status, owner, platform boundary, and canonical destination.</p>
      </div>
      <div class="product-grid">
        {activeProducts.map((product) => (
          <article class="product-card" id={product.id}>
            <span class:list={["status", `status--${product.maturity}`]} data-oc-primitive="status-indicator">{product.statusLabel}</span>
            <p class="eyebrow">{product.category}</p>
            <h3>{product.name}</h3>
            <p>{product.summary}</p>
            <p><strong>Best for:</strong> {product.bestFor}</p>
            <p class="muted">{product.platforms}</p>
            <p class="mono muted" style="font-size: var(--oc-type--1)">Owner: {product.ownerRepository}</p>
            <div class="button-row">
              <a class="action" data-oc-primitive="action" href={product.primaryAction.href}>{product.primaryAction.label}</a>
              {product.docsUrl && <a href={product.docsUrl}>Docs</a>}
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="band" aria-labelledby="archive-heading">
    <div class="site-shell">
      <div class="band__intro">
        <h2 id="archive-heading">Historical lineage stays visible, not recommended.</h2>
        <p>Archived products are kept for migration and release history only. They never appear in the current start sequence.</p>
      </div>
      {archivedProducts.map((product) => (
        <article class="evidence-card" style="margin-top: var(--oc-space-6)">
          <span class="status" data-oc-primitive="status-indicator">{product.statusLabel}</span>
          <h3 style="margin-top: var(--oc-space-3)">{product.name}</h3>
          <p>{product.summary}</p>
          <a href={product.primaryAction.href}>{product.primaryAction.label}</a>
        </article>
      ))}
    </div>
  </section>

  <script>
    const timers = new WeakMap();
    document.querySelectorAll('[data-copy]').forEach((button) => {
      button.addEventListener('click', async () => {
        const surface = button.closest('[data-copy-surface]');
        const status = surface?.querySelector('.copy-status');
        const text = button.getAttribute('data-copy') ?? '';
        try {
          if (!navigator.clipboard?.writeText) throw new Error('Clipboard unavailable');
          await navigator.clipboard.writeText(text);
          if (status) status.textContent = 'Copied';
        } catch {
          if (status) status.textContent = 'Could not copy — select the command above.';
        }
        if (status) {
          clearTimeout(timers.get(status));
          timers.set(status, setTimeout(() => { status.textContent = ''; }, 3000));
        }
      });
    });
  </script>
</SiteLayout>
