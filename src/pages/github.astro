---
import SiteLayout from '../layouts/SiteLayout.astro';
import { publicProducts } from '../data/products.ts';

const product = publicProducts.find((item) => item.id === 'github');
if (!product) throw new Error('Missing GitHub product registry record');
if (!product.docsUrl) throw new Error('GitHub product registry record missing docsUrl');

const title = 'OpenCoven for GitHub · Familiar delivery under human oversight';
const description = product.summary;
const waitlistBody = `## Hosted beta interest\n\n- Org name:\n- Team size:\n- Repos/backlog shape:\n- Model provider (BYOM):\n- What would you assign first?\n`;
const waitlistUrl = `https://github.com/OpenCoven/coven-github/issues/new?${new URLSearchParams({
  title: 'Hosted beta interest: <your org>',
  labels: 'hosted-beta-waitlist',
  body: waitlistBody,
}).toString()}`;

const loop = [
  ['Assign bounded work', 'Start from a GitHub issue or the repository trigger configured by the worker.'],
  ['Watch the Check Run', 'Status and execution evidence stay attached to the repository instead of disappearing into a private dashboard.'],
  ['Receive familiar status', 'The familiar reports progress while remaining bounded by the worker and repository policy.'],
  ['Review the draft PR', 'When commits exist, delivery returns as a reviewable draft pull request rather than an invisible mutation.'],
  ['Keep Cave oversight', 'Cave remains the human-legible oversight surface for the broader OpenCoven workflow.'],
];
---

<SiteLayout title={title} description={description} canonicalPath="/github">
  <section class="site-shell hero" id="top">
    <div class="hero__copy">
      <p class="eyebrow">GitHub-triggered familiar delivery</p>
      <h1>Assign bounded work. Get inspectable delivery back.</h1>
      <p class="hero__lede">
        OpenCoven for GitHub connects repository work to a familiar execution path with
        Check Runs, status evidence, draft pull requests when commits exist, and Cave
        oversight. Hosted access is currently gated; self-hosting is documented publicly.
      </p>
      <div class="button-row">
        <a class="action action--primary" data-oc-primitive="action" href={waitlistUrl}>Request hosted beta access</a>
        <a class="action" data-oc-primitive="action" href={product.docsUrl}>Self-host the worker</a>
      </div>
    </div>
    <aside class="evidence-card">
      <span class="status status--gated-beta" data-oc-primitive="status-indicator">{product.statusLabel}</span>
      <h2 style="font-size: var(--oc-type-2); margin-top: var(--oc-space-4)">Availability boundary</h2>
      <p class="muted">Hosted access is gated. The public repository and self-hosting documentation are available today. No unverified hosted pricing or trial terms are presented here.</p>
      <p class="mono muted" style="font-size: var(--oc-type--1)">Owner: {product.ownerRepository}</p>
    </aside>
  </section>

  <section class="band" aria-labelledby="loop-heading">
    <div class="site-shell">
      <div class="band__intro">
        <h2 id="loop-heading">The work stays legible in GitHub.</h2>
        <p>The route preserves the strongest evidence-backed issue → Check Run → status → draft PR → oversight loop without claiming a fully autonomous teammate or hidden hosted capability.</p>
      </div>
      <div class="proof-sequence">
        {loop.map(([name, body]) => (
          <article class="proof-step">
            <div class="proof-step__body">
              <h3>{name}</h3>
              <p>{body}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="band" aria-labelledby="paths-heading">
    <div class="site-shell">
      <div class="band__intro">
        <h2 id="paths-heading">Choose the deployment path you can verify.</h2>
        <p>Both destinations are first-party and registry-backed. Hosted beta interest uses a GitHub issue rather than an opaque third-party waitlist.</p>
      </div>
      <div class="product-grid">
        <article class="product-card">
          <span class="status status--gated-beta" data-oc-primitive="status-indicator">Hosted access gated</span>
          <h3 style="margin-top: var(--oc-space-4)">Hosted beta</h3>
          <p>Request access for a managed worker path. Availability is intentionally not represented as generally available.</p>
          <a class="action" data-oc-primitive="action" href={waitlistUrl}>Open hosted beta request</a>
        </article>
        <article class="product-card">
          <span class="status status--available" data-oc-primitive="status-indicator">Public operator path</span>
          <h3 style="margin-top: var(--oc-space-4)">Self-hosted worker</h3>
          <p>Run the worker under your own infrastructure and provider configuration using the canonical repository documentation.</p>
          <a class="action" data-oc-primitive="action" href={product.docsUrl}>Read self-hosting docs</a>
        </article>
      </div>
    </div>
  </section>

  <section class="band" aria-labelledby="evidence-heading">
    <div class="site-shell">
      <div class="band__intro">
        <h2 id="evidence-heading">Inspect the implementation evidence.</h2>
        <p>Marketing copy is subordinate to the repository, worker documentation, and checked-in public product registry.</p>
      </div>
      <div class="button-row" style="margin-top: var(--oc-space-6)">
        <a class="action action--primary" data-oc-primitive="action" href={product.repositoryUrl}>Open the repository</a>
        <a class="action" data-oc-primitive="action" href="https://github.com/OpenCoven/coven-github/blob/main/docs/demo.md">Read the demo narrative</a>
      </div>
    </div>
  </section>
</SiteLayout>
