---
import SiteLayout from '../layouts/SiteLayout.astro';
import '../styles/routes.css';
import { getPublicProduct } from '../data/products.ts';

const product = getPublicProduct('github');
if (!product.docsUrl) throw new Error('GitHub product registry record missing docsUrl');

const title = 'OpenCoven for GitHub · Familiar delivery under human oversight';
const description = product.summary;
const waitlistBody = `## Hosted beta interest\n\n- Org name:\n- Team size:\n- Repos/backlog shape:\n- Model provider (BYOM):\n- What would you assign first?\n`;
const waitlistUrl = `https://github.com/OpenCoven/coven-github/issues/new?${new URLSearchParams({
  title: 'Hosted beta interest: <your org>',
  labels: 'hosted-beta-waitlist',
  body: waitlistBody,
}).toString()}`;

const loop = [
  {
    title: 'Assign bounded work.',
    body: 'Start from a GitHub issue or the repository trigger configured by the worker.',
  },
  {
    title: 'Watch the Check Run.',
    body: 'Status and execution evidence remain attached to the repository instead of disappearing into a private dashboard.',
  },
  {
    title: 'Receive familiar status.',
    body: 'The familiar reports progress while remaining bounded by worker and repository policy.',
  },
  {
    title: 'Review the draft pull request.',
    body: 'When commits exist, delivery returns as a reviewable draft pull request rather than an invisible mutation.',
  },
  {
    title: 'Keep Cave oversight.',
    body: 'Cave remains the human-legible oversight surface for the broader OpenCoven workflow.',
  },
];

const applicationJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: product.name,
  description,
  applicationCategory: 'DeveloperApplication',
  operatingSystem: 'GitHub; self-hosted worker',
  url: 'https://opencoven.ai/github',
  sameAs: [product.repositoryUrl, product.docsUrl],
};
---

<SiteLayout title={title} description={description} canonicalPath="/github">
  <script type="application/ld+json" set:html={JSON.stringify(applicationJsonLd)} />

  <section class="site-shell hero" id="top">
    <div class="hero__copy">
      <p class="eyebrow">GitHub-triggered familiar delivery</p>
      <h1>Assign bounded work. Get inspectable delivery back.</h1>
      <p class="hero__lede">
        OpenCoven for GitHub connects repository work to a familiar execution path with
        Check Runs, status evidence, draft pull requests when commits exist, and Cave
        oversight. Hosted access is gated; the self-hosting path is documented publicly.
      </p>
      <div class="button-row">
        <a
          class="action action--primary"
          data-oc-primitive="action"
          data-oc-part="label"
          data-oc-state="idle"
          href={waitlistUrl}
        >Request hosted beta access</a>
        <a
          class="action"
          data-oc-primitive="action"
          data-oc-part="label"
          data-oc-state="idle"
          href={product.docsUrl}
        >Self-host the worker</a>
      </div>
    </div>
    <aside class="evidence-card" aria-labelledby="availability-heading">
      <span
        class="status status--gated-beta"
        data-oc-primitive="status-indicator"
        data-oc-part="label"
        data-oc-state="unavailable"
      >{product.statusLabel}</span>
      <h2 class="card-heading" id="availability-heading">Availability boundary</h2>
      <p class="muted">
        Hosted access is gated. The public repository and self-hosting documentation are
        available today. No hosted price, trial, service-level, or general-availability
        promise is represented on this route.
      </p>
      <p class="route-meta mono">Owner: {product.ownerRepository}</p>
    </aside>
  </section>

  <section class="band" aria-labelledby="loop-heading">
    <div class="site-shell">
      <div class="band__intro">
        <h2 id="loop-heading">The work stays legible in GitHub.</h2>
        <p>
          The current evidence-backed loop is issue → Check Run → familiar status → draft
          pull request when commits exist → human oversight. It is not presented as an
          unrestricted autonomous teammate.
        </p>
      </div>
      <ol class="proof-sequence" aria-label="GitHub familiar delivery loop">
        {loop.map((step) => (
          <li class="proof-step">
            <div class="proof-step__body">
              <h3>{step.title}</h3>
              <p>{step.body}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="band" aria-labelledby="paths-heading">
    <div class="site-shell">
      <div class="band__intro">
        <h2 id="paths-heading">Choose the deployment path you can verify.</h2>
        <p>
          Both destinations are first-party and registry-backed. Hosted beta interest uses
          a prefilled GitHub issue rather than an opaque third-party form.
        </p>
      </div>
      <div class="product-grid">
        <article class="product-card">
          <span
            class="status status--gated-beta"
            data-oc-primitive="status-indicator"
            data-oc-part="label"
            data-oc-state="unavailable"
          >Hosted access gated</span>
          <h3 class="card-heading">Hosted beta</h3>
          <p>
            Request access for a managed worker path. Submitting interest records a request;
            it does not imply immediate installation access or general availability.
          </p>
          <a
            class="action"
            data-oc-primitive="action"
            data-oc-part="label"
            data-oc-state="idle"
            href={waitlistUrl}
          >Open hosted beta request</a>
        </article>
        <article class="product-card">
          <span
            class="status status--available"
            data-oc-primitive="status-indicator"
            data-oc-part="label"
            data-oc-state="success"
          >Public operator path</span>
          <h3 class="card-heading">Self-hosted worker</h3>
          <p>
            Run the worker under infrastructure and provider configuration you control,
            following the canonical repository documentation.
          </p>
          <a
            class="action"
            data-oc-primitive="action"
            data-oc-part="label"
            data-oc-state="idle"
            href={product.docsUrl}
          >Read self-hosting docs</a>
        </article>
      </div>
    </div>
  </section>

  <section class="band" aria-labelledby="evidence-heading">
    <div class="site-shell">
      <div class="band__intro">
        <h2 id="evidence-heading">Inspect the implementation evidence.</h2>
        <p>
          This route is subordinate to the repository, worker documentation, and checked-in
          public product registry. Those sources—not landing-page copy—own implementation truth.
        </p>
      </div>
      <div class="button-row button-row--spaced">
        <a
          class="action action--primary"
          data-oc-primitive="action"
          data-oc-part="label"
          data-oc-state="idle"
          href={product.repositoryUrl}
        >Open the repository</a>
        <a
          class="action"
          data-oc-primitive="action"
          data-oc-part="label"
          data-oc-state="idle"
          href="https://github.com/OpenCoven/coven-github/blob/main/docs/demo.md"
        >Read the demo narrative</a>
      </div>
    </div>
  </section>
</SiteLayout>
