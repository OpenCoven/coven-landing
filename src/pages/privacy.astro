---
import BaseLayout from '../layouts/BaseLayout.astro';
import DocPage from '../components/DocPage.astro';
import { SITE } from '../config/site';
import { createBreadcrumbSchema } from '../lib/seo';

const breadcrumbs = [
  { name: 'Home', href: '/' },
  { name: 'Privacy', href: '/privacy' },
];
---

<BaseLayout
  title="Privacy Policy"
  description="OpenCoven Privacy Policy. Learn what data OpenCoven collects, how it's used, and how we keep your information private."
  canonicalPath="/privacy"
  type="PrivacyPolicy"
  pageSchemas={[createBreadcrumbSchema(breadcrumbs, `${SITE.url}/privacy`)]}
>
  <DocPage
    kicker="Legal"
    title="Privacy Policy"
    description="OpenCoven is a local-first platform. Your agent conversations, memory files, API keys, and personal data live on your machine, not ours."
    breadcrumbs={breadcrumbs}
    footerNote="This policy covers the website and optional cloud services. The local runtime stays on your device."
  >
    <section class="doc-callout">
      <strong>Short version:</strong> OpenCoven runs on your hardware. We do not have access to your agent sessions, your conversations, your files, or your API keys. The only data we handle is what is needed to run this website and, optionally, our cloud services.
    </section>

    <section class="doc-panel">
      <h2>Who We Are</h2>
      <p>
        OpenCoven ("we", "us", "our") is an open-source project building a framework for persistent AI familiars. Our website is available at <a href="https://opencoven.ai">opencoven.ai</a>. Questions? Email us at <a href="val@viewdue.ai">hello@opencoven.ai</a>.
      </p>
    </section>

    <section class="doc-panel">
      <h2>What We Do Not Collect</h2>
      <p>Because OpenCoven is local-first, we have no access to:</p>
      <ul class="doc-list">
        <li>Your agent conversations or session transcripts</li>
        <li>Your MEMORY.md, daily notes, or any workspace files</li>
        <li>Your API keys (OpenAI, Anthropic, GitHub, etc.)</li>
        <li>Your tool outputs, file reads, or shell command results</li>
        <li>Any data processed by the Coven daemon on your machine</li>
      </ul>
      <p>All of the above stays on your device. OpenCoven does not phone home with usage telemetry by default.</p>
    </section>

    <section class="doc-panel">
      <h2>What We Do Collect</h2>
      <table class="data-table">
        <thead>
          <tr>
            <th>Data</th>
            <th>Why</th>
            <th>Retention</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td>Website analytics (page views, referrers, device type)</td>
            <td>Understand how people find and use our docs and landing pages</td>
            <td>90 days, aggregated</td>
          </tr>
          <tr>
            <td>Email address (if you join the waitlist or newsletter)</td>
            <td>Send updates about OpenCoven releases and community events</td>
            <td>Until you unsubscribe</td>
          </tr>
          <tr>
            <td>GitHub username / OAuth token (if you sign in via GitHub)</td>
            <td>Authenticate access to gated resources or dashboards</td>
            <td>Session duration + auth token expiry</td>
          </tr>
          <tr>
            <td>Support messages (email, GitHub issues)</td>
            <td>Respond to and resolve your requests</td>
            <td>Duration of the support relationship</td>
          </tr>
        </tbody>
      </table>
    </section>

    <section class="doc-grid doc-grid--three">
      <article class="doc-card">
        <h2>Cookies and Analytics</h2>
        <p>Our website uses minimal, privacy-respecting analytics. We do not use third-party advertising trackers.</p>
      </article>
      <article class="doc-card">
        <h2>Third-Party Services</h2>
        <p>Vercel, GitHub, and Discord may process data under their own privacy policies when you use those services.</p>
      </article>
      <article class="doc-card">
        <h2>Your Rights</h2>
        <p>Depending on your location, you may have rights to access, correct, delete, port, or opt out of personal data processing.</p>
      </article>
    </section>

    <section class="doc-panel">
      <h2>Contact</h2>
      <p>Questions, concerns, or requests? Email us at <a href="val@viewdue.ai">hello@opencoven.ai</a> or open an issue on <a href="https://github.com/OpenCoven/coven" target="_blank" rel="noopener noreferrer">GitHub</a>.</p>
    </section>
  </DocPage>
</BaseLayout>
