---
import SiteLayout from '../layouts/SiteLayout.astro';
import '../styles/legal.css';

const title = 'Privacy Policy — OpenCoven';
const description = "OpenCoven Privacy Policy. Learn what data OpenCoven collects, how it's used, and how we keep your information private.";
const sections = [
  ['who-we-are', 'Who We Are'],
  ['what-we-dont-collect', "What We Don't Collect"],
  ['what-we-do-collect', 'What We Do Collect'],
  ['cookies', 'Cookies and Analytics'],
  ['third-party', 'Third-Party Services'],
  ['how-we-use', 'How We Use Your Data'],
  ['storage', 'Data Storage and Security'],
  ['your-rights', 'Your Rights'],
  ['children', "Children's Privacy"],
  ['changes', 'Changes to This Policy'],
  ['contact', 'Contact'],
];
const num = (i: number) => String(i + 1).padStart(2, '0');
---

<SiteLayout title={title} description={description} canonicalPath="/privacy">
  <section class="site-shell legal-page">
    <header class="legal-head">
      <p class="eyebrow">Legal</p>
      <h1>Privacy Policy</h1>
      <p class="legal-lead">
        OpenCoven is a local-first platform. Your agent conversations, memory files, API keys, and personal data live on your machine — not ours. This policy explains what limited data we do handle and how we treat it.
      </p>
      <p class="legal-stamp">Effective date: May 27, 2026 · Last updated: May 27, 2026</p>
      <div class="legal-highlight">
        <strong>Short version:</strong> OpenCoven runs on your hardware. We don't have access to your agent sessions, your conversations, your files, or your API keys. The only data we handle is what's needed to run this website and, optionally, our cloud services.
      </div>
    </header>

    <div class="legal-layout">
      <aside class="legal-toc">
        <h2>What this covers</h2>
        <p class="muted">The short version is above. This is the detail, section by section.</p>
        <nav aria-label="Privacy policy sections">
          {sections.map(([id, label], i) => <a href={`#${id}`}><span class="index">{num(i)}</span>{label}</a>)}
        </nav>
      </aside>

      <div class="legal-panels">
        <section class="legal-panel" id="who-we-are">
          <h2>Who We Are</h2>
          <p>OpenCoven ("we", "us", "our") is an open-source project building a framework for persistent AI familiars. Our website is available at <a href="https://opencoven.ai">opencoven.ai</a>. Questions? Email us at <a href="mailto:hello@opencoven.ai">hello@opencoven.ai</a>.</p>
        </section>

        <section class="legal-panel" id="what-we-dont-collect">
          <h2>What We Don't Collect</h2>
          <p>Because OpenCoven is local-first, we have no access to:</p>
          <ul>
            <li>Your agent conversations or session transcripts</li>
            <li>Your MEMORY.md, daily notes, or any workspace files</li>
            <li>Your API keys (OpenAI, Anthropic, GitHub, etc.)</li>
            <li>Your tool outputs, file reads, or shell command results</li>
            <li>Any data processed by the Coven daemon on your machine</li>
          </ul>
          <p>All of the above stays on your device. OpenCoven does not phone home with usage telemetry by default.</p>
        </section>

        <section class="legal-panel" id="what-we-do-collect">
          <h2>What We Do Collect</h2>
          <div class="legal-tablewrap" role="region" tabindex="0" aria-label="Data collection details">
            <table class="legal-table">
              <thead><tr><th>Data</th><th>Why</th><th>Retention</th></tr></thead>
              <tbody>
                <tr><td>Website analytics (page views, referrers, device type)</td><td>Understand how people find and use our docs/landing pages</td><td>90 days, aggregated</td></tr>
                <tr><td>Email address (if you join the waitlist or newsletter)</td><td>Send updates about OpenCoven releases and community events</td><td>Until you unsubscribe</td></tr>
                <tr><td>GitHub username / OAuth token (if you sign in via GitHub)</td><td>Authenticate access to gated resources or dashboards</td><td>Session duration + auth token expiry</td></tr>
                <tr><td>Support messages (email, GitHub issues)</td><td>Respond to and resolve your requests</td><td>Duration of the support relationship</td></tr>
              </tbody>
            </table>
          </div>
        </section>

        <section class="legal-panel" id="cookies">
          <h2>Cookies and Analytics</h2>
          <p>Our website uses minimal, privacy-respecting analytics. We do not use third-party advertising trackers. If we use cookies, they are limited to:</p>
          <ul>
            <li><strong>Session cookies</strong> — for authenticated areas; expire when you close your browser</li>
            <li><strong>Analytics cookies</strong> — anonymous, aggregate page-view data; no cross-site tracking</li>
          </ul>
          <p>You can disable cookies in your browser settings. Core website functionality does not require cookies.</p>
        </section>

        <section class="legal-panel" id="third-party">
          <h2>Third-Party Services</h2>
          <p>Our website and infrastructure may use the following third-party services:</p>
          <ul>
            <li><strong>Vercel</strong> — hosting and edge delivery; subject to <a href="https://vercel.com/legal/privacy-policy" target="_blank" rel="noopener noreferrer">Vercel's Privacy Policy</a></li>
            <li><strong>GitHub</strong> — source code, issues, and optional OAuth; subject to <a href="https://docs.github.com/en/site-policy/privacy-policies/github-general-privacy-statement" target="_blank" rel="noopener noreferrer">GitHub's Privacy Statement</a></li>
            <li><strong>Discord</strong> — community server; subject to <a href="https://discord.com/privacy" target="_blank" rel="noopener noreferrer">Discord's Privacy Policy</a></li>
          </ul>
          <p>When you use OpenCoven locally with third-party AI providers (OpenAI, Anthropic, Google, etc.), your prompts and responses are sent directly from your machine to those providers under their respective privacy policies. OpenCoven does not intercept or store those exchanges.</p>
        </section>

        <section class="legal-panel" id="how-we-use">
          <h2>How We Use Your Data</h2>
          <p>We use the limited data we collect to:</p>
          <ul>
            <li>Operate and improve the OpenCoven website and documentation</li>
            <li>Communicate with you about releases, security issues, or support requests (only if you've opted in)</li>
            <li>Understand aggregate usage patterns to prioritize development</li>
          </ul>
          <p>We do not sell your data. We do not share it with advertisers. We do not use it to train AI models.</p>
        </section>

        <section class="legal-panel" id="storage">
          <h2>Data Storage and Security</h2>
          <p>Any data we hold is stored with industry-standard safeguards. We limit access to personal data to the people who need it to operate the service. If we become aware of a data breach that affects you, we will notify you as required by applicable law.</p>
        </section>

        <section class="legal-panel" id="your-rights">
          <h2>Your Rights</h2>
          <p>Depending on your location, you may have rights to:</p>
          <ul>
            <li><strong>Access</strong> — request a copy of the personal data we hold about you</li>
            <li><strong>Correction</strong> — ask us to fix inaccurate data</li>
            <li><strong>Deletion</strong> — request that we delete your personal data</li>
            <li><strong>Portability</strong> — receive your data in a portable format</li>
            <li><strong>Opt-out</strong> — unsubscribe from marketing communications at any time</li>
          </ul>
          <p>To exercise any of these rights, email us at <a href="mailto:hello@opencoven.ai">hello@opencoven.ai</a>. We'll respond within 30 days.</p>
        </section>

        <section class="legal-panel" id="children">
          <h2>Children's Privacy</h2>
          <p>OpenCoven is not directed at children under 13. We do not knowingly collect personal data from children under 13. If you believe we have inadvertently collected such data, please contact us and we will delete it promptly.</p>
        </section>

        <section class="legal-panel" id="changes">
          <h2>Changes to This Policy</h2>
          <p>We may update this Privacy Policy from time to time. When we do, we'll update the "Last updated" date at the top of this page. We'll notify you of material changes via our Discord or GitHub if the change significantly affects how we handle your data.</p>
        </section>

        <section class="legal-panel" id="contact">
          <h2>Contact</h2>
          <p>Questions, concerns, or requests? Email us at <a href="mailto:hello@opencoven.ai">hello@opencoven.ai</a> or open an issue on <a href="https://github.com/OpenCoven/coven" target="_blank" rel="noopener noreferrer">GitHub</a>.</p>
        </section>
      </div>
    </div>
  </section>
</SiteLayout>
