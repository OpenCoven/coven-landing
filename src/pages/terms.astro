---
import BaseLayout from '../layouts/BaseLayout.astro';
import DocPage from '../components/DocPage.astro';
import { SITE } from '../config/site';
import { createBreadcrumbSchema } from '../lib/seo';

const breadcrumbs = [
  { name: 'Home', href: '/' },
  { name: 'Terms', href: '/terms' },
];
---

<BaseLayout
  title="Terms of Service"
  description="OpenCoven Terms of Service. Read the terms governing your use of the OpenCoven platform, tools, and ecosystem."
  canonicalPath="/terms"
  type="TermsOfService"
  pageSchemas={[createBreadcrumbSchema(breadcrumbs, `${SITE.url}/terms`)]}
>
  <DocPage
    kicker="Legal"
    title="Terms of Service"
    description="Please read these Terms of Service carefully before using OpenCoven or any of its associated tools, packages, SDKs, or services."
    breadcrumbs={breadcrumbs}
    footerNote="These terms govern the website and hosted services, not the open-source software license itself."
  >
    <section class="doc-panel">
      <h2>Acceptance of Terms</h2>
      <p>By downloading, installing, accessing, or using OpenCoven ("the Software"), you agree to these Terms of Service ("Terms") and our <a href="/privacy">Privacy Policy</a>. If you do not agree, do not use the Software.</p>
      <p>These Terms apply to all users including individuals, organizations, and developers integrating OpenCoven into their own products.</p>
    </section>

    <section class="doc-panel">
      <h2>What OpenCoven Is</h2>
      <p>OpenCoven is an open-source framework for building and running persistent AI familiars - named agents with memory, identity, tools, and continuity. It includes a daemon, CLI, harness integrations, and related packages published under the <code>@opencoven</code> namespace.</p>
      <p>OpenCoven is primarily a local-first tool. You run it on your own hardware. You control your agents, your data, and your keys.</p>
    </section>

    <section class="doc-grid doc-grid--three">
      <article class="doc-card">
        <h2>Open Source License</h2>
        <p>OpenCoven's source code is released under the <a href="https://github.com/OpenCoven/coven/blob/main/LICENSE" target="_blank" rel="noopener noreferrer">MIT License</a>.</p>
      </article>
      <article class="doc-card">
        <h2>Permitted Use</h2>
        <p>You may build, run, and extend AI familiars, integrate OpenCoven into your own products, contribute to the open-source codebase, and access documentation and packages.</p>
      </article>
      <article class="doc-card">
        <h2>Prohibited Use</h2>
        <p>You may not use OpenCoven to generate illegal content, harass people, deceive users, circumvent security, or violate third-party AI provider policies.</p>
      </article>
    </section>

    <section class="doc-callout">
      OpenCoven is local-first. We don't see your agent conversations, your files, or your keys. Responsible use is your responsibility.
    </section>

    <section class="doc-grid">
      <article class="doc-panel">
        <h2>Third-Party AI Providers</h2>
        <p>OpenCoven integrates with third-party AI providers (OpenAI, Anthropic, Google, and others). Your use of those providers is governed by their respective terms of service and usage policies.</p>
      </article>
      <article class="doc-panel">
        <h2>No Warranty and Liability</h2>
        <p>OpenCoven is provided "as is" without warranty. To the maximum extent permitted by law, OpenCoven and its contributors are not liable for indirect, incidental, special, consequential, or punitive damages arising from use of the Software.</p>
      </article>
    </section>

    <section class="doc-panel">
      <h2>Privacy</h2>
      <p>Our data practices are described in our <a href="/privacy">Privacy Policy</a>. By using OpenCoven, you agree to the collection and use of information as described there.</p>
    </section>

    <section class="doc-panel">
      <h2>Contact</h2>
      <p>Questions about these Terms? Reach us at <a href="val@viewdue.ai">hello@opencoven.ai</a> or open an issue on <a href="https://github.com/OpenCoven/coven" target="_blank" rel="noopener noreferrer">GitHub</a>.</p>
    </section>
  </DocPage>
</BaseLayout>
