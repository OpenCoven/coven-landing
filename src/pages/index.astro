---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE, HOME_FAQS } from '../config/site';
import { createFaqSchema, createHowToSchema } from '../lib/seo';

import Ambient from '../components/Ambient.astro';
import Header from '../components/Header.astro';
import MobileNav from '../components/MobileNav.astro';
import Hero from '../components/Hero.astro';
import Testimonial from '../components/Testimonial.astro';
import ProofGrid from '../components/ProofGrid.astro';
import Architecture from '../components/Architecture.astro';
import HowItWorks from '../components/HowItWorks.astro';
import Compare from '../components/Compare.astro';
import LiveDemo from '../components/LiveDemo.astro';
import QuickStart from '../components/QuickStart.astro';
import Faq from '../components/Faq.astro';
import Ecosystem from '../components/Ecosystem.astro';
import Footer from '../components/Footer.astro';
import FeedbackButton from '../components/FeedbackButton.astro';

const quickStartSteps = [
  {
    name: 'Verify your environment',
    text: 'Run npx @opencoven/cli doctor to confirm the harnesses, daemon, and project are ready.',
  },
  {
    name: 'Start a session',
    text: 'Run coven run claude "fix the failing tests" to launch a familiar inside the current project.',
  },
  {
    name: 'Resume anywhere',
    text: 'Run coven sessions to reopen running or archived sessions and continue the work.',
  },
];
---
<BaseLayout
  title="OpenCoven — Persistent AI Familiars"
  description={SITE.description}
  canonicalPath="/"
  imageAlt="OpenCoven persistent AI familiars"
  includeSoftwareApplication={true}
  pageSchemas={[
    createFaqSchema(HOME_FAQS),
    createHowToSchema({
      title: 'OpenCoven quick start',
      description: 'The three-command path to verify, start, and resume an OpenCoven familiar.',
      url: `${SITE.url}/#quickstart`,
      steps: quickStartSteps,
    }),
  ]}
>
  <Ambient />
  <Header />
  <MobileNav />
  <main id="content">
    <Hero />
    <Testimonial />
    <ProofGrid />
    <Architecture />
    <HowItWorks />
    <Compare />
    <LiveDemo />
    <QuickStart />
    <Faq />
    <Ecosystem />
  </main>
  <Footer />
  <FeedbackButton />

  <script>
    import '../scripts/main.js';
  </script>
</BaseLayout>
