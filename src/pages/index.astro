---
// Self-host the variable-weight fonts to remove the render-blocking Google
// Fonts chain (was costing ~1s of mobile LCP). Both packages ship one .woff2
// per Unicode subset with font-display: swap, so text renders in a fallback
// immediately and re-flows when the font arrives.
import '@fontsource-variable/inter/wght.css';
import '@fontsource-variable/jetbrains-mono/wght.css';
// Geist is the display voice per DESIGN.md (Satoshi preferred but not
// self-hostable; Geist is the sanctioned fallback in the brand font stack).
import '@fontsource-variable/geist/wght.css';
import '../styles/global.css';

import ThemeInit   from '../components/ThemeInit.astro';
import Ambient     from '../components/Ambient.astro';
import Header      from '../components/Header.astro';
import MobileNav   from '../components/MobileNav.astro';
import Hero        from '../components/Hero.astro';
import TrustBar    from '../components/TrustBar.astro';
import ContinuityStory from '../components/ContinuityStory.astro';
import ProofGrid    from '../components/ProofGrid.astro';
import Architecture from '../components/Architecture.astro';
import HowItWorks   from '../components/HowItWorks.astro';
import Compare      from '../components/Compare.astro';
import QuickStart   from '../components/QuickStart.astro';
import Ecosystem      from '../components/Ecosystem.astro';
import Footer         from '../components/Footer.astro';
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <ThemeInit />
  <title>OpenCoven — Persistent AI Familiars</title>
  <meta name="description" content="An open ecosystem for persistent AI familiars: named agents with memory, tools, identity, roles, and continuity." />
  <meta property="og:title" content="OpenCoven" />
  <meta property="og:description" content="An open ecosystem for persistent AI familiars that remember, coordinate, and belong to you." />
  <meta property="og:type" content="website" />
  <meta property="og:url" content="https://opencoven.ai/" />
  <meta property="og:image" content="https://opencoven.ai/og.png" />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content="OpenCoven — Persistent AI Familiars" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:site" content="@OpenCvn" />
  <meta name="twitter:title" content="OpenCoven" />
  <meta name="twitter:description" content="An open ecosystem for persistent AI familiars that remember, coordinate, and belong to you." />
  <meta name="twitter:image" content="https://opencoven.ai/og.png" />
  <meta name="twitter:image:alt" content="OpenCoven — Persistent AI Familiars" />
  <meta name="theme-color" content="#050409" />
  <meta name="robots" content="index, follow" />
  <link rel="canonical" href="https://opencoven.ai/" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'SoftwareApplication',
    name: 'OpenCoven',
    alternateName: 'Coven',
    description: 'An open ecosystem for persistent AI familiars: named agents with memory, tools, identity, roles, and continuity.',
    applicationCategory: 'DeveloperApplication',
    operatingSystem: 'macOS, Linux, Windows',
    url: 'https://opencoven.ai/',
    downloadUrl: 'https://github.com/OpenCoven/coven',
    softwareHelp: { '@type': 'CreativeWork', url: 'https://docs.opencoven.ai/' },
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    sameAs: [
      'https://github.com/OpenCoven',
      'https://discord.gg/opencoven',
    ],
  })} />

  <script is:inline>
    /* Runs before paint: marks <html> with js-on / motion-on so interactive
       CSS (reveals, parallax) only applies when JS + motion are available.
       No-JS visitors and reduced-motion users never see hidden content. */
    (function () {
      var html = document.documentElement;
      html.classList.add('js-on');
      if (!window.matchMedia || !matchMedia('(prefers-reduced-motion: reduce)').matches) {
        html.classList.add('motion-on');
      }
    })();
  </script>

  <!-- OpenCoven Feedback widget — renders its own small circular launcher
       in the corner. Stub queues calls immediately; the SDK fetch waits
       for the `load` event and then runs during idle time so it doesn't
       compete with the landing's LCP work (the SDK pulls in ~3.5 MB of
       admin-React chunks). The custom FAB pill was removed; this is the
       only feedback affordance on the page. -->
  <script is:inline>
    (function (w, d) {
      if (w.OpenCovenFeedback) return;
      w.OpenCovenFeedback = function () {
        (w.OpenCovenFeedback.q = w.OpenCovenFeedback.q || []).push(arguments);
      };
      OpenCovenFeedback('init');

      function loadSdk() {
        if (d.getElementById('opencoven-feedback-sdk')) return;
        var s = d.createElement('script');
        s.id = 'opencoven-feedback-sdk';
        s.async = true;
        s.src = 'https://feedback.opencoven.ai/api/widget/sdk.js';
        d.head.appendChild(s);
      }
      function schedule() {
        if (typeof w.requestIdleCallback === 'function') {
          w.requestIdleCallback(loadSdk, { timeout: 2000 });
        } else {
          w.setTimeout(loadSdk, 1500);
        }
      }
      if (d.readyState === 'complete') {
        schedule();
      } else {
        w.addEventListener('load', schedule, { once: true });
      }
    })(window, document);
  </script>
</head>
<body>
  <Ambient />
  <Header />
  <MobileNav />
  <main id="content" tabindex="-1">
    <Hero />
    <TrustBar />
    <ContinuityStory />
    <ProofGrid />
    <Architecture />
    <HowItWorks />
    <Compare />
    <QuickStart />
    <Ecosystem />
  </main>
  <Footer />

  <script>
    import '../scripts/main.js';
    import '../scripts/landing.js';
  </script>
</body>
</html>
