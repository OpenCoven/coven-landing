---
import '../styles/global.css';

import Ambient     from '../components/Ambient.astro';
import Header      from '../components/Header.astro';
import MobileNav   from '../components/MobileNav.astro';
import Hero        from '../components/Hero.astro';
import Testimonial from '../components/Testimonial.astro';
import ProofGrid    from '../components/ProofGrid.astro';
import Architecture from '../components/Architecture.astro';
import HowItWorks   from '../components/HowItWorks.astro';
import Compare      from '../components/Compare.astro';
import LiveDemo     from '../components/LiveDemo.astro';
import QuickStart   from '../components/QuickStart.astro';
import Ecosystem   from '../components/Ecosystem.astro';
import Footer      from '../components/Footer.astro';
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>OpenCoven — Persistent AI Familiars</title>
  <meta name="description" content="An open ecosystem for persistent AI familiars: named agents with memory, tools, identity, roles, and continuity." />
  <meta property="og:title" content="OpenCoven" />
  <meta property="og:description" content="An open ecosystem for persistent AI familiars that remember, coordinate, and belong to you." />
  <meta property="og:type" content="website" />
  <meta property="og:url" content="https://opencoven.ai/" />
  <meta property="og:image" content="/og.png" />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="theme-color" content="#050409" />
  <meta name="robots" content="index, follow" />
  <link rel="canonical" href="https://opencoven.ai/" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet" />

  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'SoftwareApplication',
    name: 'OpenCoven',
    alternateName: 'Coven',
    description: 'An open ecosystem for persistent AI familiars: named agents with memory, tools, identity, roles, and continuity.',
    applicationCategory: 'DeveloperApplication',
    operatingSystem: 'macOS, Linux, Windows',
    url: 'https://opencoven.ai/',
    downloadUrl: 'https://github.com/OpenCoven/coven',
    softwareHelp: { '@type': 'CreativeWork', url: 'https://docs.opencoven.ai/' },
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    sameAs: [
      'https://github.com/OpenCoven',
      'https://discord.gg/opencoven',
    ],
  })} />

  <script is:inline>
    /* Runs before paint: marks <html> with js-on / motion-on so interactive
       CSS (reveals, parallax) only applies when JS + motion are available.
       No-JS visitors and reduced-motion users never see hidden content. */
    (function () {
      var html = document.documentElement;
      html.classList.add('js-on');
      if (!window.matchMedia || !matchMedia('(prefers-reduced-motion: reduce)').matches) {
        html.classList.add('motion-on');
      }
    })();
  </script>

  <!-- OpenCoven Feedback widget -->
  <script is:inline>
    (function(w,d){if(w.OpenCovenFeedback)return;w.OpenCovenFeedback=function(){
    (w.OpenCovenFeedback.q=w.OpenCovenFeedback.q||[]).push(arguments)};
    var s=d.createElement('script');s.async=true;
    s.src='https://feedback.opencoven.ai/api/widget/sdk.js';
    d.head.appendChild(s)})(window,document);
    OpenCovenFeedback('init');
  </script>
</head>
<body>
  <Ambient />
  <Header />
  <MobileNav />
  <Hero />
  <Testimonial />
  <ProofGrid />
  <Architecture />
  <HowItWorks />
  <Compare />
  <LiveDemo />
  <QuickStart />
  <Ecosystem />
  <Footer />

  <script>
    import '../scripts/main.js';
  </script>
</body>
</html>
