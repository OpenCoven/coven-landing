---
import '@fontsource-variable/inter/wght.css';
import '@fontsource-variable/jetbrains-mono/wght.css';
import '@fontsource-variable/geist/wght.css';
import '../styles/reforged.css';

import ReforgedHeader from '../components/reforged/ReforgedHeader.astro';
import ReforgedHero from '../components/reforged/ReforgedHero.astro';
import RuntimeMarquee from '../components/reforged/RuntimeMarquee.astro';
import Boundary from '../components/reforged/Boundary.astro';
import Surfaces from '../components/reforged/Surfaces.astro';
import Invocation from '../components/reforged/Invocation.astro';
import Summoning from '../components/reforged/Summoning.astro';
import ReforgedFooter from '../components/reforged/ReforgedFooter.astro';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>OpenCoven — Persistent AI Familiars</title>
    <meta
      name="description"
      content="Summon a persistent AI familiar with project-scoped memory, a local-first runtime, and a boundary you control."
    />
    <meta property="og:title" content="OpenCoven — Persistent AI Familiars" />
    <meta
      property="og:description"
      content="A familiar is an AI agent with a memory, bound to your project."
    />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://opencoven.ai/" />
    <meta property="og:image" content="https://opencoven.ai/og.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="OpenCoven — Persistent AI Familiars" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@OpenCvn" />
    <meta name="twitter:title" content="OpenCoven — Persistent AI Familiars" />
    <meta
      name="twitter:description"
      content="A familiar is an AI agent with a memory, bound to your project."
    />
    <meta name="twitter:image" content="https://opencoven.ai/og.png" />
    <meta name="theme-color" content="#050409" />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href="https://opencoven.ai/" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'SoftwareApplication',
        name: 'OpenCoven',
        alternateName: 'Coven',
        description:
          'An open-source, local-first runtime for persistent AI familiars with project-scoped memory.',
        applicationCategory: 'DeveloperApplication',
        operatingSystem: 'macOS, Linux, Windows, iOS',
        url: 'https://opencoven.ai/',
        downloadUrl:
          'https://github.com/opencoven/coven-cave/releases/latest',
        softwareHelp: {
          '@type': 'CreativeWork',
          url: 'https://docs.opencoven.ai/',
        },
        offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
        sameAs: [
          'https://github.com/OpenCoven',
          'https://discord.gg/opencoven',
        ],
      })}
    />

  </head>
  <body class="reforged-page">
    <div class="reforged-atmosphere" aria-hidden="true"></div>
    <ReforgedHeader />
    <main id="content" tabindex="-1">
      <ReforgedHero />
      <RuntimeMarquee />
      <Boundary />
      <Surfaces />
      <Invocation />
      <Summoning />
    </main>
    <ReforgedFooter />
    <p class="copy-live" data-copy-live aria-live="polite"></p>

    <script>
      import '../scripts/reforged.js';
    </script>
  </body>
</html>
