---
import '../styles/global.css';

import Ambient     from '../components/Ambient.astro';
import Header      from '../components/Header.astro';
import MobileNav   from '../components/MobileNav.astro';
import Hero        from '../components/Hero.astro';
import Testimonial from '../components/Testimonial.astro';
import ProofGrid    from '../components/ProofGrid.astro';
import Architecture from '../components/Architecture.astro';
import HowItWorks   from '../components/HowItWorks.astro';
import Compare      from '../components/Compare.astro';
import LiveDemo     from '../components/LiveDemo.astro';
import QuickStart   from '../components/QuickStart.astro';
import Ecosystem   from '../components/Ecosystem.astro';
import Footer      from '../components/Footer.astro';
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>OpenCoven — Persistent AI Familiars</title>
  <meta name="description" content="An open ecosystem for persistent AI familiars: named agents with memory, tools, identity, roles, and continuity." />
  <meta property="og:title" content="OpenCoven" />
  <meta property="og:description" content="An open ecosystem for persistent AI familiars that remember, coordinate, and belong to you." />
  <meta property="og:type" content="website" />
  <meta property="og:url" content="https://opencoven.ai/" />
  <meta property="og:image" content="/og.png" />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="theme-color" content="#050409" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link href="https://fonts.googleapis.com/css2?family=Inter:ital,wght@0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,400&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet" />

  <script is:inline>
    /* Runs before paint: marks <html> with js-on / motion-on so interactive
       CSS (reveals, parallax) only applies when JS + motion are available.
       No-JS visitors and reduced-motion users never see hidden content. */
    (function () {
      var html = document.documentElement;
      html.classList.add('js-on');
      if (!window.matchMedia || !matchMedia('(prefers-reduced-motion: reduce)').matches) {
        html.classList.add('motion-on');
      }
    })();
  </script>
</head>
<body>
  <Ambient />
  <Header />
  <MobileNav />
  <Hero />
  <Testimonial />
  <ProofGrid />
  <Architecture />
  <HowItWorks />
  <Compare />
  <LiveDemo />
  <QuickStart />
  <Ecosystem />
  <Footer />

  <script>
    import '../scripts/main.js';
  </script>
</body>
</html>
