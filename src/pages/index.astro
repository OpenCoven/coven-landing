---
import { ogImage } from '../lib/og.js';
import '@fontsource/eb-garamond/400.css';
import '@fontsource/eb-garamond/400-italic.css';
import '@fontsource/eb-garamond/500.css';
import '@fontsource/inter/400.css';
import '@fontsource/inter/500.css';
import '@fontsource/inter/600.css';
import '@fontsource/jetbrains-mono/400.css';
import '@fontsource/jetbrains-mono/500.css';
import '@phosphor-icons/web/regular';
import '../styles/redesign.css';
import '../styles/hero.css';
import '@fontsource-variable/geist';

import ThemeInit from '../components/ThemeInit.astro';
import PosthogSnippet from '../components/redesign/PosthogSnippet.astro';
import RedesignNav from '../components/redesign/RedesignNav.astro';
import RedesignHero from '../components/redesign/RedesignHero.astro';
import BoardSection from '../components/redesign/BoardSection.astro';
import Outcomes from '../components/redesign/Outcomes.astro';
import FinalCta from '../components/redesign/FinalCta.astro';
import RedesignFooter from '../components/redesign/RedesignFooter.astro';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>OpenCoven · Stop being your agents' control plane</title>
    <meta
      name="description"
      content="Coven is a local daemon that coordinates coding agents working in the same repo: claims on surfaces, one shared record, and guards that wait for your yes."
    />
    <meta property="og:title" content="OpenCoven · Stop being your agents' control plane" />
    <meta
      property="og:description"
      content="A local daemon coordinating coding agents in one repo: claims on surfaces, one shared record, guards that wait for your yes."
    />
    <meta property="og:site_name" content="OpenCoven" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://opencoven.ai/" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@OpenCvn" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <ThemeInit />
    <!-- Tells CSS whether motion is allowed before first paint, so the session table's
         finished frame can be held back only where the script is about to replay it. -->
    <script is:inline>
      document.documentElement.dataset.motion = window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'reduce' : 'ok';
    </script>
    <PosthogSnippet />
  </head>
  <body class="landing-home">
    <RedesignNav />
    <main>
      <div data-screen-label="Landing v10 product surfaces" data-r="shell" style="min-width: 1140px; background: var(--cv-bg-base); padding-top: 60px">
        <RedesignHero />
        <BoardSection />
        <Outcomes />
        <FinalCta />
      </div>
    </main>
    <RedesignFooter />

    <script>
      import '../scripts/redesign/landing.js';
    </script>
  </body>
</html>
