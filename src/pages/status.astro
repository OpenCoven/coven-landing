---
import SiteLayout from '../layouts/SiteLayout.astro';
import '../styles/routes.css';
import {
  publicProducts,
  activeProducts,
  archivedProducts,
  getPublicProduct,
} from '../data/products.ts';

const title = 'Status and maturity · OpenCoven';
const description =
  'Registry-backed public maturity and availability status for OpenCoven product surfaces.';

const counts = {
  active: activeProducts.length,
  archived: archivedProducts.length,
  total: publicProducts.length,
};

const productState = (maturity: string) => {
  if (maturity === 'available') return 'success';
  if (maturity === 'gated-beta') return 'unavailable';
  return 'selected';
};
---

<SiteLayout title={title} description={description} canonicalPath="/status">
  <section class="site-shell hero" id="top">
    <div class="hero__copy">
      <p class="eyebrow">Generated public maturity surface</p>
      <h1>Status should come from data, not memory.</h1>
      <p class="hero__lede">
        This page renders from the same checked-in public product registry used by the
        homepage and Quickstart, so availability and successor state have one source in
        this repository.
      </p>
      <div class="button-row">
        <a class="action action--primary" data-oc-primitive="action" data-oc-state="idle" href="/quickstart">Start with a current product</a>
        <a class="action" data-oc-primitive="action" data-oc-state="idle" href="https://github.com/OpenCoven/coven-landing/blob/main/src/data/products.ts">Inspect registry source</a>
      </div>
    </div>
    <aside class="evidence-card" aria-labelledby="status-registry-heading">
      <span class="status" data-oc-primitive="status-indicator" data-oc-state="idle">Registry-backed</span>
      <h2 class="card-heading" id="status-registry-heading">{counts.active} current · {counts.archived} archived</h2>
      <p class="muted">
        A product is not promoted here unless the registry carries a current lifecycle,
        maturity, canonical destination, owner repository, and public action.
      </p>
    </aside>
  </section>

  <section class="band" aria-labelledby="current-heading">
    <div class="site-shell">
      <div class="band__intro">
        <h2 id="current-heading">Current product surfaces.</h2>
        <p>“Available,” “beta,” and “gated beta” are intentionally distinct. A repository being public does not imply a hosted service is generally available.</p>
      </div>
      <div class="product-grid" data-status-active-products>
        {activeProducts.map((product) => (
          <article class="product-card" data-product-id={product.id}>
            <span
              class:list={["status", `status--${product.maturity}`]}
              data-oc-primitive="status-indicator"
              data-oc-state={productState(product.maturity)}
            >{product.statusLabel}</span>
            <h3>{product.name}</h3>
            <p>{product.summary}</p>
            <p><strong>Platform:</strong> {product.platforms}</p>
            <p class="route-meta mono">Owner: {product.ownerRepository}</p>
            <p class="route-meta mono">Verified: {product.verifiedAt}</p>
            <a href={product.primaryAction.href}>{product.primaryAction.label}</a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="band" aria-labelledby="archive-heading">
    <div class="site-shell">
      <div class="band__intro">
        <h2 id="archive-heading">Archived and successor lineage.</h2>
        <p>Historical products remain visible only where migration or release lineage matters.</p>
      </div>
      <div class="archive-stack" data-status-archived-products>
        {archivedProducts.map((product) => {
          const successor = product.successor
            ? getPublicProduct(product.successor)
            : null;
          return (
            <article class="evidence-card" data-product-id={product.id}>
              <span class="status" data-oc-primitive="status-indicator" data-oc-state="unavailable">{product.statusLabel}</span>
              <h3 class="card-heading">{product.name}</h3>
              <p>{product.summary}</p>
              {successor && <p><strong>Successor:</strong> {successor.name} (<code>{successor.id}</code>)</p>}
              <p class="route-meta mono">Owner: {product.ownerRepository}</p>
              <a href={product.primaryAction.href}>{product.primaryAction.label}</a>
            </article>
          );
        })}
      </div>
    </div>
  </section>
</SiteLayout>
